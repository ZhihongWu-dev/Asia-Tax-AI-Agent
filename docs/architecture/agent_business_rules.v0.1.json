      "then": {
        "action": "record_unknown_offer_partial",
        "scope": "node",
        "outcome": "waiting_user",
        "tools": []
      },
      "business_contract": "保存 unknown，再询问继续等待还是先出部分稿；不默认为条件不满足。"
    },
    {
      "id": "BR-28",
      "phase": "user_event",
      "priority": 3,
