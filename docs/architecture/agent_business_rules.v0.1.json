{
  "config_id": "tax_agent_business_rules",
  "version": "0.1.0",
  "date": "2026-10-01",
  "status": "design_only_not_loaded_by_runtime",
  "scope": "Workflow routing rules; no tax rates, tax eligibility thresholds or legal conclusions.",
  "authority": "Conditions are supplied by authenticated services. Models may propose facts and actions but cannot grant permissions, approve reports or override gates.",
  "evaluation": {
    "strategy": "first_match_in_phase",
    "priority": "ascending",
    "supported_predicates": [
      "eq",
      "in"
    ],
    "supported_groups": [
      "all",
      "any"
    ],
    "empty_all": true,
    "missing_invalid_context": "configuration_error; do not execute tools",
    "no_match": "configuration_error; do not execute tools",
    "unknown_phase": "configuration_error; do not execute tools"
  },
  "phases": {
    "admission": {
      "required_fields": [
        "access_allowed",
        "data_allowed",
        "input_valid"
      ],
      "rule_ids": [
        "BR-01",
        "BR-02",
        "BR-03"
      ]
    },
    "scope": {
      "required_fields": [
        "capability"
      ],
      "rule_ids": [
        "BR-04",
        "BR-05",
        "BR-06",
        "BR-07"
      ]
    },
    "node": {
      "required_fields": [
        "dependency_state",
        "question_pending",
        "fact_gate"
      ],
      "rule_ids": [
        "BR-08",
        "BR-09",
        "BR-10",
        "BR-11",
        "BR-12",
        "BR-13",
        "BR-14",
        "BR-15"
      ]
    },
    "evidence": {
      "required_fields": [
        "coverage"
      ],
      "rule_ids": [
        "BR-16",
        "BR-17",
        "BR-18"
      ]
    },
    "result": {
      "required_fields": [
        "node_result"
      ],
      "rule_ids": [
        "BR-19",
        "BR-20",
        "BR-21"
      ]
    },
    "aggregate": {
      "required_fields": [
        "runnable_nodes",
        "waiting_questions",
        "partial_scope_covers_waits",
        "all_nodes_accounted"
      ],
      "rule_ids": [
        "BR-22",
        "BR-23",
        "BR-24",
        "BR-25"
      ]
    },
    "user_event": {
      "required_fields": [
        "user_event"
      ],
      "rule_ids": [
        "BR-26",
        "BR-27",
        "BR-28",
        "BR-29"
      ]
    },
    "tool_error": {
      "required_fields": [
        "retryable",
        "budget_remaining",
        "safe_to_retry"
      ],
      "rule_ids": [
        "BR-30",
        "BR-31"
      ]
    },
    "report": {
      "required_fields": [
        "snapshot_current",
        "report_validation",
        "repair_available",
        "simplified_attempted"
      ],
      "rule_ids": [
        "BR-32",
        "BR-33",
        "BR-34",
        "BR-35",
        "BR-36",
        "BR-37"
      ]
    },
    "review": {
      "required_fields": [
        "snapshot_current",
        "review_action",
        "release_allowed"
      ],
      "rule_ids": [
        "BR-38",
        "BR-39",
        "BR-40",
        "BR-41",
        "BR-42",
        "BR-43",
        "BR-44",
        "BR-45"
      ]
    },
    "change": {
      "required_fields": [
        "affected_results"
      ],
      "rule_ids": [
        "BR-46",
        "BR-47"
      ]
    }
  },
  "field_catalog": {
    "access_allowed": {
      "type": "boolean",
      "enum": [
        false,
        true
      ],
      "derived_by": "trusted_service",
      "meaning": "服务端按当前身份、组织、案件及具体动作判定权限；模型传入的角色不参与授权。"
    },
    "data_allowed": {
      "type": "boolean",
      "enum": [
        false,
        true
      ],
      "derived_by": "trusted_service",
      "meaning": "部署策略是否允许本次数据进入当前处理环境、模型及工具；当前 L0 仅允许合成案件。"
    },
    "input_valid": {
      "type": "boolean",
      "enum": [
        false,
        true
      ],
      "derived_by": "trusted_service",
      "meaning": "输入格式、文件解析及安全检查是否满足部署策略；附件指令不改变系统规则。"
    },
    "capability": {
      "type": "string",
      "enum": [
        "need_scope",
        "unsupported",
        "partial",
        "supported"
      ],
      "derived_by": "trusted_service",
      "meaning": "按法域、主题、交易期间、输出类型、发布环境和功能开关逐争点匹配；禁用优化视为对应请求不支持；目录存在不代表本案法源完整。"
    },
    "dependency_state": {
      "type": "string",
      "enum": [
        "invalid",
        "blocked",
        "ready"
      ],
      "derived_by": "trusted_service",
      "meaning": "规则图是否有效，以及当前节点的显式前置表达式是否满足；不能把所有上游均通过作为通用条件。"
    },
    "question_pending": {
      "type": "boolean",
      "enum": [
        false,
        true
      ],
      "derived_by": "trusted_service",
      "meaning": "当前节点选中阻断事实的相同值/版本是否已有有效待答问题；其他无关问题不计。"
    },
    "fact_gate": {
      "type": "string",
      "enum": [
        "conflict",
        "missing",
        "needs_ack",
        "unusable",
        "ready"
      ],
      "derived_by": "trusted_service",
      "meaning": "仅检查当前节点必需事实；按阻断等级、节点顺序、字段名选首个未决项，同一字段冲突优先于缺失，缺失优先于核对；全部通过后仍须校验运行策略。"
    },
    "coverage": {
      "type": "string",
      "enum": [
        "not_checked",
        "covered",
        "gap",
        "stale",
        "conflict"
      ],
      "derived_by": "trusted_service",
      "meaning": "检索和覆盖工具返回的本次输入版本状态；covered 要求必需依据、例外、适用日期、法域和验证等级满足环境策略。"
    },
    "node_result": {
      "type": "string",
      "enum": [
        "judgment",
        "invalid",
        "valid"
      ],
      "derived_by": "trusted_service",
      "meaning": "规则及节点校验结果：judgment 只形成待判事项，不确认主观条件；invalid 含结果/数值/引用校验失败。"
    },
    "runnable_nodes": {
      "type": "boolean",
      "enum": [
        false,
        true
      ],
      "derived_by": "trusted_service",
      "meaning": "调度器是否存在有进展的可执行节点或可登记的新问题；已登记等待节点不可反复选中。"
    },
    "waiting_questions": {
      "type": "boolean",
      "enum": [
        false,
        true
      ],
      "derived_by": "trusted_service",
      "meaning": "本轮范围内是否仍有用户待答事项，包括稍后提供。"
    },
    "partial_scope_covers_waits": {
      "type": "boolean",
      "enum": [
        false,
        true
      ],
      "derived_by": "trusted_service",
      "meaning": "用户明确选择部分稿的记录，是否覆盖当前全部待答阻断事项及其版本；不能由超时推定。"
    },
    "all_nodes_accounted": {
      "type": "boolean",
      "enum": [
        false,
        true
      ],
      "derived_by": "trusted_service",
      "meaning": "本轮节点均有有效完成结果、不适用理由或明确暂停/依赖阻塞原因，无漏项及无原因悬空节点。"
    },
    "user_event": {
      "type": "string",
      "enum": [
        "no_reply",
        "later",
        "unknown",
        "partial",
        "answer"
      ],
      "derived_by": "trusted_service",
      "meaning": "用户事件经输入检查后的分类；不确定含义时按普通 answer 处理并澄清，不能推定 partial。"
    },
    "retryable": {
      "type": "boolean",
      "enum": [
        false,
        true
      ],
      "derived_by": "trusted_service",
      "meaning": "错误码属临时超时或限流等可恢复故障；参数错误、权限拒绝、无依据、专业待判不属于此类。"
    },
    "budget_remaining": {
      "type": "boolean",
      "enum": [
        false,
        true
      ],
      "derived_by": "trusted_service",
      "meaning": "服务端共享重试计数尚未耗尽且截止时间未到；模型适配器和编排器合计。"
    },
    "safe_to_retry": {
      "type": "boolean",
      "enum": [
        false,
        true
      ],
      "derived_by": "trusted_service",
      "meaning": "只读操作或已证明幂等的写操作；写入超时须先按幂等键查询结果，不能未知状态直接重发。"
    },
    "snapshot_current": {
      "type": "boolean",
      "enum": [
        false,
        true
      ],
      "derived_by": "trusted_service",
      "meaning": "事实、规则、法源、案件范围和报告版本未失效；校验通过还须绑定实际报告内容哈希。"
    },
    "report_validation": {
      "type": "string",
      "enum": [
        "not_checked",
        "passed",
        "failed"
      ],
      "derived_by": "trusted_service",
      "meaning": "校验服务对实际报告正文和快照的结论；生成模型自评不能直接写 passed。"
    },
    "repair_available": {
      "type": "boolean",
      "enum": [
        false,
        true
      ],
      "derived_by": "trusted_service",
      "meaning": "当前冻结输入快照的报告生成周期内仍有修订预算；新建文本版本不会重置预算。"
    },
    "simplified_attempted": {
      "type": "boolean",
      "enum": [
        false,
        true
      ],
      "derived_by": "trusted_service",
      "meaning": "该报告生成周期是否已尝试过只保留范围与缺口的简化稿；防止无限简化循环。"
    },
    "review_action": {
      "type": "string",
      "enum": [
        "waiting",
        "approve",
        "amend_facts",
        "amend_text",
        "request_data",
        "decline"
      ],
      "derived_by": "trusted_service",
      "meaning": "最终复核阶段的事件；除 waiting 外须来自通过权限检查的复核者。"
    },
    "release_allowed": {
      "type": "boolean",
      "enum": [
        false,
        true
      ],
      "derived_by": "trusted_service",
      "meaning": "拟交付对象/用途满足当前发布等级和输出规则；最终批准不能改变发布等级或规则验证状态。"
    },
    "affected_results": {
      "type": "boolean",
      "enum": [
        false,
        true
      ],
      "derived_by": "trusted_service",
      "meaning": "变更影响分析输入、依赖或依据有效性；重复文件且无新增冲突时为 false。"
    }
  },
  "rules": [
    {
      "id": "BR-01",
      "phase": "admission",
      "priority": 1,
      "title": "越权请求阻断",
      "when": {
        "all": [
          {
            "field": "access_allowed",
            "op": "eq",
            "value": false
          }
        ]
      },
      "then": {
        "action": "block_request",
        "scope": "request",
        "outcome": "blocked",
        "tools": []
      },
      "business_contract": "保留原案件；不向调用者暴露无权限的案情。"
    },
    {
      "id": "BR-02",
      "phase": "admission",
      "priority": 2,
      "title": "环境或输入不合格",
      "when": {
        "any": [
          {
            "field": "data_allowed",
            "op": "eq",
            "value": false
          },
          {
            "field": "input_valid",
            "op": "eq",
            "value": false
          }
        ]
      },
      "then": {
        "action": "block_invalid_input",
        "scope": "request",
        "outcome": "blocked",
        "tools": []
      },
      "business_contract": "阻断本次处理并记录受限诊断；不把原始敏感数据复制到审计日志。"
    },
    {
      "id": "BR-03",
      "phase": "admission",
      "priority": 3,
      "title": "允许进入业务流程",
      "when": {
        "all": []
      },
      "then": {
        "action": "accept_input",
        "scope": "request",
        "outcome": "accepted",
        "tools": []
      },
      "business_contract": "读取可信案件上下文；仅将获准内容传给后续模型或工具。"
    },
    {
      "id": "BR-04",
      "phase": "scope",
      "priority": 1,
      "title": "范围不明确",
      "when": {
        "all": [
          {
            "field": "capability",
            "op": "eq",
            "value": "need_scope"
          }
        ]
      },
      "then": {
        "action": "ask_scope",
        "scope": "case",
        "outcome": "waiting_user",
        "tools": [
          "next_question"
        ]
      },
      "business_contract": "只问足以选择规则包的范围信息；同版本待答问题复用。"
    },
    {
      "id": "BR-05",
      "phase": "scope",
      "priority": 2,
      "title": "请求全部不支持",
      "when": {
        "all": [
          {
            "field": "capability",
            "op": "eq",
            "value": "unsupported"
          }
        ]
      },
      "then": {
        "action": "record_unsupported_scope",
        "scope": "case",
        "outcome": "scope_only",
        "tools": []
      },
      "business_contract": "登记全部未覆盖项；通过汇总与报告校验后形成范围说明，不输出税务结论。"
    },
    {
      "id": "BR-06",
      "phase": "scope",
      "priority": 3,
      "title": "请求部分支持",
      "when": {
        "all": [
          {
            "field": "capability",
            "op": "eq",
            "value": "partial"
          }
        ]
      },
      "then": {
        "action": "split_supported_issues",
        "scope": "case",
        "outcome": "partial_scope",
        "tools": []
      },
      "business_contract": "支持争点继续，其他争点标 unsupported；禁止把局部结论描述成跨国完整结论。"
    },
    {
      "id": "BR-07",
      "phase": "scope",
      "priority": 4,
      "title": "请求在已启用范围内",
      "when": {
        "all": []
      },
      "then": {
        "action": "build_issue_nodes",
        "scope": "case",
        "outcome": "scheduled",
        "tools": []
      },
      "business_contract": "依据能力包创建节点和依赖；交易计划与已发生事实分开建模。"
    },
    {
      "id": "BR-08",
      "phase": "node",
      "priority": 1,
      "title": "依赖图错误",
      "when": {
        "all": [
          {
            "field": "dependency_state",
            "op": "eq",
            "value": "invalid"
          }
        ]
      },
      "then": {
        "action": "stop_invalid_graph",
        "scope": "case",
        "outcome": "technical_error",
        "tools": []
      },
      "business_contract": "记录循环或不存在的节点引用；修复前不能生成实质分析稿。"
    },
    {
      "id": "BR-09",
      "phase": "node",
      "priority": 2,
      "title": "当前节点依赖未满足",
      "when": {
        "all": [
          {
            "field": "dependency_state",
            "op": "eq",
            "value": "blocked"
          }
        ]
      },
      "then": {
        "action": "record_dependency_block",
        "scope": "node",
        "outcome": "blocked_dependency",
        "tools": []
      },
      "business_contract": "记录具体上游和条件，回调度器处理独立节点。"
    },
    {
      "id": "BR-10",
      "phase": "node",
      "priority": 3,
      "title": "同版本问题已在等待",
      "when": {
        "all": [
          {
            "field": "question_pending",
            "op": "eq",
            "value": true
          }
        ]
      },
      "then": {
        "action": "reuse_pending_question",
        "scope": "node",
        "outcome": "waiting_user",
        "tools": []
      },
      "business_contract": "不重新提问；新输入出现时先核销或替换过期问题，再评价当前节点。"
    },
    {
      "id": "BR-11",
      "phase": "node",
      "priority": 4,
      "title": "关键事实冲突",
      "when": {
        "all": [
          {
            "field": "fact_gate",
            "op": "eq",
            "value": "conflict"
          }
        ]
      },
      "then": {
        "action": "ask_conflict",
        "scope": "node",
        "outcome": "waiting_user",
        "tools": [
          "next_question"
        ]
      },
      "business_contract": "展示互相矛盾的值及出处，请用户澄清；不以最新文档或模型置信度自动选边。"
    },
    {
      "id": "BR-12",
      "phase": "node",
      "priority": 5,
      "title": "缺少必需事实",
      "when": {
        "all": [
          {
            "field": "fact_gate",
            "op": "eq",
            "value": "missing"
          }
        ]
      },
      "then": {
        "action": "ask_required_fact",
        "scope": "node",
        "outcome": "waiting_user",
        "tools": [
          "next_question"
        ]
      },
      "business_contract": "只补当前节点决定性信息；金额、日期、主体等未知不得默认零、今天或否。"
    },
    {
      "id": "BR-13",
      "phase": "node",
      "priority": 6,
      "title": "候选提取值需要核对",
      "when": {
        "all": [
          {
            "field": "fact_gate",
            "op": "eq",
            "value": "needs_ack"
          }
        ]
      },
      "then": {
        "action": "ask_fact_ack",
        "scope": "node",
        "outcome": "waiting_user",
        "tools": [
          "next_question"
        ]
      },
      "business_contract": "提供原文和事实卡；用户核对绑定事实版本，不生成 advisor_confirmed。"
    },
    {
      "id": "BR-14",
      "phase": "node",
      "priority": 7,
      "title": "事实不满足运行策略",
      "when": {
        "all": [
          {
            "field": "fact_gate",
            "op": "eq",
            "value": "unusable"
          }
        ]
      },
      "then": {
        "action": "record_fact_policy_gap",
        "scope": "node",
        "outcome": "paused_gap",
        "tools": []
      },
      "business_contract": "有值或用户已核对仍不代表可运算；不能通过提升事实状态绕过运行策略。"
    },
    {
      "id": "BR-15",
      "phase": "node",
      "priority": 8,
      "title": "足以开展当前节点预分析",
      "when": {
        "all": []
      },
      "then": {
        "action": "prepare_analysis_snapshot",
        "scope": "node",
        "outcome": "ready_for_sources",
        "tools": []
      },
      "business_contract": "冻结允许使用的事实及出处；L0 显式研究假设另存快照并保留原候选状态。"
    },
    {
      "id": "BR-16",
      "phase": "evidence",
      "priority": 1,
      "title": "尚未检索或覆盖核验",
      "when": {
        "all": [
          {
            "field": "coverage",
            "op": "eq",
            "value": "not_checked"
          }
        ]
      },
      "then": {
        "action": "retrieve_and_check",
        "scope": "node",
        "outcome": "coverage_pending",
        "tools": [
          "retrieve_legal_sources",
          "check_coverage"
        ]
      },
      "business_contract": "按争点、主体、法域、税种、交易期间和规则版本检索，并检查例外及相反材料。"
    },
    {
      "id": "BR-17",
      "phase": "evidence",
      "priority": 2,
      "title": "依据存在缺口或冲突",
      "when": {
        "all": [
          {
            "field": "coverage",
            "op": "in",
            "value": [
              "gap",
              "stale",
              "conflict"
            ]
          }
        ]
      },
      "then": {
        "action": "record_source_gap",
        "scope": "node",
        "outcome": "paused_gap",
        "tools": []
      },
      "business_contract": "保留具体缺失或冲突；历史交易可用其适用的历史版本，旧发布日期本身不等于过期。"
    },
    {
      "id": "BR-18",
      "phase": "evidence",
      "priority": 3,
      "title": "依据满足当前运行策略",
      "when": {
