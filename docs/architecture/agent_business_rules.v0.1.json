          },
          {
            "field": "budget_remaining",
            "op": "eq",
            "value": true
          },
          {
            "field": "safe_to_retry",
            "op": "eq",
            "value": true
          }
        ]
      },
      "then": {
        "action": "bounded_retry",
        "scope": "tool_call",
        "outcome": "retry_scheduled",
        "tools": []
      },
