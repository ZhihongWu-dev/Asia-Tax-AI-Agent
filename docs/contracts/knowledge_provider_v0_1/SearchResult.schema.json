{
  "$defs": {
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "not_assessed",
          "enum": [
            "unchecked",
            "partial",
            "sufficient_for_task",
            "not_assessed"
          ],
          "title": "Status",
          "type": "string"
        },
        "scope": {
          "default": "",
          "title": "Scope",
          "type": "string"
        },
        "missing_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Missing Requirements",
          "type": "array"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "title": "Coverage",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "source_version_id": {
          "title": "Source Version Id",
          "type": "string"
        },
        "unit_id": {
          "title": "Unit Id",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "is_synthetic": {
          "default": false,
          "title": "Is Synthetic",
          "type": "boolean"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "publisher": {
          "default": "",
          "title": "Publisher",
          "type": "string"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        },
        "language": {
          "default": "zh",
          "title": "Language",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "jurisdiction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jurisdiction"
        },
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic"
        },
        "publication_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Date"
        },
        "effective_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective From"
        },
        "effective_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective To"
        },
        "verification_status": {
          "default": "unverified",
          "enum": [
            "verified",
            "unverified"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "drift": {
          "default": false,
          "title": "Drift",
          "type": "boolean"
        },
        "heading": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "coverage_cutoff": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Cutoff"
        },
        "snapshot_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Sha256"
        },
        "model_use": {
          "default": "unknown",
          "enum": [
            "allowed",
            "denied",
            "unknown"
          ],
          "title": "Model Use",
          "type": "string"
        },
        "display_use": {
          "default": "unknown",
          "enum": [
            "allowed",
            "denied",
            "unknown"
          ],
          "title": "Display Use",
          "type": "string"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "restriction_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Restriction Reason"
        },
        "model_text": {
          "anyOf": [
            {
              "maxLength": 30000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Text"
        },
        "display_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "evidence_id",
        "source_version_id",
        "unit_id",
        "source_id",
        "content_hash",
        "title",
        "source_type",
        "policy_version"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ProviderError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ProviderError",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "source_version_id": {
          "title": "Source Version Id",
          "type": "string"
        },
        "unit_id": {
          "title": "Unit Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_version_id",
        "unit_id"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Timings": {
      "additionalProperties": false,
      "properties": {
        "db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Db"
        },
        "retrieval": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval"
        },
        "rerank": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank"
        },
        "total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        }
      },
      "title": "Timings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    },
    "retrieval_id": {
      "title": "Retrieval Id",
      "type": "string"
    },
    "provider": {
      "enum": [
        "mock",
        "c",
        "legacy"
      ],
      "title": "Provider",
      "type": "string"
    },
    "is_synthetic": {
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "corpus_version": {
      "title": "Corpus Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "no_match",
        "error"
      ],
      "title": "Status",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 50,
      "title": "Evidence",
      "type": "array"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "timings_ms": {
      "$ref": "#/$defs/Timings"
    }
  },
  "required": [
    "request_id",
    "trace_id",
    "retrieval_id",
    "provider",
    "is_synthetic",
    "corpus_version",
    "status"
  ],
  "title": "SearchResult",
  "type": "object"
}
