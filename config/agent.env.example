# Append selected settings to your private .env; never commit real keys.
# Existing credentials use FSIE_MODEL_BASE_URL / FSIE_MODEL_API_KEY / FSIE_MODEL_NAME.
# Default legacy preserves A's current read-only knowledge database adapter.
FSIE_AGENT_PROVIDER=mock
FSIE_AGENT_MOCK_SCENARIO=MOCK-01
# C integration only after the wire contract is agreed and configured.
# FSIE_AGENT_PROVIDER=c
# FSIE_AGENT_C_URL=https://your-knowledge-service.example.invalid
# FSIE_AGENT_C_TOKEN=
# Reviewer identities are configured on the server, not sent by the frontend.
FSIE_AGENT_REVIEWER_IDS=[]
# Case store and knowledge store are independent.
FSIE_WEB_DATABASE_URL=sqlite:///data/chat_cases.sqlite
# Deployment defaults keep legacy until the hybrid model/C gates are accepted.
FSIE_AGENT_ORCHESTRATION=legacy
FSIE_AGENT_DYNAMIC_PLANNER=false
# Local hybrid test: FSIE_TEST_ORCHESTRATION=hybrid tests/chat/serve_browser.py
