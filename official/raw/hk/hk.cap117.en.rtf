\pard\plain \ltrpar\ql \li0\ri0\nowidctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1779345 \rtlch\fcs1 \af0\afs24\alang1025 \ltrch\fcs0 \fs24\lang1033\langfe1033\kerning2\loch\af0\hich\af0\dbch\af14\cgrid\langnp1033\langfenp1033 {\*\latentstyles\lsdstimax267\lsdlockeddef0\lsdsemihiddendef1\lsdunhideuseddef1\lsdqformatdef0\lsdprioritydef99{\lsdlockedexcept \lsdsemihidden0 \lsdunhideused0 \lsdqformat1 \lsdpriority0 \lsdlocked0 Normal;}}\pard\plain\nosnaplinegrid\b\i0\fs22\qj\sb240\sa80\keepn\fi-720\li720\tx960\sl260{{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 46.}{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Instruments affecting immovable property made for new Government lease or exchange to be exempt\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Where the Director of Lands certifies that any instrument affecting any immovable property held from the Government has been executed in compliance with his requirements for the sole purpose of enabling a Government lease of the immovable property to be granted to the owner thereof and has been replaced by a new instrument affecting the immovable property in the same manner as, and similar as far as possible to, the instrument replaced, and executed immediately upon the granting of the said Government lease, then such instruments shall be exempt from stamp duty, and the Collector shall, on production to him of the instruments so certified, endorse on the instruments a certificate, or issue a stamp certificate, to the effect that the instruments are by virtue of this section exempt from stamp duty.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Where the Director of Lands certifies that any instrument affecting any immovable property held from the Government has been executed in compliance with his requirements for the sole purpose of enabling the owner of the immovable property to surrender it to the Government as consideration or part consideration for an exchange and has been replaced by a new instrument affecting the immovable property in the same manner as, and similar as far as possible to, the instrument replaced, and executed immediately upon the granting of the said Government lease, then such instruments shall be exempt from stamp duty, and the Collector shall, on production to him of the instruments so certified, endorse on the instruments a certificate, or issue a stamp certificate, to the effect that the instruments are by virtue of this section exempt from stamp duty.\par }}\pard\plain\nosnaplinegrid\b0\i\fs22\qr\sb0\sa80\li720\sl260{{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 8 of 1993 s. 3}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 L.N. 291 of 1993}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 12 of 1999 s. 3}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 21 of 2003 s. 19}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 )\par }}
