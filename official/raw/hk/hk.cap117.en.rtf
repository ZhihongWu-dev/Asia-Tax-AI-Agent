\pard\plain \ltrpar\ql \li0\ri0\nowidctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1779345 \rtlch\fcs1 \af0\afs24\alang1025 \ltrch\fcs0 \fs24\lang1033\langfe1033\kerning2\loch\af0\hich\af0\dbch\af14\cgrid\langnp1033\langfenp1033 {\*\latentstyles\lsdstimax267\lsdlockeddef0\lsdsemihiddendef1\lsdunhideuseddef1\lsdqformatdef0\lsdprioritydef99{\lsdlockedexcept \lsdsemihidden0 \lsdunhideused0 \lsdqformat1 \lsdpriority0 \lsdlocked0 Normal;}}\pard\plain\nosnaplinegrid\b\i0\fs22\qj\sb240\sa80\keepn\fi-720\li720\tx960\sl260{{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 45.}{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Relief in case of conveyance from one associated body corporate to another\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Stamp duty under head 1(1), (1AA) or (1AAB) or 2(1) or (3) in the }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 First Schedule}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  shall not be chargeable on an instrument to which this section applies.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 14 of 2011 s. 13}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 2 of 2014 s. 16}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Subject to subsections (4), (5), (5A) and (6), this section applies to any instrument as respects which it is shown to the satisfaction of the Collector that the effect thereof is to convey a beneficial interest in immovable property, or to transfer a beneficial interest in Hong Kong stock, from one associated body corporate to another, and also applies to any instrument that is a contract note in respect of a sale or purchase of Hong Kong stock made between one associated body corporate and another, where in each case the bodies are associated, that is to say, one is beneficial owner of not less than 90 per cent of the issued share capital of the other, or a third such body is beneficial owner of not less than 90 per cent of the issued share capital of each.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (3)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 An instrument to which this section applies and that conveys a beneficial interest in immovable property or is a contract note shall not be duly stamped unless it is stamped with the stamp duty with which it would, but for this section, be chargeable or it has, in accordance with }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 13}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 , been stamped with a particular stamp or by way of a stamp certificate, denoting either that it is not chargeable with any stamp duty or that it is duly stamped.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 21 of 2003 s. 18}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (4)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 This section shall not apply to any instrument unless it is also shown to the satisfaction of the Collector that the instrument was not executed, or the sale or purchase of the Hong Kong stock was not made, in pursuance of or in connexion with an arrangement under which\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the consideration, or any part of the consideration, for the conveyance, transfer, sale or purchase was to be provided or received, directly or indirectly by a person other than a body corporate which at the time of the sale or purchase, or of the execution of the conveyance or transfer, was associated within the meaning of subsection (2) with either the transferor or the transferee (meaning respectively, the body corporate from whom and the body corporate to whom the beneficial interest was conveyed or transferred, or the Hong Kong stock was purchased or sold);\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the said interest was previously conveyed, transferred, purchased or sold, directly or indirectly, by such a person; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the transferor and the transferee were to cease to be associated within the meaning of subsection (2) by reason of a change in the percentage of the issued share capital of the transferee in the beneficial ownership of the transferor or a third body corporate.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (5)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Without prejudice to the generality of paragraph (a) of subsection (4), an arrangement shall be treated as within that paragraph if it is one under which the transferor or the transferee, or a body corporate associated with either as there mentioned, was to be enabled to provide any of the consideration, or was to part with any of it, by or in consequence of the carrying out of a transaction or transactions involving, or any of them involving, a payment or other disposition by a person other than a body corporate so associated.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (5A)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Where a transferor and transferee, as described in subsection (4), cease to be associated as described in subsection }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (4)(c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  within 2 years after the date of execution of the instrument or, in the case of contract note, within 2 years after the date on which the note was required to have been made and executed under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 19}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 , and relief from stamp duty has been claimed under this section\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the transferor and transferee shall notify the Collector of that fact and of the date of the cessation within 30 days after the date of the cessation;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Repealed }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 10 of 2013 s. 30}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 if any relief from stamp duty has been granted by the Collector under this section, the relief is deemed to be withdrawn subject to }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 13(6)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  and the transferor and transferee are liable or jointly and severally liable, as the case may be, to pay to the Collector, within 30 days after the date of the cessation, by way of stamp duty an amount equal to the stamp duty which would have been chargeable on the instrument had relief not been granted under this section;}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 10 of 2013 s. 30}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 if the amount referred to in paragraph (c) is not paid within the 30 days\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 the transferor and transferee are liable or jointly and severally liable (as the case requires) to a penalty; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 the amount of the penalty payable after a lapse of a period of time after the 30 days is the same as that calculated under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 section 9}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0  for an instrument chargeable with stamp duty of the amount referred to in paragraph (c) that\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2640\tqr\tx2400\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 (A)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 is not stamped before or within the time for stamping it; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2640\tqr\tx2400\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 (B)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 is stamped after the lapse of the same period of time after the time for stamping it; and}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 (Replaced }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 10 of 2013 s. 30}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (e)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the Collector may remit the whole or any part of any penalty payable under paragraph (d).}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 10 of 2013 s. 30}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (6)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 The ownership referred to in subsections (2) and (4) is ownership either directly or through another body corporate or other bodies corporate, or partly directly and partly through another body corporate or other bodies corporate, and the }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Third Schedule}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  shall apply accordingly for the purposes of this section.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (7)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 A person who fails to comply with subsection }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (5A)(a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  shall incur a penalty at level 2 which shall be recoverable by the Collector as a civil debt due to the Government.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \