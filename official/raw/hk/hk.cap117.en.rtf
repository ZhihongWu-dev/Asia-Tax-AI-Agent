\pard\plain \ltrpar\ql \li0\ri0\nowidctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1779345 \rtlch\fcs1 \af0\afs24\alang1025 \ltrch\fcs0 \fs24\lang1033\langfe1033\kerning2\loch\af0\hich\af0\dbch\af14\cgrid\langnp1033\langfenp1033 {\*\latentstyles\lsdstimax267\lsdlockeddef0\lsdsemihiddendef1\lsdunhideuseddef1\lsdqformatdef0\lsdprioritydef99{\lsdlockedexcept \lsdsemihidden0 \lsdunhideused0 \lsdqformat1 \lsdpriority0 \lsdlocked0 Normal;}}\pard\plain\nosnaplinegrid\b\i0\fs22\qj\sb240\sa80\keepn\fi-720\li720\tx960\sl260{{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 14.}{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Appeal against assessment\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Any person who is dissatisfied with the assessment of the Collector under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 13}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  or }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 47L}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  may\u8212??\u160??\u160??}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 10 of 2013 s. 27}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 within a period of 1 month from the date on which the assessment is made or within such further period as the court may allow under subsection (5B);\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 subject to any order of the court under subsection (1B), on payment of the stamp duty in conformity therewith or, where payment of the stamp duty or any part thereof is allowed to be postponed under subsection (1A), on payment of the part (if any) of the stamp duty the payment of which is not thus allowed to be postponed; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 by notice served on the Registrar,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li1200\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 appeal against the assessment to the court and may for that purpose require the Collector to state and sign a case setting forth the question upon which his opinion was required and the assessment made by him.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 33 of 1998 s. 3}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1A)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Where\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 an application in writing made for the purposes of this subsection by the person liable for payment of the stamp duty payable under an assessment of the Collector under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 13}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  or }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 47L}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  is received by the Collector within 14 days from the date on which the assessment is made;}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 10 of 2013 s. 27}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the person has stated in the application that he proposes to bring an appeal against the assessment under subsection (1); and \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 security to the satisfaction of the Collector has been given for the payment of the stamp duty that will, by reason of the exercise of the power by the Collector under this subsection, be postponed,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li1200\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the Collector may, by notice in writing served on the person, allow payment of the stamp duty payable under the assessment to be postponed for such period, to such extent and on such terms as the Collector may think fit.}{\b0\i0\n