\pard\plain \ltrpar\ql \li0\ri0\nowidctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1779345 \rtlch\fcs1 \af0\afs24\alang1025 \ltrch\fcs0 \fs24\lang1033\langfe1033\kerning2\loch\af0\hich\af0\dbch\af14\cgrid\langnp1033\langfenp1033 {\*\latentstyles\lsdstimax267\lsdlockeddef0\lsdsemihiddendef1\lsdunhideuseddef1\lsdqformatdef0\lsdprioritydef99{\lsdlockedexcept \lsdsemihidden0 \lsdunhideused0 \lsdqformat1 \lsdpriority0 \lsdlocked0 Normal;}}\pard\plain\nosnaplinegrid\b\i0\fs22\qj\sb240\sa80\keepn\fi-720\li720\tx960\sl260{{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 30.}{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Interpretation of Part IV\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Omitted as spent\u8212??}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 E.R. 2 of 2014}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 In this Part\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-480\li1200\sl260{{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 certificate to bearer}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u19981??\u35352??\u21517??\u35657??\u26126??\u26360??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ), in relation to a unit under a unit trust scheme, means a document by the delivery of which the unit can be transferred;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-480\li1200\sl260{{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 trust instrument}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u20449??\u35351??\u25991??\u26360??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ), in relation to a unit trust scheme, means the trust deed or other instrument (whether under seal or not) creating or recording the trusts by virtue of which persons are to participate in such scheme;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-480\li1200\sl260{{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 trust property}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u20449??\u35351??\u36001??\u29986??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ), in relation to a unit trust scheme, means property subject to the trusts of the trust instrument;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-480\li1200\sl260{{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 unit}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u21934??\u20301??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ), in relation to a unit trust scheme, means a right or interest (whether described as a unit, as a sub-unit or otherwise) of a beneficiary under the trust instrument;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-480\li1200\sl260{{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 unit trust scheme}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u21934??\u20301??\u20449??\u35351??\u35336??\u21123??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ) means any arrangements made for the purpose, or having the effect, of providing, for persons having funds available for investment, facilities for the participation by them, as beneficiaries under a trust, in any profits or income arising from the acquisition, holding, management or disposal of any property whatsoever.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (3)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Where a person authorizes or requires the trustees or managers under a unit trust scheme to treat him as no longer interested in a unit under that scheme and authorizes or requires them to treat another person as entitled to that unit, he shall be deemed for the purposes of this Ordinance to transfer that unit, and any instrument whereby he gives the authority or makes the requirement or any other instrument expressed to be substituted therefor by the managers with the approval of the Collector shall be deemed for those purposes to be a transfer operating as a voluntary disposition inter vivos under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 27(4)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  or a transfer by way of sale falling within head 2(4) in the }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 First Schedule}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  according to the nature of the transaction as between him and the person whom he authorizes or requires the trustees or managers to treat as entitled to the unit.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 77 of 1981 s. 7}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (4)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Where a person authorizes or requires the trustees or managers under a unit trust scheme to treat him as no longer interested in a unit under that scheme and does not authorize or require them to treat another person as entitled to that unit, he shall be deemed for the purposes of this Ordinance to transfer that unit to the managers by way of sale, and any instrument whereby he gives the authority or makes the requirement or any other instrument expressed to be substituted therefor by the managers with the approval of the Collector shall be deemed for those purposes to be a transfer falling within head 2(4) in the }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 First Schedule}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 .}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 77 of 1981 s. 7}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (5)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Where the managers under a unit trust scheme authorize or require the trustees under that scheme to treat a person as entitled to a unit thereunder and their power so to do arises from a previous transfer to them of that unit or some other unit, they shall be deemed for the purposes of this Ordinance to transfer the first-mentioned unit to that person by way of sale, and any instrument whereby they give the authority or make the requirement or any other instrument expressed to be substituted therefor by the managers with the approval of the Collector shall be deemed for those purposes to be a transfer falling within head 2(4) in the }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 First Schedule}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ; but this subsection does not apply to anything done by the managers for the purpose merely of recognizing or giving effect to a transmission of a unit by operation of law.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 77 of 1981 s. 7}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}
