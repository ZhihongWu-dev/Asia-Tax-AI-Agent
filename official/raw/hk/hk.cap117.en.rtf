\clbrdrt\brdrtbl \clbrdrl\brdrtbl \clbrdrb\brdrtbl \clbrdrr\brdrtbl\clpadl0\clpadfl3\clpadt0\clpadft3\clpadb0\clpadfb3\clpadr0\clpadfr3\clshdrawnil\cltxlrtb\clftsWidth2\clwWidth1262\clNoWrap\cellx9384\row}}}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 CONDITIONS\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li0\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0          \u160??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0 The machine shall not, except for the purpose of bringing it to the Stamp Office or with the permission of the Collector of Stamp Revenue, be moved from the address hereinbefore specified at which it may be used.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li0\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0          \u160??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0 The licensee shall maintain the machine in good working order to the satisfaction of the Collector of Stamp Revenue and shall, not less than once in every 2 years and at such other times as the Collector of Stamp Revenue may require, have the machine inspected by the agents in Hong Kong of the manufacturers.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li0\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0          \u160??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0 The licensee shall permit the Collector of Stamp Revenue or an officer of the Stamp Office authorized in writing by the Collector of Stamp Revenue to inspect the machine at such times as the Collector of Stamp Revenue thinks fit, and shall, for that purpose, allow the Collector of Stamp Revenue or the officer so authorized access to the place where the machine is kept.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li0\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0          \u160??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0 No words, letters, or marks of any kind whatsoever, other than the stamp denoting the duty with which the instrument is chargeable and the date of stamping, shall be stamped on any instrument by means of the machine.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li0\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0         \u160??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0 Except with the written consent of the Collector of Stamp Revenue, the machine shall not be used to stamp any instrument other than those connected with the business of the licensee.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li0\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0 6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0          \u160??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0 The licensee shall, on the first day of each month (or if that day is not a working day, on the next working day), send to the Collector of Stamp Revenue, in such form as he may direct, notice of the value of the stamps impressed by means of the machine during the preceding month.\par }}\pard\plain\nosnaplinegrid\b0\i\fs22\qr\sb0\sa80\li0\sl260{{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li0\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li0\cf1 \f0 40 of 1992 s. 8}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li0\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b\i0\fs28\qc\sb240\sa80\li0\sl320{{\b\i0\nosupersub\nosupersub\fs28\qc\qc\li0\cf1 \f0 Part 2\par }}\pard\plain\nosnaplinegrid\b\i0\fs28\qc\sb240\sa80\keepn\li0\sl320{{\b\i0\nosupersub\nosupersub\fs28\qc\qc\li0\cf1 \f0 General Provisions\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Every licence shall\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 be issued in respect of one franking machine only;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 be issued in respect of a franking machine of a type and make approved by the Collector;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 be not transferable. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Every application for a licence shall be in such form as the Collector may from time to time determine\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The die and the colour of the stamp to be used in a franking machine shall be in accordance with such specifications or requirements as the Collector may direct.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The licensee shall make payment to the Collector in respect of each setting or re-setting of the meter of the licensed franking machine at the time of such setting or re-setting.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 In the case of every licensed franking machine\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the meter shall be set or re-set, as the case may be, by the Collector or a public officer authorized in writing by the Collector for the purposes of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 7}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\keepn\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 after the meter has been so set or re-set, the franking machine shall be sealed by the Collector or such public officer with a seal approved by the Collector for the purposes of this provision.\par }}\pard\plain\nosnaplinegrid\fs22\qc\sb0\sa0{{\nosupersub\nosupersub\qc\qc\cf1 \f0 ___________\par }}
