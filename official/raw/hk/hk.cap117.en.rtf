\clbrdrt\brdrtbl \clbrdrl\brdrtbl \clbrdrb\brdrtbl \clbrdrr\brdrtbl\clpadl0\clpadfl3\clpadt0\clpadft3\clpadb0\clpadfb3\clpadr0\clpadfr3\clshdrawnil\cltxlrtb\clftsWidth2\clwWidth2000\clNoWrap\cellx9386\row}}}\pard\plain\nosnaplinegrid\b\i0\fs28\qc\sb240\sa80\keepn\li0\sl320{{\b\i0\nosupersub\nosupersub\fs28\qc\qc\li0\cf1 \f0 Provisions for Determining Amount of Share Capital Held Through Other Bodies Corporate\par }}\pard\plain\nosnaplinegrid\b0\i\fs22\qr\sb0\sa80\li0\sl260{{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li0\cf1 \f0 (Format changes\u8212??}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li0\cf1 \f0 E.R. 1 of 2015}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li0\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where, in the case of a number of bodies corporate, the first directly owns share capital of the second and the second directly owns share capital of the third, then, for the purposes of this }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Schedule}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 , the first shall be deemed to own share capital of the third through the second, and, if the third directly owns share capital of a fourth, the first shall be deemed to own share capital of the fourth through the second and third, and the second shall be deemed to own share capital of the fourth through the third, and so on.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 In this }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Schedule}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 any number of bodies corporate of which the first directly owns share capital of the next and the next directly owns share capital of the next but one and so on, and, if they are more than 3, any 3 or more of them, are referred to as }{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 a series}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 in any series\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 that body corporate which owns share capital of another through the remainder is referred to as }{\b\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 the first owner}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 ;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 that other body corporate the share capital of which is so owned is referred to as }{\b\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 the last owned body corporate}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 ;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (iii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 the remainder, if one only, is referred to as an }{\b\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 intermediary}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0  and, if more than one, referred to as }{\b\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 a chain of intermediaries}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 ;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 a body corporate in a series which directly owns share capital of another body corporate in the series is referred to as an }{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 owner}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 any 2 bodies corporate in a series of which one owns share capital of the other directly, and not through one or more of the other bodies corporate in the series, are referred to as being directly related to one another.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where every owner in a series owns the whole of the share capital of the body corporate to which it is directly related, the first owner shall be deemed to own through the intermediary or chain of intermediaries the whole of the share capital of the last owned body corporate.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where one of the owners in a series owns a fraction of the share capital of the body corporate to which it is directly related, and every other owner in the series owns the whole of the share capital of the body corporate to which it is directly related, the first owner shall be deemed to own that fraction of the share capital of the last owned body corporate through the intermediary or chain of intermediaries.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 each of 2 or more of the owners in a series owns a fraction, and every other owner in the series owns the whole, of the share capital of the body corporate to which it is directly related; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 every owner in a series owns a fraction of the share capital of the body corporate to which it is directly related,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 the first owner shall be deemed to own through the intermediary or chain of intermediaries such fraction of the share capital of the last owned body corporate as results from the multiplication of those fractions.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where the first owner in any series owns a fraction of the share capital}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 of the last owned body corporate in that series through the intermediary or chain of intermediaries in that series, and also owns another fraction or other fractions of the share capital of the last owned body corporate, either\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 directly; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 through an intermediary or intermediaries which is not a member or are not members of that series; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 through a chain or chains of intermediaries of which one or some or all are not members of that series; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 in a case where the series consists of more than 3 bodies corporate, through an intermediary or intermediaries which is a member or are members of the series, or through a chain or chains of intermediaries consisting of some but not all of the bodies corporate of which the chain of intermediaries in the series consists,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\keepn\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 then, for the purpose of ascertaining the amount of the share capital of the last owned body corporate owned by the first owner, all those fractions shall be aggregated and the first owner shall be deemed to own the sum of those fractions.\par }}\pard\plain\nosnaplinegrid\fs22\qc\sb0\sa0{{\nosupersub\nosupersub\qc\qc\cf1 \f0 ___________\par }}
