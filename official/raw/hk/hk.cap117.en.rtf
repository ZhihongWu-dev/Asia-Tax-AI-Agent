ersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 The buyer\u8217??s stamp duty chargeable on a conveyance on sale under head 1(1AAB) in the }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 First Schedule}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  is in addition to any other stamp duty with which the conveyance is chargeable.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (13)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 If an instrument is not chargeable with stamp duty under head 1(1) in the }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 First Schedule}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 , it is not chargeable with buyer\u8217??s stamp duty under head 1(1AAB) in that }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Schedule}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 .\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (14)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Paragraphs (a), (b), (c) and (d) of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 29D(6)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  also apply for the purposes of this section.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (15)-(17)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Repealed }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 14 of 2014 s. 20}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0