# Environment and secrets (no key is kept in git since 2026-11-20)
.env
.env.*
key.md
.codex/runtime/
.codex/claude-runtime/
!.env.example
*.pem
*.key
secrets/

# Python
__pycache__/
*.egg-info/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Node.js and frontend builds
node_modules/
dist/
build/
.next/
coverage/
# the library's coverage matrix, source and watch lists (database/tools/coverage.py) belong in git
!database/coverage/

# Logs and temporary files
reports/
*.log
*.tmp
*.temp
tmp/
temp/

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local document review and rendering artifacts
.codex-doc-review/
*.rendered.pdf

# Restricted or local source data
data/
knowledge/**/raw/

# Private account quota snapshots are not team evaluation evidence.
evals/b_workflow/runs/free_quota_*.json
evals/b_workflow/runs/model_e2e_quota_*.json

# Local legacy document reader installed during deployment
.tools/

# Cases are runtime data, and hold client documents
/cases/

# Optimizer products of command-line runs; optimize.py run writes them again
/optimization/products/

# Retrieval indexes (rebuilt by agent/tools/law_index.py and read_index.py)
database/index/
**/intake/index/
**/intake/products/*/index/

# OCR runs in progress (database/tools/ocr.py)
database/ocr/.parts/

# Local cache of the remote library (database/tools/dbsource.py)
.cache/

# The collector side is not kept in git (2026-11-20): collectors pull it from the collector kit on Supabase
# (kit/ in the bucket, written by database/tools/upload.py). Git keeps the library and its reader: dbsource, find,
# the MCP server, its check, and the MCP spec.
database/tools/*
!database/tools/dbsource.py
!database/tools/find.py
!database/tools/mcp_server.py
!database/tools/test_mcp_server.py
database/samples/
database/viewer/
database/requirements.txt
database/database_spec.en.md
database/数据库规范.md
database/collection_task_sheet.en.md
database/采集任务单.md
database/scope.csv
database/leads.csv
database/.clause_before.csv
