 Special Administrative Region,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa0\li1200\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \u8212?? profits tax,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa0\fi0\li1200\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \u8212?? salaries tax, and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi0\li1200\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \u8212?? property tax;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 in the case of Thailand,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa0\li1200\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \u8212?? income tax, and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi0\li1200\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \u8212?? petroleum income tax.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 This Agreement shall apply also to any identical or substantially similar taxes that are imposed after the date of signature of this Agreement in addition to, or in place of, the existing taxes as well as any other taxes falling within }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraphs 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  of this Article which a Contracting Party may impose in future. The competent authorities of the Contracting Parties shall notify each other of significant changes that have been made in their respective taxation laws.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The existing taxes, together with the taxes imposed after the signature of this Agreement, are hereinafter referred to as \u8220??Hong Kong Special Administrative Region tax\u8221?? and \u8220??Thai tax\u8221??.\par }}

{\sect \sectd }\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 3\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 GENERAL DEFINITIONS\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 For the purposes of this Agreement, unless the context otherwise requires:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the term \u8220??Hong Kong Special Administrative Region\u8221?? means the Hong Kong Special Administrative Region of the People\u8217??s Republic of China; used in a geographical sense, it means the land and sea comprised within the boundary of the Hong Kong Special Administrative Region, including Hong Kong Island, Kowloon, the New Territories and the waters of Hong Kong;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the term \u8220??Thailand\u8221?? means the territory of the Kingdom of Thailand, including its internal waters, its territorial seas, and any maritime areas over which the Kingdom of Thailand has sovereign rights or jurisdiction under international law;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the term \u8220??company\u8221?? means any body corporate or any entity which is treated as a body corporate for tax purposes;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the term \u8220??competent authority\u8221?? means:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 in the case of the Hong Kong Special Administrative Region, the Commissioner of Inland Revenue, or his authorised representative or any person or body authorised to perform any functions at present exercisable by the Commissioner or similar functions;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 in the case of Thailand, the Minister of Finance or his authorised representative;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (e)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the terms \u8220??a Contracting Party\u8221?? and \u8220??the other Contracting Party\u8221?? mean the Hong Kong Special Administrative Region or Thailand, as the context requires;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (f)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the terms \u8220??enterprise of a Contracting Party\u8221?? and \u8220??enterprise of the other Contracting Party\u8221?? mean respectively an enterprise carried on by a resident of a Contracting Party and an enterprise carried on by a resident of the other Contracting Party;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (g)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the term \u8220??international traffic\u8221?? means any transport by a ship or aircraft operated by an enterprise of a Contracting Party, except when the ship or aircraft is operated solely between places in the other Contracting Party;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (h)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the term \u8220??person\u8221?? includes an individual, a company, a trust, a partnership, any other body of persons as well as any entity treated as a taxable unit under the taxation laws in force in either Contracting Party;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the term \u8220??tax\u8221?? means Hong Kong Special Administrative Region tax or Thai tax, as the context requires;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (j)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the term \u8220??national\u8221?? means, in the case of Thailand,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 any individual possessing Thai nationality;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 any legal person, partnership, association and any other entity deriving its status as such from the laws in force in Thailand.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 As regards the application of this Agreement at any time by a Contracting Party, any term not defined therein shall, unless the context otherwise requires, have the meaning which it has at that time under the laws of that Contracting Party for the purposes of the taxes to which this Agreement applies, any meaning under the applicable tax laws of that Contracting Party prevailing over a meaning given to the term under other laws of that Contracting Party.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 4\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 RESIDENT\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 For the purposes of this Agreement, the term \u8220??resident of a Contracting Party\u8221?? means:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 in the case of the Hong Kong Special Administrative Region,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 any individual who ordinarily resides in the Hong Kong Special Administrative Region;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 any individual who stays in the Hong Kong Special Administrative Region for more than 180 days during a year of assessment or for more than 300 days in two consecutive years of assessment one of which is the relevant year of assessment;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (iii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 a company incorporated in the Hong Kong Special Administrative Region or, if incorporated outside the Hong Kong Special Administrative Region, being normally managed or controlled in the Hong Kong Special Administrative Region;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (iv)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 any other person constituted under the laws of the Hong Kong Special Administrative Region, or if constituted outside the Hong Kong Special Administrative Region, being normally managed or controlled in the Hong Kong Special Administrative Region;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 in the case of Thailand, any person who, under the laws of Thailand, is liable to tax therein by reason of his domicile, residence, place of incorporation, place of management or any other criterion of a similar nature. This term, however, does not include any person who is liable to tax in Thailand in respect only of income from sources in Thailand;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 in the case of either Contracting Party, the Government of that Contracting Party and any local authority thereof.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where by reason of the provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 , an individual is a resident of both Contracting Parties, then his status shall be determined as follows:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 he shall be deemed to be a resident only of the Contracting Party in which he has a permanent home available to him; if he has a permanent home available to him in both Contracting Parties, he shall be deemed to be a resident only of the Contracting Party with which his personal and economic relations are closer (\u8220??centre of vital interests\u8221??);\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 if the Contracting Party in which he has his centre of vital interests cannot be determined, or if he has not a permanent home available to him in either Contracting Party, he shall be deemed to be a resident only of the Contracting Party in which he has an habitual abode;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 if he has an habitual abode in both Contracting Parties or in neither of them, he shall be deemed to be a resident only of the Contracting Party in which he has the right of abode (in the case of the Hong Kong Special Administrative Region) or Contracting Party of which he is a national (in the case of Thailand);\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 if he has the right of abode in the Hong Kong Special Administrative Region and is also a national of Thailand or if he does not have the right of abode in the Hong Kong Special Administrative Region nor is he a national of Thailand, the competent authorities of the Contracting Parties shall settle the question by mutual agreement.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where by reason of the provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  a person other than an individual is a resident of both Contracting Parties, then the competent authorities of the Contracting Parties shall determine that the person is a resident of a Contracting Party for the purposes of this Agreement by mutual agreement.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 5\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 PERMANENT ESTABLISHMENT\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 For the purposes of this Agreement, the term \u8220??permanent establishment\u8221?? means a fixed place of business through which the business of an enterprise is wholly or partly carried on.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The term \u8220??permanent establishment\u8221?? includes especially:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 a place of management;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 a branch;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 an office;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 a factory;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (e)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 a workshop;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (f)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 a mine, an oil or gas well, a quarry or any other place of extraction of natural resources; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (g)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 a warehouse, in relation to a person providing storage facilities for others.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The term \u8220??permanent establishment\u8221?? also encompasses:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 A building site, a construction, assembly or installation project or supervisory activities in connection therewith, but only if such site, project or activities last more than six months;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 The furnishing of services, including consultancy services, by an enterprise through employees or other personnel engaged by the enterprise for such purpose, but only if activities of that nature continue (for the same or a connected project) within a Contracting Party for a period or periods aggregating more than six months within any twelve-month period.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Notwithstanding the preceding provisions of this Article, the term \u8220??permanent establishment\u8221?? shall be deemed not to include:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the use of facilities solely for the purpose of storage or display of goods or merchandise belonging to the enterprise;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the maintenance of a stock of goods or merchandise belonging to the enterprise solely for the purpose of storage or display;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the maintenance of a stock of goods or merchandise belonging to the enterprise solely for the purpose of processing by another enterprise;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the maintenance of a fixed place of business solely for the purpose of purchasing goods or merchandise, or of collecting information, for the enterprise;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (e)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the maintenance of a fixed place of business solely for the purpose of carrying on, for the enterprise, any other activity of a preparatory or auxiliary character;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (f)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the maintenance of a fixed place of business solely for any combination of the activities mentioned in sub-paragraphs (a) to (e) of this paragraph, provided that the overall activity of the fixed place of business resulting from this combination is of a preparatory or auxiliary character.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Notwithstanding the provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraphs 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 , where a person\u160??\u8212?? other than an agent of an independent status to whom }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 6}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  applies\u160??\u8212?? is acting in a Contracting Party, on behalf of an enterprise of the other Contracting Party, that enterprise shall be deemed to have a permanent establishment in the first-mentioned Contracting Party in respect of any activities which that person undertakes for the enterprise, if such a person:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 has and habitually exercises in a Contracting Party an authority to conclude contracts in the name of the enterprise, unless the activities of such person are limited to those mentioned in }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 paragraph 4}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  which, if exercised through a fixed place of business, would not make this fixed place of business a permanent establishment under the provisions of that paragraph;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 has no such authority, but habitually maintains in the first-mentioned Contracting Party a stock of goods or merchandise belonging to the enterprise from which he regularly delivers on behalf of the enterprise; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 has no such authority, but habitually secures orders in the first-mentioned Contracting Party wholly or almost wholly for the enterprise or for the enterprise and other enterprises which are controlled by it or have a controlling interest in it.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 An enterprise of a Contracting Party shall not be deemed to have a permanent establishment in the other Contracting Party merely because it carries on business in that other Contracting Party through a broker, general commission agent or any other agent of an independent status, provided that such persons are acting in the ordinary course of their business. However, when the activities of such an agent are devoted wholly or almost wholly on behalf of that enterprise, and conditions are made or imposed between that enterprise and the agent in their commercial and financial relations which differ from those which would have been made between independent enterprises, he will not be considered an agent of an independent status within the meaning of this paragraph.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 7.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The fact that a company which is a resident of a Contracting Party controls or is controlled by a company which is a resident of the other Contracting Party, or which carries on business in that other Contracting Party (whether through a permanent establishment or otherwise), shall not of itself constitute either company a permanent establishment of the other.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 6\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 INCOME FROM IMMOVABLE PROPERTY\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Income derived by a resident of a Contracting Party from immovable property (including income from agriculture or forestry) situated in the other Contracting Party may be taxed in that other Contracting Party.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The term \u8220??immovable property\u8221?? shall have the meaning which it has under the laws of the Contracting Party in which the property in question is situated. The term shall in any case include property accessory to immovable property, livestock and equipment used in agriculture, forestry and fishery, rights to which the provisions of general law respecting landed property apply, usufruct of immovable property and rights to variable or fixed payments as consideration for the working of, or the right to explore for or work, mineral deposits, quarries, sources and other natural resources; ships, boats and aircraft shall not be regarded as immovable property.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  shall apply to income derived from the direct use, letting, or use in any other form of immovable property.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraphs 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  shall also apply to the income from immovable property of an enterprise and to income from immovable property used for the performance of independent personal services.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 7\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 BUSINESS PROFITS\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The profits of an enterprise of a Contracting Party shall be taxable only in that Contracting Party unless the enterprise carries on business in the other Contracting Party through a permanent establishment situated therein. If the enterprise carries on business as aforesaid, the profits of the enterprise may be taxed in the other Contracting Party, but only so much of them as is attributable to that permanent establishment.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Subject to the provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 3}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 , where an enterprise of a Contracting Party carries on business in the other Contracting Party through a permanent establishment situated therein, there shall in each Contracting Party be attributed to that permanent establishment the profits which it might be expected to make if it were a distinct and separate enterprise engaged in the same or similar activities under the same or similar conditions and dealing wholly independently with the enterprise of which it is a permanent establishment.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 In determining the profits of a permanent establishment, there shall be allowed as deductions expenses which are incurred for the purposes of the permanent establishment, including executive and general administrative expenses so incurred, whether in the Contracting Party in which the permanent establishment is situated or elsewhere.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Insofar as it has been customary in a Contracting Party to determine the profits to be attributed to a permanent establishment on the basis of an apportionment of the total profits of the enterprise to its various parts, nothing in }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  shall preclude that Contracting Party from determining the profits to be taxed by such an apportionment as may be customary; the method of apportionment adopted shall, however, be such that the result shall be in accordance with the principles contained in this Article.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 No profits shall be attributed to a permanent establishment by reason of the mere purchase by that permanent establishment of goods or merchandise for the enterprise.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 If the information available to the taxation authority of a Contracting Party is inadequate to determine the profits to be attributed to the permanent establishment of an enterprise, nothing in this Article shall affect the application of any law of that Contracting Party relating to the determination of the tax liability of a person provided that that law shall be applied in accordance with the principles of this Article, so far as the information available to the taxation authority permits.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 7.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 For the purposes of the preceding paragraphs, the profits to be attributed to the permanent establishment shall be determined by the same method year by year unless there is good and sufficient reason to the contrary.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 8.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where profits include items of income which are dealt with separately in other Articles of this Agreement, then the provisions of those Articles shall not be affected by the provisions of this Article.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 8\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 SHIPPING AND AIR TRANSPORT\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Income or profits derived by an enterprise of a Contracting Party from the operation of aircraft in international traffic shall be taxable only in that Contracting Party.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Income or profits of an enterprise of a Contracting Party derived in the other Contracting Party from the operation of ships in international traffic may be taxed in the other Contracting Party but the tax so charged shall be reduced by an amount equal to 50 per cent thereof.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraphs 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  shall also apply to income or profits from the participation in a pool, a joint business or an international operating agency.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 9\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 ASSOCIATED ENTERPRISES\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 an enterprise of a Contracting Party participates directly or indirectly in the management, control or capital of an enterprise of the other Contracting Party; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the same persons participate directly or indirectly in the management, control or capital of an enterprise of a Contracting Party and an enterprise of the other Contracting Party,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 and in either case conditions are made or imposed between the two enterprises in their commercial or financial relations which differ from those which would be made between independent enterprises, then any income or profits which would, but for those conditions, have accrued to one of the enterprises, but, by reason of those conditions, have not so accrued, may be included in the income or profits of that enterprise and taxed accordingly.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where a Contracting Party includes in the profits of an enterprise of that Contracting Party \u8212?? and taxes accordingly \u8212?? profits on which an enterprise of the other Contracting Party has been charged to tax in that other Contracting Party and the profits so included are profits which would have accrued to the enterprise of the first-mentioned Contracting Party if the conditions made between the two enterprises had been those which would have been made between independent enterprises, then that other Contracting Party shall make an appropriate adjustment to the amount of the tax charged therein on those profits. In determining such adjustment, due regard shall be had to the other provisions of this Agreement and the competent authorities of the Contracting Parties shall if necessary consult each other.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 10\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 DIVIDENDS\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Dividends paid by a company which is a resident of a Contracting Party to a resident of the other Contracting Party, may be taxed in that other Contracting Party.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 However, such dividends may also be taxed in the Contracting Party of which the company paying the dividends is a resident, and according to the laws of that Contracting Party, but if the beneficial owner of the dividends is a resident of the other Contracting Party, the tax so charged shall not exceed 10 per cent of the gross amount of the dividends.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 This paragraph shall not affect the taxation of the company in respect of the profits out of which the dividends are paid.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The term \u8220??dividends\u8221?? as used in this Article means income from shares, founders\u8217?? shares or other rights, not being debt-claims, participating in profits, as well as income from other corporate rights which is subjected to the same taxation treatment as income from shares by the laws of the Contracting Party of which the company making the distribution is a resident.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraphs 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  shall not apply if the beneficial owner of the dividends, being a resident of a Contracting Party, carries on business in the other Contracting Party of which the company paying the dividends is a resident, through a permanent establishment situated therein, or performs in that other Contracting Party independent personal services from a fixed base situated therein, and the holding in respect of which the dividends are paid is effectively connected with such permanent establishment or fixed base. In such case the provisions of Article 7 or Article 14, as the case may be, shall apply.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where a company which is a resident of a Contracting Party derives income or profits from the other Contracting Party, that other Contracting Party may not impose any tax on the dividends paid by the company, except insofar as such dividends are paid to a resident of that other Contracting Party or insofar as the holding in respect of which the dividends are paid is effectively connected with a permanent establishment or a fixed base situated in that other Contracting Party, nor subject the company\u8217??s undistributed profits to a tax on the company\u8217??s undistributed profits, even if the dividends paid or the undistributed profits consist wholly or partly of income or profits arising in such other Contracting Party.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 11\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 INTEREST\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Interest arising in a Contracting Party and paid to a resident of the other Contracting Party may be taxed in that other Contracting Party.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 However, such interest may also be taxed in the Contracting Party in which it arises, and according to the laws of that Contracting Party, but if the beneficial owner of the interest is a resident of the other Contracting Party, the tax so charged shall not exceed:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 10 per cent of the gross amount of the interest if the interest is beneficially owned by any financial institution or insurance company;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 10 per cent of the gross amount of the interest if the interest is beneficially owned by a resident of the other Contracting Party and is paid with respect to indebtedness arising as a consequence of a sale on credit by a resident of that other Contracting Party of any equipment, merchandise or services, except where the sale was between persons not dealing with each other at arm\u8217??s length; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 15 per cent of the gross amount of the interest in all other cases.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Notwithstanding the provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  of this Article, interest arising in a Contracting Party is exempt from tax in that Contracting Party, if it is paid:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 in the case of the Hong Kong Special Administrative Region,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 to the Government of the Hong Kong Special Administrative Region;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 to the Hong Kong Monetary Authority;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (iii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 to a financial institution appointed by the Government of the Hong Kong Special Administrative Region and mutually agreed upon by the competent authorities of the two Contracting Parties;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 in the case of Thailand,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 to the Government of the Kingdom of Thailand;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 to any local authority;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (iii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 to the Bank of Thailand;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (iv)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 to the Export-Import Bank of Thailand;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (v)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 to a financial institution appointed by the Government of the Kingdom of Thailand and mutually agreed upon by the competent authorities of the two Contracting Parties.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The term \u8220??interest\u8221?? as used in this Article means income from debt-claims of every kind, whether or not secured by mortgage, and whether or not carrying a right to participate in the debtor\u8217??s profits, and in particular, income from government securities and income from bonds or debentures, including premiums and prizes attaching to such securities, bonds or debentures, as well as income treated as income from money lent by the taxation laws of the Contracting Party in which the income arises. Penalty charges for late payment shall not be regarded as interest for the purpose of this Article.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraphs 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  shall not apply if the beneficial owner of the interest, being a resident of a Contracting Party, carries on business in the other Contracting Party in which the interest arises through a permanent establishment situated therein, or performs in that other Contracting Party independent personal services from a fixed base situated therein, and the debt-claim in respect of which the interest is paid is effectively connected with such permanent establishment or fixed base. In such case the provisions of Article 7 or Article 14, as the case may be, shall apply.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Interest shall be deemed to arise in a Contracting Party when the payer is a resident of that Contracting Party. Where, however, the person paying the interest, whether he is a resident of a Contracting Party or not, has in a Contracting Party a permanent establishment or a fixed base in connection with which the indebtedness on which the interest is paid was incurred, and such interest is borne by such permanent establishment or fixed base, then such interest shall be deemed to arise in the Contracting Party in which the permanent establishment or fixed base is situated.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 7.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where, by reason of a special relationship between the payer and the beneficial owner or between both of them and some other person, the amount of the interest, having regard to the debt-claim for which it is paid, exceeds the amount which would have been agreed upon by the payer and the beneficial owner in the absence of such relationship, the provisions of this Article shall apply only to the last-mentioned amount. In such case, the excess part of the payments shall remain taxable according to the laws of each Contracting Party, due regard being had to the other provisions of this Agreement.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 12\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 ROYALTIES\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Royalties arising in a Contracting Party and paid to a resident of the other Contracting Party may be taxed in that other Contracting Party.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 However, such royalties may also be taxed in the Contracting Party in which they arise and according to the laws of that Contracting Party, but if the beneficial owner of the royalties is a resident of the other Contracting Party, the tax so charged shall not exceed:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 5 per cent of the gross amount of the royalties if they are made as a consideration for the use of, or the right to use, any copyright of literary, artistic or scientific work;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 10 per cent of the gross amount of the royalties if they are made as a consideration for the use of, or the right to use, any patent, trademark, design or model, plan, secret formula or process; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 15 per cent of the gross amount of the royalties in all other cases.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The term \u8220??royalties\u8221?? as used in this Article means payments of any kind received as a consideration for the use of, or the right to use, any copyright of literary, artistic or scientific work including cinematograph films, or films or tapes used for radio or television broadcasting, any patent, trademark, design or model, plan, secret formula or process, or for the use of, or the right to use, industrial, commercial, or scientific equipment or for information concerning industrial, commercial or scientific experience.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraphs 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  shall not apply if the beneficial owner of the royalties, being a resident of a Contracting Party, carries on business in the other Contracting Party in which the royalties arise through a permanent establishment situated therein, or performs in that other Contracting Party independent personal services from a fixed base situated therein, and the right or property in respect of which the royalties are paid is effectively connected with such permanent establishment or fixed base. In such case the provisions of Article 7 or Article 14, as the case may be, shall apply.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Royalties shall be deemed to arise in a Contracting Party when the payer is a resident of that Contracting Party. Where, however, the person paying the royalties, whether he is a resident of a Contracting Party or not, has in a Contracting Party a permanent establishment or a fixed base in connection with which the liability to pay the royalties was incurred, and such royalties are borne by such permanent establishment or fixed base, then such royalties shall be deemed to arise in the Contracting Party in which the permanent establishment or fixed base is situated.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where, by reason of a special relationship between the payer and the beneficial owner or between both of them and some other person, the amount of the royalties, having regard to the use, right and information for which they are paid, exceeds the amount which would have been agreed upon by the payer and the beneficial owner in the absence of such relationship, the provisions of this Article shall apply only to the last-mentioned amount. In such case, the excess part of the payments shall remain taxable according to the laws of each Contracting Party, due regard being had to the other provisions of this Agreement.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 13\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 CAPITAL GAINS\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Gains derived by a resident of a Contracting Party from the alienation of immovable property referred to in Article 6 and situated in the other Contracting Party may be taxed in that other Contracting Party.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Gains from the alienation of movable property forming part of the business property of a permanent establishment which an enterprise of a Contracting Party has in the other Contracting Party or of movable property pertaining to a fixed base available to a resident of a Contracting Party in the other Contracting Party for the purpose of performing independent personal services, including such gains from the alienation of such a permanent establishment (alone or with the whole enterprise) or of such a fixed base, may be taxed in that other Contracting Party.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Gains derived by an enterprise of a Contracting Party from the alienation of ships or aircraft operated in international traffic or movable property pertaining to the operation of such ships or aircraft, shall be taxable only in that Contracting Party.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Gains derived by a resident of a Contracting Party from the alienation of shares of a company deriving more than 50 per cent of its asset value directly or indirectly from immovable property situated in the other Contracting Party may be taxed in that other Contracting Party.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Gains from the alienation of any property, other than that referred to in }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraphs 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 , }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 , }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 , shall be taxable only in the Contracting Party of which the alienator is a resident.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 14\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 INDEPENDENT PERSONAL SERVICES\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Income derived by a resident of a Contracting Party in respect of professional services or other independent activities of a similar character shall be taxable only in that Contracting Party except in the following circumstances, when such income may also be taxed in the other Contracting Party:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 if he has a fixed base regularly available to him in the other Contracting Party for the purpose of performing his activities; in that case, only so much of the income as is attributable to that fixed base may be taxed in that other Contracting Party; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 if his stay in the other Contracting Party is for a period or periods amounting to or exceeding in the aggregate 183 days in any twelve-month period commencing or ending in the taxable period concerned; in that case, only so much of the income as is derived from his activities performed in that other Contracting Party may be taxed in that other Contracting Party.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The term \u8220??professional services\u8221?? includes especially independent scientific, literary, artistic, educational or teaching activities as well as the independent activities of physicians, dentists, lawyers, engineers, architects and accountants.\par }}

{\sect \sectd }\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 15\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 DEPENDENT PERSONAL SERVICES\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Subject to the provisions of Articles 16, 18 and 19, salaries, wages and other similar remuneration derived by a resident of a Contracting Party in respect of an employment shall be taxable only in that Contracting Party unless the employment is exercised in the other Contracting Party. If the employment is so exercised, such remuneration as is derived therefrom may be taxed in that other Contracting Party.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Notwithstanding the provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 , remuneration derived by a resident of a Contracting Party in respect of an employment exercised in the other Contracting Party shall be taxable only in the first-mentioned Contracting Party if:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the recipient is present in the other Contracting Party for a period or periods not exceeding in the aggregate 183 days in any twelve-month period commencing or ending in the taxable period concerned, and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the remuneration is paid by, or on behalf of, an employer who is not a resident of the other Contracting Party, and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the remuneration is not borne by a permanent establishment or a fixed base which the employer has in the other Contracting Party.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Notwithstanding the preceding provisions of this Article, remuneration derived in respect of an employment exercised aboard a ship or aircraft operated in international traffic by an enterprise of a Contracting Party shall be taxable only in that Contracting Party.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 16\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 DIRECTORS\u8217?? FEES\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li0\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0 Directors\u8217?? fees and other similar payments derived by a resident of a Contracting Party in his capacity as a member of the board of directors of a company which is a resident of the other Contracting Party may be taxed in that other Contracting Party.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 17\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 ARTISTES AND SPORTSPERSONS\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Notwithstanding the provisions of Articles 14 and 15, income derived by a resident of a Contracting Party as an entertainer, such as a theatre, motion picture, radio or television artiste, or a musician, or as a sportsperson, from his personal activities as such exercised in the other Contracting Party, may be taxed in that other Contracting Party.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where income in respect of personal activities exercised by an entertainer or a sportsperson in his capacity as such accrues not to the entertainer or sportsperson himself but to another person, that income may, notwithstanding the provisions of Articles 7, 14 and 15, be taxed in the Contracting Party in which the activities of the entertainer or sportsperson are exercised.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraphs 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  of this Article shall not apply to remuneration derived from activities performed in a Contracting Party by an entertainer or a sportsperson and paid by the other Contracting Party if the visit to that Contracting Party is substantially supported by public funds of the other Contracting Party including its local authority or statutory body. In such a case the remuneration shall be taxable only in the Contracting Party of which the entertainer or sportsperson is a resident.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 18\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 PENSIONS\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Subject to the provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  of Article 19, pensions (including a lump sum payment) and other similar remuneration paid to a resident of a Contracting Party in consideration of past employment shall be taxable only in that Contracting Party.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Notwithstanding the provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 , pensions (including a lump sum payment) and other payments made under a pension or retirement scheme which is:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 a public scheme which is part of the social security system of a Contracting Party or local authorities thereof; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 an arrangement in which individuals may participate to secure retirement benefits and which is recognised for tax purposes in a Contracting Party,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 shall be taxable only in that Contracting Party.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 19\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 GOVERNMENT SERVICE\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-1200\li1200\tqr\tx960\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Salaries, wages and other similar remuneration, other than a pension, paid by the Government of a Contracting Party or a local authority thereof to an individual in respect of services rendered to that Contracting Party or authority shall be taxable only in that Contracting Party.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 However, such salaries, wages and other remuneration shall be taxable only in the other Contracting Party if the services are rendered in that Contracting Party and the individual is a resident of that Contracting Party who:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 in the case of the Hong Kong Special Administrative Region, has the right of abode therein and in the case of Thailand is a national thereof; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 did not become a resident of that Contracting Party solely for the purpose of rendering the services.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Any pension (including a lump sum payment) paid by, or out of funds created, or contributed to, by the Government of a Contracting Party or a local authority thereof to an individual in respect of services rendered to that Contracting Party or authority shall be taxable only in that Contracting Party.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The provisions of Articles 15, 16 and 18, instead of this Article, shall apply to salaries, wages and other similar remuneration, and to pensions (including a lump sum payment), in respect of services rendered in connection with a business carried on by the Government of a Contracting Party or a local authority thereof.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 20\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 STUDENTS\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li0\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0 Payments which a student or business apprentice who is or was immediately before visiting a Contracting Party a resident of the other Contracting Party and who is present in the first-mentioned Contracting Party solely for the purpose of his education or training receives for the purpose of his maintenance, education or training shall not be taxed in that Contracting Party, provided that such payments arise from sources outside that Contracting Party.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 21\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 OTHER INCOME\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Items of income of a resident of a Contracting Party, wherever arising, not dealt with in the foregoing Articles of this Agreement shall be taxable only in that Contracting Party.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  shall not apply to income, other than income from immovable property as defined in }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  of Article 6, if the recipient of such income, being a resident of a Contracting Party, carries on business in the other Contracting Party through a permanent establishment situated therein, or performs in that other Contracting Party independent personal services from a fixed base situated therein, and a right or property in respect of which the income is paid is effectively connected with such permanent establishment or fixed base. In such case, the provisions of Article 7 or Article 14, as the case may be, shall apply.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Notwithstanding the provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraphs 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 , items of income of a resident of a Contracting Party not dealt with in the foregoing Articles of this Agreement and arising in the other Contracting Party may also be taxed in that other Contracting Party.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 22\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 METHODS FOR ELIMINATION OF DOUBLE TAXATION\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Subject to the provisions of the laws of the Hong Kong Special Administrative Region relating to the allowance of a credit against Hong Kong Special Administrative Region tax of tax paid in a jurisdiction outside the Hong Kong Special Administrative Region (which shall not affect the general principle of this Article), Thai tax paid under the laws of Thailand and in accordance with this Agreement, whether directly or by deduction, in respect of income derived by a person who is a resident of the Hong Kong Special Administrative Region from sources in Thailand, shall be allowed as a credit against Hong Kong Special Administrative Region tax payable in respect of that income, provided that the credit so allowed does not exceed the amount of Hong Kong Special Administrative Region tax computed in respect of that income in accordance with the tax laws of the Hong Kong Special Administrative Region.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Subject to the laws of Thailand regarding the allowance as a credit against Thai tax of tax paid in any country other than Thailand, Hong Kong Special Administrative Region tax paid in respect of income derived from Hong Kong Special Administrative Region shall be allowed as a credit against Thai tax paid in respect of that income. The amount of credit shall not, however, exceed that portion of Thai tax which is appropriate to that income.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 For the purpose of allowance as a credit in a Contracting Party the tax paid in the other Contracting Party shall be deemed to include the tax which is otherwise payable in that other Contracting Party but has been reduced or waived in accordance with special incentive laws designed to promote economic development in that other Contracting Party. The provisions of this paragraph shall only apply for a period of 7 years from the day on which this Agreement comes into effect according to }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  of Article 27. The periods may be extended by mutual agreement between the competent authorities.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 23\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 NON-DISCRIMINATION\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Persons who, in the case of the Hong Kong Special Administrative Region, have the right of abode or are incorporated or otherwise constituted therein, and in the case of Thailand, are nationals of Thailand shall not be subjected in the other Contracting Party to any taxation or any requirement connected therewith, which is other or more burdensome than the taxation and connected requirements to which persons who have the right of abode or are incorporated or otherwise constituted in that other Contracting Party (where that other Contracting Party is the Hong Kong Special Administrative Region) or nationals of that other Contracting Party (where that other Contracting Party is Thailand) in the same circumstances, in particular with respect to residence, are or may be subjected.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The taxation on a permanent establishment which an enterprise of a Contracting Party has in the other Contracting Party shall not be less favourably levied in that other Contracting Party than the taxation levied on enterprises of that other Contracting Party carrying on the same activities.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Except where the provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  of Article 9, }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 7}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  of Article 11, or }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 6}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  of Article 12 apply, interest, royalties and other disbursements paid by an enterprise of a Contracting Party to a resident of the other Contracting Party shall, for the purpose of determining the taxable profits of such enterprise, be deductible under the same conditions as if they had been paid to a resident of the first-mentioned Contracting Party.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Enterprises of a Contracting Party, the capital of which is wholly or partly owned or controlled, directly or indirectly, by one or more residents of the other Contracting Party, shall not be subjected in the first-mentioned Contracting Party to any taxation or any requirement connected therewith which is other or more burdensome than the taxation and connected requirements to which other similar enterprises of the first-mentioned Contracting Party are or may be subjected.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The provisions of this Article shall not be construed as obliging a Contracting Party to grant to residents of the other Contracting Party any personal allowances, reliefs and reductions for taxation purposes on account of civil status or family responsibilities which it grants to its own residents.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The provisions of this Article shall only apply to the taxes which are the subject of this Agreement.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 24\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 MUTUAL AGREEMENT PROCEDURE\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where a person considers that the actions of one or both of the Contracting Parties result or will result for him in taxation not in accordance with the provisions of this Agreement, he may, irrespective of the remedies provided by the domestic laws of those Contracting Parties, present his case to the competent authority of the Contracting Party of which he is a resident or if his case comes under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  of Article 23, to that of the Contracting Party in which he has the right of abode or is incorporated or otherwise constituted (in the case of the Hong Kong Special Administrative Region) or of which he is a national (in the case of Thailand). The case must be presented within three years from the first notification of the action resulting in taxation not in accordance with the provision of this Agreement.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The competent authority shall endeavour, if the objection appears to it to be justified and if it is not itself able to arrive at a satisfactory solution, to resolve the case by mutual agreement with the competent authority of the other Contracting Party, with a view to the avoidance of taxation which is not in accordance with this Agreement. Any agreement reached shall be implemented notwithstanding any time limits in the domestic laws of the Contracting Parties.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The competent authorities of the Contracting Parties shall endeavour to resolve by mutual agreement any difficulties or doubts arising as to the interpretation or application of this Agreement. They may also consult together for the elimination of double taxation in cases not provided for in this Agreement.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The competent authorities of the Contracting Parties may communicate with each other directly for the purposes of giving effect to the provisions of this Agreement.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 25\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 EXCHANGE OF INFORMATION\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The competent authorities of the Contracting Parties shall exchange such information as is necessary for carrying out the provisions of this Agreement or of the domestic laws of the Contracting Parties concerning taxes covered by this Agreement insofar as the taxation thereunder is not contrary to this Agreement. Any information received by a Contracting Party shall be treated as secret in the same manner as information obtained under the domestic laws of that Contracting Party and shall be disclosed only to persons or authorities (including courts and administrative bodies) concerned with the assessment or collection of, the enforcement or prosecution in respect of, or the determination of appeals in relation to, the taxes covered by this Agreement. Such persons or authorities shall use the information only for such purposes. They may disclose the information in public court proceedings or in judicial decisions, including, in the case of the Hong Kong Special Administrative Region, the decisions of the Board of Review. Information may not be disclosed to any third jurisdiction for any purpose without the consent of the Contracting Party originally furnishing the information.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 In no case shall the provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  be construed so as to impose on a Contracting Party the obligation:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 to carry out administrative measures at variance with the laws and the administrative practice of that or of the other Contracting Party;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 to supply information which is not obtainable under the laws or in the normal course of the administration of that or of the other Contracting Party;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 to supply information which would disclose any trade, business, industrial, commercial or professional secret or trade process, or information, the disclosure of which would be contrary to public policy (ordre public).\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 26\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 MISCELLANEOUS PROVISIONS\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Nothing in this Agreement shall prejudice the right of each Contracting Party to apply its domestic laws and measures concerning tax avoidance, whether or not described as such.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Nothing in this Agreement shall affect the fiscal privileges of persons entitled to such fiscal privileges under the general rules of international law or under the provisions of special agreements.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Artic