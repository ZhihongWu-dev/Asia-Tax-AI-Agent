{\sect \sectd }\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 any stock exchange established by the Stock Exchange of Hong Kong Limited;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 any stock exchange established by a Financial Instruments Exchange or an approved-type financial instruments firms association under the Financial Instruments and Exchange Law (Law No. 25 of 1948) of Japan; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 any other stock exchange which the competent authorities of the Contracting Parties agree to recognise for the purposes of that paragraph.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 With reference to }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  of Article 17 of the Agreement, it is understood that the term \u8220??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 pensions and other similar remuneration}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u8221?? includes pensions and other similar remuneration paid in consideration of past employment or self-employment and social security pensions.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 With reference to }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 5}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  of Article 24 of the Agreement:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 The competent authorities shall by mutual agreement establish a procedure which ensures that, except where actions or inaction of a person directly affected by the case hinder the resolution of the case or where the competent authorities and that person agree otherwise, an arbitration decision will be implemented within two years from a request for arbitration as referred to in }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 paragraph 5}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  of Article 24 of the Agreement.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 An arbitration panel shall be established in accordance with the following rules:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 An arbitration panel shall consist of three arbitrators with expertise or experience in international tax matters.\par }}

{\sect \sectd }\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 Each competent authority shall appoint one arbitrator. The two arbitrators appointed by the competent authorities shall appoint the third arbitrator who serves as the chair of the arbitration panel in accordance with the procedures agreed by the competent authorities.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (iii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 All arbitrators shall not be employees of the tax authorities of either of the Contracting Parties, nor shall they have previously dealt with the case presented pursuant to }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 paragraph 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  of Article 24 of the Agreement in any capacity.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (iv)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 The competent authorities shall ensure that all arbitrators and their staff agree, in statements sent to each competent authority, prior to their acting in the arbitration proceedings, to comply with the same confidentiality and non-disclosure obligations provided for in }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 paragraph 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  of Article 25 of the Agreement and under the applicable domestic laws of the Contracting Parties.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (v)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 Each competent authority shall bear the cost of its appointed arbitrator and its own expenses related to its own participation in the arbitration proceedings. The cost of the chair of the arbitration panel and other expenses associated with the conduct of the proceedings shall be borne by the competent authorities in equal shares.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 The competent authorities shall provide the information necessary for the making of the arbitration decision to all arbitrators and their staff without undue delay.\par }}

{\sect \sectd }\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 An arbitration decision shall be final, unless that decision is found to be unenforceable by the courts of one of the Contracting Parties due to a violation of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 paragraph 5}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  of Article 24 of the Agreement, of this paragraph or of any procedural rule determined in accordance with this paragraph that may reasonably have affected the decision. If the decision is found to be unenforceable due to such violation, the decision shall be considered not to have been made.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (e)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 An arbitration decision shall have no formal precedential value.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (f)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Where, at any time after a request for arbitration has been made and before the arbitration panel has delivered a decision to the competent authorities and the person who made the request for arbitration, the competent authorities have solved all the unresolved issues submitted to the arbitration, the case shall be considered as solved pursuant to }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 paragraph 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  of Article 24 of the Agreement and no arbitration decision shall be provided.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 7.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 With reference to }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  of Article 25 of the Agreement, a Contracting Party is not obliged to exchange information concerning taxes other than those covered by Article 2 of the Agreement for the purposes of carrying out the provisions of the Agreement or of the administration or enforcement of the domestic laws of the other Contracting Party until the Governments of the Contracting Parties agree, through an exchange of notes, to exchange information concerning those taxes. Such agreement shall enter into force after the completion of procedures required by the respective laws of the Contracting Parties for entry into force of the agreement.\par }}

