persub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Notwithstanding the preceding provisions of this Article, the term \u8220??permanent establishment\u8221?? shall be deemed not to include: \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the use of facilities solely for the purpose of storage or display of goods or merchandise belonging to the enterprise; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the maintenance of a stock of goods or merchandise belonging to the enterprise solely for the purpose of storage or display; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the maintenance of a stock of goods or merchandise belonging to the enterprise solely for the purpose of processing by another enterprise; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the maintenance of a fixed place of business solely for the purpose of purchasing goods or merchandise or of collecting information, for the enterprise; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (e)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the maintenance of a fixed place of business solely for the purpose of carrying on, for the enterprise, any other activity of a preparatory or auxiliary character; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (f)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the maintenance of a fixed place of business solely for any combination of activities mentioned in sub-paragraphs (a) to (e), provided that the overall activity of the fixed place of business resulting from this combination is of a preparatory or auxiliary character. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Notwithstanding the provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraphs 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 , where a person \u8211?? other than an agent of an independent status to whom }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 6}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  applies \u8211?? is acting in a Contracting Party on behalf of an enterprise of the other Contracting Party, that enterprise shall be deemed to have a permanent establishment in the first-mentioned Contracting Party in respect of any activities which that person undertakes for the enterprise, if such a person: \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 has, and habitually exercises, in the first-mentioned Contracting Party an authority to conclude contracts in the name of the enterprise, unless the activities of such person are limited to those mentioned in }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 paragraph 4}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  which, if exercised through a fixed place of business, would not make this fixed place of business a permanent establishment under the provisions of that paragraph, or \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 has no such authority, but habitually maintains in the first-mentioned Party a stock of goods or merchandise from which he regularly delivers goods or merchandise on behalf of the enterprise. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 An enterprise shall not be deemed to have a permanent establishment in a Contracting Party merely because it carries on business in that Party through a broker, general commission agent or any other agent of an independent status, provided that such persons are acting in the ordinary course of their business. However, when the activities of such an agent are devoted wholly or almost wholly on behalf of that enterprise, and conditions are made or imposed between that enterprise and the agent in their commercial and financial relations which differ from those which would have been made between independent enterprises, he will not be considered an agent of an independent status within the meaning of this paragraph. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 7.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The fact that a company which is a resident of a Contracting Party controls or is controlled by a company which is a resident of the other Contracting Party, or which carries on business in that other Party (whether through a permanent establishment or otherwise), shall not of itself constitute either company a permanent establishment of the other. \par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 6\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Income from Immovable Property\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Income derived by a resident of a Contracting Party from immovable property (including income from agriculture or forestry) situated in the other Contracting Party may be taxed in that other Party. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The term \u8220??immovable property\u8221?? shall have the meaning which it has under the law of the Contracting Party in which the property in question is situated. The term shall in any case include property accessory to immovable property, livestock and equipment used in agriculture and forestry, rights to which the provisions of general law respecting landed property apply, usufruct of immovable property and rights to variable or fixed payments as consideration for the working of, or the right to work, mineral deposits, quarries, sources and other natural resources; ships, boats and aircraft shall not be regarded as immovable property. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Any property or right referred to in }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  shall be regarded as situated where the land, standing timber, mineral deposits, quarries, sources or natural resources, as the case may be, are situated or where the working may take place. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  shall apply to income derived from the direct use, letting, or use in any other form of immovable property. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraphs 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  shall also apply to the income from immovable property of an enterprise. \par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 7\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Business Profits\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The profits of an enterprise of a Contracting Party shall be taxable only in that Party unless the enterprise carries on business in the other Contracting Party through a permanent establishment situated therein. If the enterprise carries on business as aforesaid, the profits of the enterprise may be taxed in the other Party, but only so much of them as is attributable to that permanent establishment. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Subject to the provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 3}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 , where an enterprise of a Contracting Party carries on business in the other Contracting Party through a permanent establishment situated therein, there shall in each Contracting Party be attributed to that permanent establishment the profits which it might be expected to make if it were a distinct and separate enterprise engaged in the same or similar activities under the same or similar conditions and dealing wholly independently with the enterprise of which it is a permanent establishment. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 In determining the profits of a permanent establishment, there shall be allowed as deductions expenses which are incurred for the purposes of the permanent establishment, including executive and general administrative expenses so incurred, whether in the Party in which the permanent establishment is situated or elsewhere, taking into consideration any applicable law or regulations. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Insofar as it has been customary in a Contracting Party to determine the profits to be attributed to a permanent establishment on the basis of an apportionment of the total profits of the enterprise to its various parts, or on the basis of such other method as may be prescribed by the laws of that Party, nothing in }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  shall preclude that Contracting Party from determining the profits to be taxed by such apportionment or other method; the method adopted shall, however, be such that the result shall be in accordance with the principles contained in this Article. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 No profits shall be attributed to a permanent establishment by reason of the mere purchase by that permanent establishment of goods or merchandise for the enterprise. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 For the purposes of the preceding paragraphs, the profits to be attributed to the permanent establishment shall be determined by the same method year by year unless there is good and sufficient reason to the contrary. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 7.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where profits include items of income which are dealt with separately in other Articles of this Agreement, then the provisions of those Articles shall not be affected by the provisions of this Article. \par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 8\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Shipping and Air Transport\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Profits of an enterprise of a Contracting Party from the operation of ships or aircraft in international traffic shall be taxable only in that Party. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  shall also apply to profits from the participation in a pool, a joint business or an international operating agency. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 For the purposes of this Article, profits from the operation of ships or aircraft in international traffic shall include in particular: \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 revenues and gross receipts from the operation of ships or aircraft for the transport of persons, livestock, goods, mail or merchandise in international traffic including: \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 income derived from the lease of ships or aircraft on a bareboat charter basis where such lease is incidental to the operation of ships or aircraft in international traffic; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 income derived from the sale of tickets and the provision of services connected with such transport whether for the enterprise itself or for any other enterprise, provided that in the case of provision of services, such provision is incidental to the operation of ships or aircraft in international traffic; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 interest and income derived from deposits with financial institutions, bonds, shares, stocks and other debentures from funds directly connected with the operation of ships or aircraft in international traffic; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 profits from the lease of containers by the enterprise, when such lease is incidental to the operation of ships or aircraft in international traffic. \par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 9\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Associated Enterprises\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where: \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 an enterprise of a Contracting Party participates directly or indirectly in the management, control or capital of an enterprise of the other Contracting Party, or \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the same persons participate directly or indirectly in the management, control or capital of an enterprise of a Contracting Party and an enterprise of the other Contracting Party, \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 and in either case conditions are made or imposed between the two enterprises in their commercial or financial relations which differ from those which would be made between independent enterprises, then any profits which would, but for those conditions, have accrued to one of the enterprises, but, by reason of those conditions, have not so accrued, may be included in the profits of that enterprise and taxed accordingly. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where a Contracting Party includes in the profits of an enterprise of that Party \u8211?? and taxes accordingly \u8211?? profits on which an enterprise of the other Contracting Party has been charged to tax in that other Party and the profits so included are profits which would have accrued to the enterprise of the first-mentioned Party if the conditions made between the two enterprises had been those which would have been made between independent enterprises, then that other Party shall make an appropriate adjustment to the amount of the tax charged therein on those profits. In determining such adjustment, due regard shall be had to the other provisions of this Agreement and for this purpose the competent authorities of the Contracting Parties shall if necessary consult each other. \par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 10\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Dividends\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Dividends paid by a company which is a resident of a Contracting Party to a resident of the other Contracting Party may be taxed in that other Party. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 However, such dividends may also be taxed in the Contracting Party of which the company paying the dividends is a resident and according to the laws of that Party, but if the beneficial owner of the dividends is a resident of the other Contracting Party, the tax so charged shall not exceed: \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 zero per cent of the gross amount of the dividends if the beneficial owner is the Government or local governments of that other Contracting Party or any of its institutions or other entity wholly-owned directly by the Government or local governments of that other Contracting Party; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 five per cent of the gross amount of the dividends in all other cases. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The competent authorities of the Contracting Parties shall by mutual agreement settle the mode of application of these limitations. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 This paragraph shall not affect the taxation of the company in respect of the profits out of which the dividends are paid. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The term \u8220??dividends\u8221?? as used in this Article means income from shares, \u8220??jouissance\u8221?? shares or \u8220??jouissance\u8221?? rights, mining shares, founders\u8217?? shares or other rights, not being debt-claims, participating in profits, as well as income from other corporate rights which is subjected to the same taxation treatment as income from shares by the laws of the Party of which the company making the distribution is a resident. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraphs 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  shall not apply if the beneficial owner of the dividends, being a resident of a Contracting Party, carries on business in the other Contracting Party of which the company paying the dividends is a resident through a permanent establishment situated therein and the holding in respect of which the dividends are paid is effectively connected with such permanent establishment. In such case the provisions of Article 7 shall apply. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where a company which is a resident of a Contracting Party derives profits or income from the other Contracting Party, that other Party may not impose any tax on the dividends paid by the company, except insofar as such dividends are paid to a resident of that other Party or insofar as the holding in respect of which the dividends are paid is effectively connected with a permanent establishment situated in that other Party, nor subject the company\u8217??s undistributed profits to a tax on the company\u8217??s undistributed profits, even if the dividends paid or the undistributed profits consist wholly or partly of profits or income arising in such other Party. \par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 11\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Interest\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Interest arising in a Contracting Party and paid to a resident of the other Contracting Party may be taxed in that other Party. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 However, such interest may also be taxed in the Contracting Party in which it arises and according to the laws of that Party, but if the beneficial owner of the interest is a resident of the other Contracting Party, the tax so charged shall not exceed five per cent of the gross amount of the interest. The competent authorities of the Contracting Parties shall by mutual agreement settle the mode of application of this limitation. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Notwithstanding the provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  of this Article, interest arising in a Contracting Party is exempt from tax in that Party, if it is paid to: \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 in the case of the Hong Kong Special Administrative Region, \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the Government of the Hong Kong Special Administrative Region; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the Hong Kong Monetary Authority; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (iii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 any institution set up by the Government of the Hong Kong Special Administrative Region under statutory law such as a corporation, fund, authority, foundation, agency or other similar entity; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (iv)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 any entity established in the Hong Kong Special Administrative Region all the capital of which has been provided by the Government of the Hong Kong Special Administrative Region or any institution as defined in subparagraph }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)(iii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 paragraph 3}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  of this Article; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 in the case of the United Arab Emirates, \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the Central Bank of the U.A.E.; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the Abu Dhabi Investment Authority; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (iii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the Abu Dhabi Investment Council; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (iv)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the U.A.E. Investment Authority; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (v)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the Dubai Government Investment Corporation; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (vi)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 any institution set up by the Government of the United Arab Emirates or local governments under statutory law such as a corporation, fund, authority, foundation, agency or other similar entity; \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (vii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 any entity established in the United Arab Emirates all the capital of which has been provided by the Government of the United Arab Emirates or local governments or any institution as defined in subparagraph }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)(vi)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 paragraph 3}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  of this Article. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The term \u8220??interest\u8221?? as used in this Article means income from debt-claims of every kind, whether or not secured by mortgage and whether or not carrying a right to participate in the debtor\u8217??s profits, and in particular, income from government securities and income from bonds or debentures, including premiums and prizes attaching to such securities, bonds or debentures. Penalty charges for late payment shall not be regarded as interest for the purpose of this Article. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraphs 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 , }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  shall not apply if the beneficial owner of the interest, being a resident of a Contracting Party, carries on business in the other Contracting Party in which the interest arises through a permanent establishment situated therein and the debt-claim in respect of which the interest is paid is effectively connected with such permanent establishment. In such case the provisions of Article 7 shall apply. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Interest shall be deemed to arise in a Contracting Party when the payer is a resident of that Party. Where, however, the person paying the interest, whether he is a resident of a Contracting Party or not, has in a Contracting Party a permanent establishment in connection with which the indebtedness on which the interest is paid was incurred, and such interest is borne by such permanent establishment, then such interest shall be deemed to arise in the Party in which the permanent establishment is situated. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 7.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where, by reason of a special relationship between the payer and the beneficial owner or between both of them and some other person, the amount of the interest exceeds, for whatever reasons, the amount which would have been agreed upon by the payer and the beneficial owner in the absence of such relationship, the provisions of this Article shall apply only to the last-mentioned amount. In such case, the excess part of the payments shall remain taxable according to the laws of each Contracting Party, due regard being had to the other provisions of this Agreement. \par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 12\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Royalties\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Royalties arising in a Contracting Party and paid to a resident of the other Contracting Party may be taxed in that other Party. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 However, such royalties may also be taxed in the Contracting Party in which they arise and according to the laws of that Party, but if the beneficial owner of the royalties is a resident of the other Contracting Party, the tax so charged shall not exceed five per cent of the gross amount of the royalties. The competent authorities of the Contracting Parties shall by mutual agreement settle the mode of application of this limitation. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The term \u8220??royalties\u8221?? as used in this Article means payments of any kind received as a consideration for the use of, or the right to use, any copyright of literary, artistic or scientific work including cinematograph films, or films or tapes used for radio or television broadcasting, any patent, trade mark, design or model, plan, secret formula or process, or for the use of, or the right to use, industrial, commercial or scientific equipment or for information concerning industrial, commercial or scientific experience.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraphs 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  shall not apply if the beneficial owner of the royalties, being a resident of a Contracting Party, carries on business in the other Contracting Party in which the royalties arise through a permanent establishment situated therein and the right or property in respect of which the royalties are paid is effectively connected with such permanent establishment. In such case the provisions of Article 7 shall apply. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Royalties shall be deemed to arise in a Contracting Party when the payer is a resident of that Party. Where, however, the person paying the royalties, whether he is a resident of a Contracting Party or not, has in a Contracting Party a permanent establishment in connection with which the liability to pay the royalties was incurred, and such royalties are borne by such permanent establishment, then such royalties shall be deemed to arise in the Party in which the permanent establishment is situated. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where, by reason of a special relationship between the payer and the beneficial owner or between both of them and some other person, the amount of the royalties exceeds, for whatever reasons, the amount which would have been agreed upon by the payer and the beneficial owner in the absence of such relationship, the provisions of this Article shall apply only to the last-mentioned amount. In such case, the excess part of the payments shall remain taxable according to the laws of each Contracting Party, due regard being had to the other provisions of this Agreement. \par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 13\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Capital Gains\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Gains derived by a resident of a Contracting Party from the alienation of immovable property referred to in Article 6 and situated in the other Contracting Party may be taxed in that other Party. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Gains from the alienation of movable property forming part of the business property of a permanent establishment which an enterprise of a Contracting Party has in the other Contracting Party, including such gains from the alienation of such a permanent establishment (alone or with the whole enterprise), may be taxed in that other Party. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Gains derived by an enterprise of a Contracting Party from the alienation of ships or aircraft operated in international traffic or movable property pertaining to the operation of such ships or aircraft shall be taxable only in that Party. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Gains derived by a resident of a Contracting Party from the alienation of shares of a company deriving more than 50 per cent of its asset value directly or indirectly from immovable property situated in the other Contracting Party may be taxed in that other Party. However, this paragraph does not apply to gains derived from the alienation of shares: \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 quoted on such stock exchange as may be agreed between the Parties; or \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 alienated or exchanged in the framework of a reorganisation of a company, a merger, a scission or a similar operation; or \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 in a company deriving more than 50 per cent of its asset value from immovable property in which it carries on its business. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Gains from the alienation of any property, other than that referred to in }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraphs 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 , }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 , }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  shall be taxable only in the Contracting Party of which the alienator is a resident. \par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 14\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Income from Employment\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Subject to the provisions of Articles 15, 17 and 18, salaries, wages and other similar remuneration derived by a resident of a Contracting Party in respect of an employment shall be taxable only in that Party unless the employment is exercised in the other Contracting Party. If the employment is so exercised, such remuneration as is derived therefrom may be taxed in that other Party. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Notwithstanding the provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 , remuneration derived by a resident of a Contracting Party in respect of an employment exercised in the other Contracting Party shall be taxable only in the first-mentioned Party if: \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the recipient is present in the other Party for a period or periods not exceeding in the aggregate 183 days in any twelve month period commencing or ending in the taxable period concerned, and \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the remuneration is paid by, or on behalf of, an employer who is not a resident of the other Party, and \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the remuneration is not borne by a permanent establishment which the employer has in the other Party. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Notwithstanding the preceding provisions of this Article, remuneration derived in respect of an employment exercised aboard a ship or aircraft operated in international traffic by an enterprise of a Contracting Party shall be taxable only in that Party. \par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 15\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Directors\u8217?? Fees\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li0\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li0\cf1 \f0 Directors\u8217?? fees and other similar payments derived by a resident of a Contracting Party in his capacity as a member of the board of directors of a company which is a resident of the other Contracting Party may be taxed in that other Party. \par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 16\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Artistes and Sportsmen\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Notwithstanding the provisions of Articles 7 and 14, income derived by a resident of a Contracting Party as an entertainer, such as a theatre, motion picture, radio or television artiste, or a musician, or as a sportsman, from his personal activities as such exercised in the other Contracting Party, may be taxed in that other Party. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where income in respect of personal activities exercised by an entertainer or a sportsman in his capacity as such accrues not to the entertainer or sportsman himself but to another person, that income may, notwithstanding the provisions of Articles 7 and 14, be taxed in the Contracting Party in which the activities of the entertainer or sportsman are exercised. \par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 17\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Pensions\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Subject to the provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  of Article 18, pensions and other similar remuneration (including a lump sum payment) paid to a resident of a Contracting Party in consideration of past employment or self-employment shall be taxable only in that Party. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Notwithstanding the provisions of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 paragraph 1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 , pensions and other similar remuneration (including a lump sum payment) made under a pension or retirement scheme which is: \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 a public scheme which is part of the social security system of a Contracting Party; or \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 a scheme in which individuals may participate to secure retirement benefits and which is recognised for tax purposes in a Contracting Party, \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qj\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qj\qj\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 shall be taxable only in that Contracting Party. \par }}\pard\plain\nosnaplinegrid\b\i0\fs22\qc\sb240\sa80\keepn\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 \u160??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Article 18\par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs12\qc\sb0\sa0\sl120{{\b0\i0\nosupersub\nosupersub\fs12\qc\qc\cf1 \f0  \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li0\sl260{{\b\i0\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 Government Service\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-1200\l