\pard\plain \ltrpar\ql \li0\ri0\nowidctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1779345 \rtlch\fcs1 \af0\afs24\alang1025 \ltrch\fcs0 \fs24\lang1033\langfe1033\kerning2\loch\af0\hich\af0\dbch\af14\cgrid\langnp1033\langfenp1033 {\*\latentstyles\lsdstimax267\lsdlockeddef0\lsdsemihiddendef1\lsdunhideuseddef1\lsdqformatdef0\lsdprioritydef99{\lsdlockedexcept \lsdsemihidden0 \lsdunhideused0 \lsdqformat1 \lsdpriority0 \lsdlocked0 Normal;}}\pard\plain\nosnaplinegrid\b\i0\fs22\qj\sb240\sa80\keepn\fi-720\li720\tx960\sl260{{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 50AAJ.}{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Interpretation: }{\b\i\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 potential advantage}{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  in relation to tax\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 An actual provision confers a potential advantage in relation to Hong Kong tax or foreign tax on a person if, disregarding this Division, making or imposing the actual provision, instead of the arm\u8217??s length provision, would in relation to Hong Kong tax or foreign tax (as the case requires) have either or both of the following effects\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 a smaller amount would be taken to be the amount of the person\u8217??s income;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 a larger amount would be taken to be the amount of the person\u8217??s loss.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Despite subsection (1), an actual provision made or imposed as between 2 persons is not taken to confer a potential advantage in relation to Hong Kong tax on either of the affected persons if\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the domestic nature condition is met as provided for in subsection (3);\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 either the no actual tax difference condition is met as provided for in subsection (5), or the non-business loan condition is met as provided for in subsection (6); and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the actual provision does not, under subsection (7), have a tax avoidance purpose.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (3)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 The domestic nature condition is met\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 if the actual provision is made or imposed in connection with each affected person\u8217??s trade, profession or business carried on in Hong Kong; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 if\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 the actual provision is made or imposed in connection with either affected person\u8217??s trade, profession or business carried on in Hong Kong; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 the other affected person is resident for tax purposes in Hong Kong and the provision is not made or imposed in connection with that other person\u8217??s trade, profession or business.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (4)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 For the purposes of subsection (3), a trade, profession or business is not regarded as being carried on in Hong Kong by an affected person only because a sum received or receivable by or accrued to the person is deemed under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 15(1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  to be a receipt arising in or derived from Hong Kong from a trade, profession or business carried on in Hong Kong.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (5)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 The no actual tax difference condition is met if\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 each affected person\u8217??s income arising from the relevant activities is chargeable to Hong Kong tax or each affected person\u8217??s loss so arising is allowable for the purposes of Hong Kong tax; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 no concession or exemption for Hong Kong tax applies to any affected person\u8217??s income or loss arising from the relevant activities.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (6)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 The non-business loan condition is met if the actual provision relates to lending money otherwise than in the ordinary course of a business of lending money or an intra-group financing business (as defined by }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 16(3)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ).\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (7)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 For the purposes of this section, an actual provision has a tax avoidance purpose if the Commissioner is satisfied that the main purpose, or one of the main purposes, of the provision is to utilize a loss sustained by an affected person to avoid, postpone or reduce any liability, whether of the other affected person or any other person, to Hong Kong tax.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (8)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 In this section\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-480\li1200\sl260{{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 relevant activities}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u26377??\u38364??\u27963??\u21205??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ) has the meaning given by }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 50AAL}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 .\par }}
