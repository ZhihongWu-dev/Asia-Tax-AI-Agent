\pard\plain \ltrpar\ql \li0\ri0\nowidctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1779345 \rtlch\fcs1 \af0\afs24\alang1025 \ltrch\fcs0 \fs24\lang1033\langfe1033\kerning2\loch\af0\hich\af0\dbch\af14\cgrid\langnp1033\langfenp1033 {\*\latentstyles\lsdstimax267\lsdlockeddef0\lsdsemihiddendef1\lsdunhideuseddef1\lsdqformatdef0\lsdprioritydef99{\lsdlockedexcept \lsdsemihidden0 \lsdunhideused0 \lsdqformat1 \lsdpriority0 \lsdlocked0 Normal;}}\pard\plain\nosnaplinegrid\b\i0\fs22\qj\sb240\sa80\keepn\fi-720\li720\tx960\sl260{{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 77A.}{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Refusal of clearance to ships and aircraft where tax is in default\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 In addition to any other powers of collection and recovery provided by this Ordinance, where a}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 person has been charged to tax in respect of his profits from the business of shipowner or charterer or aircraft owner or charterer and such tax is in default and whether such person has been assessed directly or in the name of some other person, the Commissioner, with the prior approval of the Chief Secretary for Administration, may issue to the Director of Marine, the Director-General of Civil Aviation or other authority by whom clearance may be granted, a certificate containing the name or names of the said person and the particulars of the tax in default.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 On receipt of such certificate the Director of Marine, the Director-General of Civil Aviation, or other authority, shall be empowered and is hereby required to refuse clearance from any port, aerodrome or airport or place within Hong Kong to any ship or aircraft owned wholly or partly or chartered by such person until the said tax has been paid or until security for payment has been given to the satisfaction of the Commissioner.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 7 of 1986 s. 12}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (3)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 No civil or criminal proceedings shall be instituted or maintained against the Government, the Chief Secretary for Administration, the Commissioner, the Director of Marine, the Director-General of Civil Aviation or other authority, in respect of a refusal of clearance under this section, nor shall the fact that a ship or aircraft is detained under this section affect the liability of the owner, charterer or agent to harbour, airport or other dues and charges for the period of detention.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 19 of 1996 s. 15}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i\fs22\qr\sb0\sa80\li720\sl260{{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 49 of 1956 s. 58}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 . Amended }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 L.N. 362 of 1997}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 L.N. 326 of 2000}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 )\par }}
