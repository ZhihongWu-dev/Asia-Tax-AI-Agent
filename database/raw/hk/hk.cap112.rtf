\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 section 3}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0  of the Jul-2023 Administrative Guidance; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 the specified OECD GloBE rules guidance in\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 paragraphs 43 to 43}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 .7 of Chapter 5 of the 2023 Commentary; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 section 3}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0  of the Jul-2023 Administrative Guidance.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??5.3.5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The computation of carrying value of eligible tangible assets for purposes of Article 5.3.4 shall be based on the average of the carrying value (net of accumulated depreciation, amortisation, impairment losses or depletion and including any amount attributable to capitalisation of payroll expense) at the beginning and ending of the reporting fiscal year as recorded for the purposes of preparing the consolidated financial statements of the ultimate parent entity.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Note\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 In relation to Article 5.3.5, see\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 the specified OECD GloBE rules guidance in }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 paragraph 52}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0  of Chapter 5 of the 2023 Commentary; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 the specified OECD GloBE rules guidance in }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 paragraph 49}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0  of Chapter 5 of the 2023 Commentary.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??5.3.6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 For purposes of Articles 5.3.3 and 5.3.4, the eligible payroll costs and eligible tangible assets of a constituent entity that is a permanent establishment are those included in its separate financial accounts as determined by Article 3.4.1 and adjusted in accordance with Article 3.4.2, provided that the eligible employees and eligible tangible assets are located in the jurisdiction where the permanent establishment is located. The eligible payroll costs and eligible tangible assets of a permanent establishment are not taken into account for the eligible payroll costs and eligible tangible assets of the main entity. The eligible payroll costs and eligible tangible assets of a permanent establishment whose income has been wholly or partly excluded in accordance with Articles 3.5.3 and 7.1.4 are excluded from the substance-based income exclusion computations of the MNE group in the same proportion.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??5.3.7.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 For purposes of Articles 5.3.3 and 5.3.4, eligible payroll costs and eligible tangible assets of a flow-through entity that are not allocated under Article 5.3.6 are allocated as follows:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 if the financial accounting net income or loss of the flow-through entity has been allocated to the constituent entity-owner under Article 3.5.1(b), then the entity\u8217??s eligible payroll costs and eligible tangible assets are allocated in the same proportion to the constituent entity-owner provided it is located in the jurisdiction where the eligible employees and eligible tangible assets are located;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 if the flow-through entity is the ultimate parent entity, then eligible payroll costs and eligible tangible assets located in the jurisdiction where the ultimate parent entity is located are allocated to it and reduced in proportion to the income that is excluded under Article 7.1.1; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 all other eligible payroll costs and eligible tangible assets of the flow-through entity are excluded from the substance-based income exclusion computations of the MNE group.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 5.4. Additional current top-up tax\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??5.4.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 If the effective tax rate and top-up tax for a prior fiscal year is required or permitted to be recalculated pursuant to an ETR adjustment article,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the effective tax rate and top-up tax for the prior fiscal year shall be recalculated in accordance with the rules of Article 5.1 through Article 5.3 after taking into account the adjustments to adjusted covered taxes and GloBE income or loss required by the relevant ETR adjustment article; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 any amount of incremental top-up tax resulting from such recalculation shall be treated as additional current top-up tax under Article 5.2.3 arising in the current fiscal year.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??5.4.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 If there is additional current top-up tax attributable to a recalculation under Article 5.4.1 and the jurisdiction does not have net GloBE income for the current fiscal year, the GloBE income of each constituent entity located in the jurisdiction for purposes of Article 2.2.2 shall be equal to the result of the top-up tax allocated to such entity under Articles 5.2.4 and 5.2.5 divided by the minimum rate.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??5.4.3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 If there is additional current top-up tax attributable to the operation of Article 4.1.5, the GloBE income of each constituent entity located in the jurisdiction for purposes of Article 2.2.2 shall be equal to the result of the top-up tax allocated to such entity under this Article divided by the minimum rate. The amount of additional current top-up tax allocated to each constituent entity for purposes of this Article shall be allocated only to constituent entities that record an adjusted covered taxes amount that is less than zero and less than the GloBE income or loss of such constituent entity multiplied by the minimum rate. The allocation shall be made pro-rata based upon the following amount for each of those constituent entities:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qc\sb0\sa80\li720\sl260{{\b0\i\nosupersub\nosupersub\fs18\qc\qc\li720\cf1 \f0 (GloBE Income or Loss x Minimum Rate) \u8211?? Adjusted Covered Taxes\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??5.4.4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 If a constituent entity is allocated additional current top-up tax pursuant to this Article and Article 5.2.4 such constituent entity shall be treated as a low-taxed constituent entity for the purposes of Chapter 2.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 5.5. De minimis exclusion\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??5.5.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 At the election of the filing constituent entity, and notwithstanding the requirements otherwise provided in Chapter 5, the top-up tax for the constituent entities located in a jurisdiction shall be deemed to be zero for a fiscal year if, for such fiscal year:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the average GloBE revenue of such jurisdiction is less than EUR 10 million; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the average GloBE income or loss of such jurisdiction is a loss or is less than EUR 1 million.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The election under this Article is an annual election.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Note\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 In relation to Article 5.5.1(a), see the specified OECD GloBE rules guidance in\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 paragraph 83}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0  of Chapter 5 of the 2023 Commentary; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 section 1}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0  of the Jul-2023 Administrative Guidance.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??5.5.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 For purposes of Article 5.5.1, the average GloBE revenue (or GloBE income or loss) of a jurisdiction is the average of the GloBE revenue (or GloBE income or loss) of the jurisdiction for the current and the two preceding fiscal years. If there were no constituent entities with GloBE revenue or GloBE losses that were located in the jurisdiction in the first or second preceding fiscal year, such year or years shall be excluded from the calculation of the average GloBE revenue and the average GloBE income or loss of the relevant jurisdiction.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??5.5.3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 For purposes of Article 5.5.2:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the GloBE revenue of a jurisdiction for a fiscal year is the sum of the revenue of all constituent entities located in the jurisdiction for such fiscal year, taking into account the adjustments calculated in accordance with Chapter 3; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the GloBE income or loss of a jurisdiction for a fiscal year is the net GloBE income of that jurisdiction, if any, or the net GloBE loss of that jurisdiction.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Note\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 In relation to Article 5.5.3, see\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 the specified OECD GloBE rules guidance in }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 paragraph 92}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0  of Chapter 5 of the 2023 Commentary; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 the specified OECD GloBE rules guidance in }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 paragraph 82}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0  of Chapter 5 of the 2023 Commentary.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??5.5.4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 An election under Article 5.5 shall not apply to a constituent entity that is a stateless constituent entity or an investment-related entity and the revenue and GloBE income or loss of a stateless constituent entity and an investment-related entity shall be excluded from the computations in Article 5.5.3.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 5.6. Minority-owned constituent entities\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??5.6.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The computation of the effective tax rate and top-up tax for a jurisdiction in accordance with Chapters 3 to 7, and Article 8.2 with respect to members of a minority-owned subgroup shall apply as if they were a separate MNE group. The adjusted covered taxes and GloBE income or loss of members of a minority-owned subgroup are excluded from the determination of the remainder of the MNE group\u8217??s effective tax rate in Article 5.1.1 and net GloBE income in Article 5.1.2.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??5.6.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The effective tax rate and top-up tax of a minority-owned constituent entity that is not a member of a minority-owned subgroup is computed on an entity basis in accordance with Chapters 3 to 7, and Article 8.2. The adjusted covered taxes and GloBE income or loss of the minority-owned constituent entity are excluded from the determination of the remainder of the MNE group\u8217??s effective tax rate in Article 5.1.1 and net GloBE income in Article 5.1.2. This provision does not apply if the minority-owned constituent entity is an investment-related entity.\par }}\pard\plain\nosnaplinegrid\b\i0\fs28\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs28\ql\ql\li240\cf1 \f0 Chapter 6 Corporate Restructurings and Holding Structures\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 6.1. Application of consolidated revenue threshold to group mergers and demergers\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??6.1.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 For the purposes of Article 1.1\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 If two or more groups merge to form a single group in any of the four fiscal years prior to the tested fiscal year, then the consolidated revenue threshold of the MNE group for any fiscal year prior to the merger is deemed to be met for that year if the sum of the revenue included in each of their consolidated financial statements for that year is equal to or greater than EUR 750 million.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Where an entity that is not a member of any group (acquirer) acquires or merges with an entity or group (target) in the tested fiscal year and the target or acquirer does not have consolidated financial statements in any of the four fiscal years prior to the tested fiscal year because it was not a member of any group in that year, the consolidated revenue threshold of the MNE group is deemed to be met for that year if the sum of the revenue included in each of their Financial Statements or consolidated financial statements for that year is equal to or greater than EUR 750 million.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Where a single MNE group within the scope of the GloBE rules demerges into two or more groups (each a demerged group), the consolidated revenue threshold is deemed to be met by a demerged group:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 i.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 with respect to the first tested fiscal year ending after the demerger, if the demerged group has annual revenues of EUR 750 million or more in that year;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ii.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 with respect to the second to fourth tested fiscal years ending after the demerger, if the demerged group has annual revenues of EUR 750 million or more in at least two of the fiscal years following the year of the demerger.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??6.1.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 For the purposes of Article 6.1.1 a merger is any arrangement where:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 all or substantially all of the group entities of two or more separate groups are brought under common control such that they constitute group entities of a combined group; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 an entity that is not a member of any group is brought under common control with another entity or group such that they constitute group entities of a combined group.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??6.1.3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 For the purposes of Article 6.1.1 a demerger is any arrangement where the group entities of a single group are separated into two or more groups that are no longer consolidated by the same ultimate parent entity.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 6.2. Constituent entities joining and leaving an MNE group\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??6.2.1}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Except to the extent provided in Article 6.2.2, the following provisions apply where an entity (the target) becomes or ceases to be a constituent entity of an MNE group as a result of a transfer of direct or indirect ownership interests in such entity during the fiscal year (the acquisition year):\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 where the target joins or leaves a group or the target becomes the ultimate parent entity of a new group, the target will be treated as a member of the group for the purposes of the GloBE rules if any portion of its assets, liabilities, income, expenses or cash flows are included on a line-by-line basis in the consolidated financial statements of the ultimate parent entity in the acquisition year;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 in the acquisition year, an MNE group shall take into account only the financial accounting net income or loss and adjusted covered taxes of the target that are taken into account in the consolidated financial statements of the ultimate parent entity for purposes of applying the GloBE rules;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 in the acquisition year and each succeeding year, the target shall determine its GloBE income or loss and adjusted covered taxes using its historical carrying value of the assets and liabilities;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the computation of the target\u8217??s eligible payroll costs under Article 5.3.3 shall take into account only those costs reflected in the consolidated financial statements of the ultimate parent entity;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (e)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the computation of carrying value of the target\u8217??s eligible tangible assets for purposes of Article 5.3.4 shall be adjusted proportionally to correspond with the length of the relevant fiscal year that the target was a member of the MNE group;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (f)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 with the exception of the GloBE loss deferred tax asset, the deferred tax assets and deferred tax liabilities of a constituent entity that are transferred between MNE groups shall be taken into account under the GloBE rules by the acquiring MNE group in the same manner and to the same extent as if the acquiring MNE group controlled the constituent entity when such assets and liabilities arose;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (g)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 deferred tax liabilities of a target that have previously been included in its total deferred tax adjustment amount shall be treated as reversed for purposes of applying Article 4.4.4 by the disposing MNE group and treated as arising in the acquisition year for purposes of applying Article 4.4.4 by the acquiring MNE group, except that in such cases any subsequent reduction to covered taxes under Article 4.4.4 shall have effect in the year in which the amount is recaptured; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (h)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 if the target is a parent entity and it is a group entity of two or more MNE groups during the acquisition year, it shall apply separately the provisions of the IIR to its allocable shares of the top-up tax of low-taxed constituent entities determined for each MNE group.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??6.2.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 For purposes of the GloBE rules, the acquisition or disposal of a controlling interest in a constituent entity will be treated as an acquisition or disposal of the assets and liabilities if the jurisdiction in which the target constituent entity is located, or in the case of a tax transparent entity, the jurisdiction in which the assets are located, treats the acquisition or disposal of that controlling interest in the same or similar manner as an acquisition or disposition of the assets and liabilities and imposes a covered tax on the seller based on the difference between their tax basis and the consideration paid in exchange for the controlling interest or the fair value of the assets and liabilities.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 6.3. Transfer of assets and liabilities\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??6.3.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 In the case of a disposition or acquisition of assets and liabilities, a disposing constituent entity will include the gain or loss on disposition in the computation of its GloBE income or loss and an acquiring constituent entity will determine its GloBE income or loss using the acquiring constituent entity\u8217??s carrying value of the acquired assets and liabilities determined under the accounting standard used in preparing consolidated financial statements of the ultimate parent entity.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Note\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 In relation to Article 6.3.1, see the specified OECD GloBE rules guidance in\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 paragraph 73}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 .1 of Chapter 6 of the 2023 Commentary; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 section 2}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 .1 of the Feb-2023 Administrative Guidance.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??6.3.2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 If the disposition or acquisition of assets and liabilities is part of a GloBE reorganisation Article 6.3.1 shall not apply and:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 a disposing constituent entity will exclude any gain or loss on the disposition from the computation of its GloBE income or loss; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 an acquiring constituent entity will determine its GloBE income or loss after the acquisition using the disposing entity\u8217??s carrying values of the acquired assets and liabilities upon disposition.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??6.3.3}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 If a disposition or acquisition of assets and liabilities is part of a GloBE reorganisation in which a disposing constituent entity recognises non-qualifying gain or loss, Articles 6.3.1 and 6.3.2 shall not apply and:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the disposing constituent entity will include gain or loss on the disposition in its GloBE income or loss computation to the extent of the non-qualifying gain or loss; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 an acquiring constituent entity will determine its GloBE income or loss after the acquisition using the disposing entity\u8217??s carrying value of the acquired assets and liabilities upon disposition adjusted consistent with local tax rules to account for the non-qualifying gain or loss.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??6.3.4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 At the election of the filing constituent entity, a constituent entity of an MNE group that is required or permitted to adjust the basis of its assets and the amount of its liabilities to fair value for tax purposes in the jurisdiction in which it is located, shall:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 include in the computation of its GloBE income or loss an amount of gain or loss in respect of each of its assets and liabilities that is equal to:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 i.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the difference between the carrying value for financial accounting purposes of the asset or liability immediately before and the fair value of the asset or liability immediately after the date of the event that triggered the tax adjustment (the triggering event);\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ii.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 decreased (or increased) by the non-qualifying gain (or loss), if any, arising in connection with the triggering event;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 use the fair value for financial accounting purposes of the asset or liability immediately after the triggering event to determine GloBE income or loss in fiscal years ending after the triggering event; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 include the net total of the amounts determined in Article 6.3.4(a) in the constituent entity\u8217??s GloBE income or loss in one of the following ways:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 i.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the net total of the amounts is included in the fiscal year in which the triggering event occurs; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ii.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 an amount equal to the net total of the amounts divided by five is included in the fiscal year in which the triggering event occurs and in each of the immediate four subsequent fiscal years, unless the constituent entity leaves the MNE group in a fiscal year within this period, in which case the remaining amount will be wholly included in that fiscal year.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 6.4. Joint ventures\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??6.4.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The GloBE rules shall apply to a joint venture and its JV subsidiaries as follows for each fiscal year:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Chapters 3 to 7, and Article 8.2 shall apply for purposes of computing any top-up tax of the joint venture and its JV subsidiaries as if they were constituent entities of a separate MNE group and as if the joint venture was the ultimate parent entity of that group;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 a parent entity that holds directly or indirectly ownership interests in the joint venture or a JV subsidiary shall apply the IIR with respect to its allocable share of the top-up tax of a member of the JV group in accordance with Article 2.1 to Article 2.3; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the JV group top-up tax shall be reduced by each parent entity\u8217??s allocable share of the top-up tax of each member of the JV group that is brought into charge under a qualified IIR under paragraph (b), and any remaining amount shall be added to the total UTPR top-up tax amount taken into account under Article 2.5.1.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 6.5. Multi-parented MNE groups\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??6.5.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The following provisions apply to multi-parented MNE groups:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the entities and constituent entities of each group are treated as members of a single MNE group for purposes of the GloBE rules (the multi-parented MNE group);\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 an entity (other than an excluded entity) shall be treated as a constituent entity if it is consolidated on a line-by-line basis by the multi-parented MNE group or its controlling interests are held by entities in the multi-parented MNE group;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the consolidated financial statements of the multi-parented MNE group shall be the consolidated financial statements referred to in the definition of stapled structure or dual-listed arrangement (as relevant) prepared under an acceptable financial accounting standard, which is deemed to be the accounting standard of the ultimate parent entity;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the ultimate parent entities of the separate groups that comprise the multi-parented MNE group shall be the ultimate parent entities of the multi-parented MNE group (when applying the GloBE rules in respect of a multi-parented MNE group, a reference to an ultimate parent entity shall apply, as required, as if they were a reference to multiple ultimate parent entities);\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (e)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the parent entities of the multi-parented MNE group (including each ultimate parent entity) located in Hong Kong shall apply the IIR in accordance with Article 2.1 to Article 2.3 with respect to their allocable share of the top-up tax of the low-taxed constituent entity;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (f)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 all of the constituent entities of the multi-parented MNE group located in Hong Kong shall apply the UTPR in accordance with Article 2.4 to Article 2.6, taking into account the top-up tax of each low-taxed constituent entity of the multi-parented MNE group; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (g)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the ultimate parent entities are required to submit the GloBE information return in accordance with Article 8.1 unless they appoint a single designated filing entity and that return shall include the information concerning each of the groups that comprise the multi-parented MNE group.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Notes\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 1.\u160??\u160??}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 The reference in Article 6.5.1(f) to \u8220??Article 2.4 to Article 2.6\u8221?? is to be read as \u8220??Article 2.4 to Article 2.6, read with Part 2 of this Schedule\u8221??, because of Part 2 of this Schedule.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 2.\u160??\u160??}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 Similarly, the reference in Article 6.5.1(g) to \u8220??Article 8.1\u8221?? is to be read as \u8220??Part 2 of Schedule 63\u8221??, because of Part 2 of this Schedule.\par }}\pard\plain\nosnaplinegrid\b\i0\fs28\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs28\ql\ql\li240\cf1 \f0 Chapter 7 Tax Neutrality and Distribution Regimes\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 7.1. Ultimate parent entity that is a flow-through entity\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.1.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The GloBE income for a fiscal year of a flow-through entity that is the ultimate parent entity of an MNE group shall be reduced by the amount of GloBE income attributable to each ownership interest if:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the holder of the ownership interest is subject to tax on such income for a taxable period that ends within 12 months of the end of the MNE group\u8217??s fiscal year and:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the holder of the ownership interest is subject to tax on the full amount of such income at a nominal rate that equals or exceeds the minimum rate; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 it can be reasonably expected that the aggregate amount of covered taxes paid by the ultimate parent entity and other entities that are part of the tax transparent structure and taxes of the holder of the ownership interest on such income equals or exceeds the amount that results from multiplying the full amount of such income by the minimum rate; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the holder is a natural person that:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 is a tax resident in the UPE jurisdiction; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 holds ownership interests that, in the aggregate, are a right to 5% or less of the profits and assets of the ultimate parent entity; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the holder is a governmental entity, an international organisation, a non-profit organisation, or a pension fund that:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 is resident in the UPE jurisdiction; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 holds ownership interests that, in the aggregate, are a right to 5% or less of the profits and assets of the ultimate parent entity.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Notes\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 1.\u160??\u160??}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 In relation to Article 7.1.1(a)(i), see the specified OECD GloBE rules guidance in paragraph 12 of Chapter 7 of the 2023 Commentary.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 2.\u160??\u160??}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 In relation to Article 7.1.1(b)(ii), see the specified OECD GloBE rules guidance in paragraph 18 of Chapter 7 of the 2023 Commentary.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.1.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 In computing its GloBE loss for a fiscal year, a flow-through entity that is the ultimate parent entity of an MNE group shall reduce its GloBE loss for such fiscal year by the amount of GloBE loss attributable to each ownership interest, except to the extent that the holders of ownership interests are not allowed to use the loss in computing their separate taxable income.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.1.3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 A flow-through entity that reduces its GloBE income pursuant to Article 7.1.1 shall reduce its covered taxes proportionally.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.1.4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Articles 7.1.1 through 7.1.3 shall apply to a permanent establishment:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 through which a flow-through entity that is the ultimate parent entity of an MNE group wholly or partly carries out its business; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 through which the business of a tax transparent entity is wholly or partly carried out if the ultimate parent entity\u8217??s ownership interest in that tax transparent entity is held directly or through a tax transparent structure.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 7.2. Ultimate parent entity subject to deductible dividend regime\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.2.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 For purposes of computing its GloBE income or loss for a fiscal year, an ultimate parent entity that is subject to a deductible dividend regime shall reduce (but not below zero) its GloBE income for such fiscal year by the amount that is distributed as a deductible dividend within 12 months of the end of the fiscal year if:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the dividend is subject to tax in the hands of the dividend recipient for a taxable period that ends within 12 months of the end of the ultimate parent entity\u8217??s fiscal year, and:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the dividend recipient is subject to tax on such dividend at a nominal rate that equals or exceeds the minimum rate;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 it can be reasonably expected that the aggregate amount of covered taxes paid by the ultimate parent entity and taxes paid by the dividend recipient on the dividend income equals or exceeds the amount that results from multiplying the full amount of such income by the minimum rate; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (iii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the dividend recipient is a natural person and the dividend is a patronage dividend from a supply cooperative; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the dividend recipient is a natural person that:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 is a tax resident in the UPE jurisdiction; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 holds ownership interests that, in the aggregate, are a right to 5% or less of the profits and assets of the ultimate parent entity.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the dividend recipient is resident in the UPE jurisdiction and is:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 a governmental entity,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 an international organisation,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (iii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 a non-profit organisation or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (iv)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 a pension fund that is not a pension services entity.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.2.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 An ultimate parent entity that reduces its GloBE income pursuant to Article 7.2.1 shall reduce its covered taxes (other than the taxes for which the dividend deduction was allowed) proportionally and shall reduce its GloBE income by the same amount.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Note\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 In relation to Article 7.2.2, see the specified OECD GloBE rules guidance in }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 paragraph 46}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0  of Chapter 7 of the 2023 Commentary.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.2.3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 If the ultimate parent entity holds an ownership interest in another constituent entity subject to the deductible dividend regime (directly or through a chain of such constituent entities), Articles 7.2.1 and 7.2.2 shall apply to each other constituent entity in the UPE jurisdiction that is subject to the deductible dividend regime to the extent that its GloBE income is further distributed by the ultimate parent entity to recipients that meet the requirements of Article 7.2.1.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.2.4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Patronage dividends from a supply cooperative are subject to tax to the extent they reduce an expense or cost that is deductible in the computation of the recipient\u8217??s taxable income.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Note\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 In relation to Article 7.2.4, see the specified OECD GloBE rules guidance in }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 paragraph 50}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0  of Chapter 7 of the 2023 Commentary.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 7.3. Eligible distribution tax systems\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.3.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 A filing constituent entity may make an annual election with respect to a constituent entity that is subject to an eligible distribution tax system to add the amount of deemed distribution tax determined under Article 7.3.2 to adjusted covered taxes for the fiscal year. An election under this Article shall apply to all constituent entities located in the jurisdiction.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.3.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The amount of deemed distribution tax is the lesser of:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the amount necessary to increase the effective tax rate computed under Article 5.2.1 for the jurisdiction for the fiscal year to the minimum rate; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the amount of distribution tax that would have been due if the constituent entities located in the jurisdiction had distributed all of their income that is subject to the eligible distribution tax regime during such year.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.3.3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 An annual deemed distribution tax recapture account is established for each fiscal year in which the election in Article 7.3.1 applies. A deemed distribution tax recapture account is increased by the amount of the deemed distribution tax determined under Article 7.3.2 for the jurisdiction for the fiscal year for which it was established. At the end of each succeeding fiscal year, the outstanding balances of deemed distribution tax recapture accounts established for prior fiscal years are reduced in chronological order and to the extent thereof, but not below zero:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 first by taxes paid by the constituent entities during the fiscal year in relation to actual or deemed distributions;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 then by the amount of any net GloBE loss of the jurisdiction multiplied by the minimum rate; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 then by any amount of recapture account loss carry-forward applied to the current fiscal year pursuant to Article 7.3.4.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.3.4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 A recapture account loss carry-forward shall be established for the jurisdiction when the amount described in Article 7.3.3(b) exceeds the outstanding balance of the deemed distribution tax recapture accounts. The recapture account loss carry-forward shall be in an amount equal to such excess and shall be taken into account in subsequent fiscal years as a reduction to deemed distribution tax recapture accounts in such fiscal years. When such amount is taken into account in a subsequent fiscal year, the recapture account loss carry-forward must be reduced by that amount.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.3.5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 If there is an outstanding balance of a deemed distribution tax recapture account (maintained in accordance with Article 7.3.3) on the last day of the fourth fiscal year after the fiscal year for which such account was established, the effective tax rate and top-up tax for the fiscal year for which the account was established must be recalculated under Article 5.4.1 by treating the balance of the deemed distribution tax recapture account as a reduction to the adjusted covered taxes previously determined for such year.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.3.6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Taxes paid during the fiscal year in relation to actual or deemed distributions are not included in adjusted covered taxes to the extent they reduce a deemed distribution tax recapture account under Article 7.3.3.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.3.7.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 In the fiscal year that a departing constituent entity leaves the MNE group or transfers substantially all of its assets outside the MNE group or outside the jurisdiction,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the effective tax rate and top-up tax for each preceding year for which a deemed distribution tax recapture account is outstanding is re-calculated in accordance with the principles of Article 5.4.1. by treating the balance of the deemed distribution tax recapture account as a reduction to the adjusted covered taxes previously determined for such year; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 any amount of incremental top-up tax resulting from such recalculation shall be multiplied by the disposition recapture ratio to determine the additional current top-up tax for purposes of Article 5.2.3.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Note\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 In relation to Article 7.3.7(b), see the specified OECD GloBE rules guidance in }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 paragraph 71}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0  of Chapter 7 of the 2023 Commentary.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.3.8.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The disposition recapture ratio is determined for each departing constituent entity using the following formula:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs2\qj\sb0\sa0\li720\sl20{\par}\pard\plain\nosnaplinegrid\b0\i0\fs2\qj\sb0\sa0\li720\sl20{{\pard\intbl\ltrch\pard\plain\nosnaplinegrid\intbl\b0\i0\fs22\qc\sb0\sa80\li0\sl0{{\b0\i\nosupersub\nosupersub\fs22\qc\qc\li0\cf1 \f0 GloBE income of the CE\cell}}{
\trowd \irow0\irowband0\trrh0\trautofit0\trgaph0\trleft720\trftsWidth2\trftsWidthB3\trpaddl108\trpaddr108\trwWidth2133\tbllkhdrrows\tbllkhdrcols\tbllklastcol
\brdrcf1\brdrcf1\brdrcf1\brdrcf1\clbrdrb\brdrs\brdrw10\brdrcf1\brdrcf1\clpadl0\clpadfl3\clpadt100\clpadft3\clpadb0\clpadfb3\clpadr100\clpadfr3\clshdrawnil\cltxlrtb\clftsWidth2\clwWidth5000\clNoWrap\cellx4725\row}\pard\intbl\ltrch\pard\plain\nosnaplinegrid\intbl\b0\i0\fs22\ql\sb0\sa80\li0\sl0{{\b0\i\nosupersub\nosupersub\fs22\ql\ql\li0\cf1 \f0 Net income of the jurisdiction\cell}}{
\trowd \irow1\irowband1\trrh0\trautofit0\trgaph0\trleft720\trftsWidth2\trftsWidthB3\trpaddl108\trpaddr108\trwWidth2133\tbllkhdrrows\tbllkhdrcols\tbllklastcol
\clbrdrt\brdrtbl \clbrdrl\brdrtbl \clbrdrb\brdrtbl \clbrdrr\brdrtbl\clpadl0\clpadfl3\clpadt100\clpadft3\clpadb0\clpadfb3\clpadr100\clpadfr3\clshdrawnil\cltxlrtb\clftsWidth2\clwWidth5000\clNoWrap\cellx4725\row}}}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 where:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 GloBE income of the CE is the sum of GloBE income of the departing constituent entity determined in accordance with Chapter 3 for each fiscal year corresponding to the deemed distribution tax recapture accounts for the jurisdiction; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 net Income of the jurisdiction is the sum of the net GloBE income of the jurisdiction determined in accordance with Article 5.1.2 for each fiscal year corresponding to the deemed distribution tax recapture accounts for the jurisdiction.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 7.4. Effective tax rate computation for investment-related entities\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.4.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The rules of Article 7.4 apply to constituent entities that meet the definition of an investment-related entity, except investment-related entities that are tax transparent entities or subject to an election under Article 7.5 or Article 7.6.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.4.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The effective tax rate for an investment-related entity that is a constituent entity shall be calculated separately from the effective tax rate of the jurisdiction in which it is located. The effective tax rate for each such investment-related entity is equal to the investment-related entity\u8217??s adjusted covered taxes divided by the MNE group\u8217??s allocable share of the investment-related entity\u8217??s GloBE income determined under Chapter 3. If there is more than one investment-related entity located in the jurisdiction, the adjusted covered taxes and the MNE group\u8217??s allocable share of each investment-related entity\u8217??s GloBE income or loss determined for each such investment-related entity are combined to compute the effective tax rate of all such investment-related entities.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.4.3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 An investment-related entity\u8217??s adjusted covered taxes is the sum of the adjusted covered taxes determined for the investment-related entity under Article 4.1 attributable to the MNE group\u8217??s allocable share of the investment-related entity\u8217??s GloBE income and the covered taxes allocated to the investment-related entity under Article 4.3. The investment-related entity\u8217??s adjusted covered taxes does not include any covered taxes accrued by the investment-related entity attributable to income that is not part of the MNE group\u8217??s allocable share of the investment-related entity\u8217??s GloBE income.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.4.4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The MNE group\u8217??s allocable share of the investment-related entity\u8217??s GloBE income is equal to the allocable share of the investment-related entity\u8217??s GloBE income or loss that would be determined for the ultimate parent entity in accordance with the rules of Article 2.2.2 taking into account only interests that are not subject to an election under Article 7.5 or Article 7.6.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.4.5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The top-up tax of a constituent entity that is an investment-related entity shall be an amount equal to the top-up tax percentage for the investment-related entity multiplied by the investment-related entity\u8217??s GloBE income over the substance-based income exclusion for the investment-related entity. The top-up tax percentage for an investment-related entity shall be the percentage point excess, if any, of the minimum rate over the effective tax rate of the investment-related entity. If there is more than one investment-related entity located in the jurisdiction, the investment-related entity\u8217??s GloBE income and the substance-based income exclusion determined for each such investment-related entity are combined to compute the top-up tax percentage of all such investment-related entities.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.4.6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The substance-based income exclusion for an investment-related entity shall be determined in accordance with the principles in Article 5.3 without regard to the exception in Article 5.3.2, and by taking into account only eligible tangible assets and eligible payroll costs of eligible employees of the investment-related entities.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 7.5. Investment-related entity tax transparency election\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.5.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 A filing constituent entity may elect to treat a constituent entity that is an investment-related entity as a tax transparent entity if the constituent entity-owner is subject to tax in its location under a mark-to-market or similar regime based on the annual changes in the fair value of its ownership interest in the entity and the tax rate applicable to the constituent entity-owner with respect to such income equals or exceeds the minimum rate. For this purpose, a constituent entity that indirectly owns an ownership interest in an investment-related entity through a direct ownership interest in another investment-related entity is considered to be subject to tax under a mark-to-market or similar regime with respect to the indirect ownership interest in the first-mentioned entity if it is subject to a mark-to-market or similar regime with respect to the direct ownership interest in the second-mentioned entity.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Note\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 In relation to Article 7.5.1, see the specified OECD GloBE rules guidance in\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 paragraphs 91}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 91}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 .1 of Chapter 7 of the 2023 Commentary; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 section 3}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 .6 of the Feb-2023 Administrative Guidance.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.5.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The election under this Article is a five-year election. If the election is revoked, gain or loss from the disposition of an asset or liability held by the investment-related entity shall be determined based on the fair value of the assets or liabilities on the first day of the revocation year.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 7.6. Taxable distribution method election\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.6.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 At the election of the filing constituent entity, a constituent entity-owner that is not an investment-related entity may apply the taxable distribution method with respect to its ownership interest in a constituent entity that is an investment-related entity if the constituent entity-owner can be reasonably expected to be subject to tax on distributions from the investment-related entity at a tax rate that equals or exceeds the minimum rate.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.6.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Under the taxable distribution method:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 distributions and deemed distributions of the investment-related entity\u8217??s GloBE income are included in the GloBE income of the constituent entity-owner (other than an investment-related entity) that received the distribution;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the local creditable tax gross-up is included in the GloBE income and adjusted covered taxes of the constituent entity-owner (other than an investment-related entity) that received the distribution;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the constituent entity-owner\u8217??s proportionate share of the investment-related entity\u8217??s undistributed net GloBE income for the tested year is treated as GloBE income of the investment-related entity for the reporting fiscal year and the result of multiplying the minimum rate by such GloBE income is treated as top-up tax of a low-tax constituent entity in the fiscal year for purposes of Chapter 2; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the investment-related entity\u8217??s GloBE income or loss for the fiscal year and any adjusted covered taxes attributable to such income are excluded from all effective tax rate computations under Chapter 5 and Articles 7.4.2 to 7.4.5, except as provided in paragraph (b).\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.6.3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The undistributed net GloBE income for a fiscal year is the amount of the investment-related entity\u8217??s GloBE income, if any, for the tested year reduced (but not below zero) by:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 any covered taxes of the investment-related entity;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 distributions and deemed distributions to shareholders other than constituent entities that are investment-related entities in the testing period;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 GloBE losses arising in the testing period; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 investment loss carry-forwards.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.6.4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Undistributed net GloBE income for the tested year cannot be reduced by distributions or deemed distributions to the extent that such distributions were treated as a reduction to undistributed net GloBE income of a previous tested year. For purposes of computing undistributed net GloBE income, a GloBE loss is reduced to the extent it reduced undistributed net GloBE income at the end of a previous fiscal year. If a GloBE loss for a fiscal year is not reduced to zero before the end of the last tested period that includes such fiscal year, the remainder becomes an investment loss carry-forward and is reduced in the same manner as a GloBE loss in subsequent fiscal years.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.6.5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 For purposes of Article 7.6,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the tested year is the third year preceding the reporting fiscal year;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the testing period is the period beginning with the first day of the tested year and ending with the last day of the reporting fiscal year that the ownership interest was held by a group entity;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 a deemed distribution arises when a direct or indirect ownership interest in the investment-related entity is transferred to a non-group entity and is equal to the proportionate share of the undistributed net GloBE income attributable to such ownership interest on the date of such transfer (determined without regard to the deemed distribution); and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the local creditable tax gross-up is the amount of covered taxes incurred by the investment-related entity that is allowed as a credit against the constituent entity-owner\u8217??s tax liability arising in connection with a distribution from the investment-related entity.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??7.6.6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The election under this Article is a five-year election. If the election is revoked, constituent entity-owner\u8217??s proportionate share of the investment-related entity\u8217??s undistributed net GloBE income for the tested year at the end of the fiscal year preceding the revocation year is treated as GloBE income of the investment-related entity for the revocation year and the result of multiplying the minimum rate by such GloBE income is treated as top-up tax of a low-tax constituent entity in the revocation year for purposes of Chapter 2.\par }}\pard\plain\nosnaplinegrid\b\i0\fs28\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs28\ql\ql\li240\cf1 \f0 Chapter 8 Administration\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 8.1. Filing obligation\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li240\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li240\cf1 \f0 [Article 8.1 of the OECD GloBE model rules is omitted. See, instead, }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li240\cf1 \f0 Part 2 of Schedule 63}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li240\cf1 \f0  for provisions on filing obligations.]\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 8.2. Safe harbours\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Note\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Article 8.2 is to be read together with }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Part 3}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0  of this Schedule.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??8.2.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 At the election of the filing constituent entity, and notwithstanding Chapter 5, the top-up tax for a jurisdiction (the safe harbour jurisdiction) shall be deemed to be zero for a fiscal year when the constituent entities located in this jurisdiction are eligible for a GloBE safe harbour, pursuant to the conditions provided under the GloBE implementation framework and applicable for that fiscal year.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??8.2.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 An election made for a jurisdiction under Article 8.2.1 shall not apply in circumstances where:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Hong Kong could be allocated top-up tax under the GloBE rules if the effective tax rate for the safe harbour jurisdiction computed in accordance with Chapter 5 was below the minimum rate; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the tax administration of Hong Kong notifies the liable constituent entity (or entities) within 36 months after the filing of the GloBE information return of specific facts and circumstances that may have materially affected the eligibility of the constituent entities located in the safe harbour jurisdiction for the relevant safe harbour and invites the liable constituent entity (or entities) to clarify within six months the effect of those facts and circumstances on the eligibility of those constituent entities for that safe harbour; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the liable constituent entity (or entities) fail(s) to demonstrate within the response period that those facts and circumstances did not materially affect the eligibility of the constituent entities for the relevant safe harbour.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 8.3. Administrative guidance\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li240\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li240\cf1 \f0 [Article 8.3 of the OECD GloBE model rules is omitted. See, instead, }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li240\cf1 \f0 section 26AF}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li240\cf1 \f0  for provisions on administrative guidance.]\par }}\pard\plain\nosnaplinegrid\b\i0\fs28\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs28\ql\ql\li240\cf1 \f0 Chapter 9 Transition Rules\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 9.1. Tax attributes upon transition\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??9.1.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 When determining the effective tax rate for a jurisdiction in a transition year, and for each subsequent year, the MNE group shall take into account all of the deferred tax assets and deferred tax liabilities reflected or disclosed in the financial accounts of all of the constituent entities in a jurisdiction for the transition year. Such deferred tax assets and liabilities must be taken into account at the lower of the minimum rate or the applicable domestic tax rate. A deferred tax asset that has been recorded at a rate lower than the minimum rate may be taken into account at the minimum rate if the taxpayer can demonstrate that the deferred tax asset is attributable to a GloBE loss. For purposes of applying this Article, the impact of any valuation adjustment, or accounting recognition adjustment with respect to a deferred tax asset is disregarded.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Note\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 In relation to Article 9.1.1, see\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 the specified OECD GloBE rules guidance in\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 paragraph 6}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 .4 of Chapter 9 of the 2023 Commentary; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub