nd the arrangement to which the ruling applies;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the period for which the ruling applies; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 any material assumptions in respect of a future event or any other matter made by the Commissioner.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 13.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The Commissioner may at any time withdraw a ruling by notifying the person to whom the ruling applies in writing of the withdrawal and the reasons therefor.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 14.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 If the Commissioner withdraws a ruling made in respect of an arrangement\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the ruling shall cease to apply in relation to the arrangement if the arrangement is entered into or effected after the date of the withdrawal;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 if the arrangement has been entered into or effected on or before the date of the withdrawal\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 where the person to whom the ruling applies has under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 section 15}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0  disclosed in the return provided under this Ordinance that he has relied on the ruling in preparing and providing the return, the ruling shall after the date of the withdrawal continue to apply in relation to the arrangement for the remainder of the period specified in the ruling;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 in any other case, the ruling shall cease to apply in relation to the arrangement.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 15.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 a person has obtained a ruling;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260