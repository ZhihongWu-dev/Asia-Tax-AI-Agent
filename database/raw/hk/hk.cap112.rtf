{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the relevant individual is not chargeable to tax on any remuneration paid or credited to him by that corporation or trustee, as the case may be\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 in respect of any office or employment of profit he has with that corporation or trustee, as the case may be; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 to the extent that the remuneration referred to in this paragraph is attributable to any of the services referred to in that subsection.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (6)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 The Commissioner may, by notice in the Gazette, prescribe an activity for the purposes of this section.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (7)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 For the avoidance of doubt, it is hereby declared that\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\