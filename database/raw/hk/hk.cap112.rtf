\pard\plain \ltrpar\ql \li0\ri0\nowidctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1779345 \rtlch\fcs1 \af0\afs24\alang1025 \ltrch\fcs0 \fs24\lang1033\langfe1033\kerning2\loch\af0\hich\af0\dbch\af14\cgrid\langnp1033\langfenp1033 {\*\latentstyles\lsdstimax267\lsdlockeddef0\lsdsemihiddendef1\lsdunhideuseddef1\lsdqformatdef0\lsdprioritydef99{\lsdlockedexcept \lsdsemihidden0 \lsdunhideused0 \lsdqformat1 \lsdpriority0 \lsdlocked0 Normal;}}\pard\plain\nosnaplinegrid\b\i0\fs26\qc\sb240\sa80\keepn\li0\sl300{{\b\i0\nosupersub\nosupersub\fs26\qc\qc\li0\cf1 \f0 Division 3}{\b\i0\nosupersub\nosupersub\fs26\qc\qc\li0\cf1 \f0 \u8212??}{\b\i0\nosupersub\nosupersub\fs26\qc\qc\li0\cf1 \f0 Country-by-Country Reporting\par }}\pard\plain\nosnaplinegrid\b\i0\fs18\qj\sb0\sa80\li1280\sl220{{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li1280\cf1 \f0 Note (with no legislative effect) providing an overview of }{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li1280\cf1 \f0 Division 3}{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li1280\cf1 \f0 \u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl220{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 Division 3}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0  gives effect to the country-by-country reporting requirements of the Organisation for Economic Co-operation and Development. Under those requirements, a country-by-country report (}{\b\i\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 CbC report}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 ) must be filed in respect of a group (}{\b\i\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 reportable group}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 ) whose annual consolidated group revenue reaches the specified threshold amount to provide, annually and for each tax jurisdiction in which the group does business, information such as the amount of revenue, profit before tax, tax paid and accrued, capital and assets.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl220{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 Under }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 section 58D}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 , the requirements for filing a country-by-country return (}{\b\i\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 CbC return}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 ) (which must include a CbC report) only apply to a reportable group.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl220{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 A reportable group\u8217??s ultimate parent entity (}{\b\i\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 UPE}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 ) is required to file a CbC return with the Commissioner for each accounting period beginning on or after 1 January 2018 if the UPE is resident for tax purposes in Hong Kong (}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 section 58E(1)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 ).\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl220{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 A Hong Kong entity of a reportable group whose UPE is not resident for tax purposes in Hong Kong is required to file a CbC return with the Commissioner if any of the following conditions is met\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl220{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 the UPE is not required to file a CbC report in its jurisdiction of tax residence (}{\b\i\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 jurisdiction U}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 );\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl220{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 jurisdiction U has a current international agreement with Hong Kong providing for the automatic exchange of tax information but, by the deadline for filing the CbC return, there are no exchange arrangements in place between jurisdiction U and Hong Kong for CbC reports;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl220{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 there has been a systemic failure to exchange CbC reports by jurisdiction U, which has been notified to the Hong Kong entity by the Commissioner (}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 sections 58F(1)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 58I(1)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 ).\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl220{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 Even if one of the conditions mentioned in item 4 of this Note is met, the Hong Kong entity is not required to file a CbC return if\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl220{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 a CbC return for the relevant period is filed by another Hong Kong entity of the reportable group; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl220{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 a CbC report is filed by the reportable group\u8217??s surrogate parent entity resident in another jurisdiction (}{\b\i\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 jurisdiction S}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2160\cf1 \f0 ) and exchange mechanisms are in place between jurisdiction S and Hong Kong.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li1680\sl220{{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 This and the concept of }{\b\i\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 surrogate parent entity}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0  are dealt with in }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 sections 58F(2)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 58I(2)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0  to (7).\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl220{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 Also, a reportable group\u8217??s UPE resident for tax purposes in Hong Kong may voluntarily file a CbC return for an accounting period beginning on or after 1 January 2016 but before 1 January 2018 (}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 section 58E(2)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 ).\par }}
