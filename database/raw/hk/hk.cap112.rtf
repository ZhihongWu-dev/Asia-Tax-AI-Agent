\pard\plain \ltrpar\ql \li0\ri0\nowidctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1779345 \rtlch\fcs1 \af0\afs24\alang1025 \ltrch\fcs0 \fs24\lang1033\langfe1033\kerning2\loch\af0\hich\af0\dbch\af14\cgrid\langnp1033\langfenp1033 {\*\latentstyles\lsdstimax267\lsdlockeddef0\lsdsemihiddendef1\lsdunhideuseddef1\lsdqformatdef0\lsdprioritydef99{\lsdlockedexcept \lsdsemihidden0 \lsdunhideused0 \lsdqformat1 \lsdpriority0 \lsdlocked0 Normal;}}\pard\plain\nosnaplinegrid\b\i0\fs22\qj\sb240\sa80\keepn\fi-720\li720\tx960\sl260{{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 4.}{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Official secrecy\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Except in the performance of his duties under this Ordinance, every person who has been appointed under or who is or has been employed in carrying out or in assisting any persons to carry out the provisions of this Ordinance shall preserve and aid in preserving secrecy with regard to all matters relating to the affairs of any person that may come to his knowledge in the performance of his duties under this Ordinance, and shall not communicate any such matter to any person other than the person to whom such matter relates or his executor or the authorized representative of such person or such executor, nor suffer or permit any person to have access to any records in the possession, custody or control of the Commissioner. }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 9 of 1958 s. 3}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Every person appointed under or employed in carrying out the provisions of this Ordinance, shall before acting under this Ordinance take and subscribe before a commissioner for oaths an oath of secrecy in such form as the Board of Inland Revenue may specify. }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 39 of 1969 s. 2}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 47 of 1997 s. 10}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (3)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 No person appointed under or employed in carrying out the provisions of this Ordinance shall be required to produce in any court any return, document, or assessment, or to divulge or communicate to any court any matter or thing coming under his notice in the performance of his duties under this Ordinance, except as may be necessary for the purpose of carrying into effect the provisions of this Ordinance. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (4)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Notwithstanding anything contained in this section, the Commissioner or any officer of the Inland Revenue Department authorized by the Commissioner in that behalf may communicate any matter which comes to his knowledge, including a copy of any return, accounts or other document submitted to him in connection with this Ordinance\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 to the Commissioner of Rating and Valuation, to the Collector of Stamp Revenue, or to the Estate Duty Commissioner; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 20 of 1948 s. 4}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 29 of 2018 s. 4}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Repealed }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 12 of 1999 s. 3}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 to the Secretary for Justice, or a public officer authorized by the Secretary for Justice, for the purpose of reporting under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 68(5)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  an appeal to the Board of Review; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 2 of 1971 s. 3}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 . Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 79 of 1992 s. 10}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 L.N. 362 of 1997}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 29 of 2018 s. 4}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 to any person appointed under or employed in carrying out the provisions of the Business Registration Ordinance (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 Cap. 310}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ), as regards any matter required to be notified to the Commissioner pursuant to }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 8}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  of that Ordinance by the person submitting such return, accounts or other document; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 79 of 1992 s. 10}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 . Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 13 of 2010 s. 26}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 29 of 2018 s. 4}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 9 of 2021 s. 4}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (e)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 to the Commissioner for I&T, or a public officer authorized by the Commissioner for I&T, for the purpose of seeking advice under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 18 of Schedule 45}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ; or }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 29 of 2018 s. 4}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 . Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 9 of 2021 s. 4}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (f)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 to the Monetary Authority, or an officer authorized by the Monetary Authority, for the purpose of seeking advice under section 12 of Schedule 16D. }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 9 of 2021 s. 4}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (5)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Notwithstanding anything contained in this section, the Commissioner may permit the Director of Audit or any officer of that department duly authorized by the Director of Audit in that behalf to have such access to any records or documents as may be necessary for the performance of his official duties. The Director of Audit or any officer so authorized shall be deemed to be a person employed in carrying out the provisions of this Ordinance for the purpose of subsection (2). \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi