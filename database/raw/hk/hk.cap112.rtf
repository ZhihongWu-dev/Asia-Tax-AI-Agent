\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 in the case of the first entity being a natural person carrying on a sole proprietorship business\u8212??the other entity is the same person carrying on another sole proprietorship business.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 For the purposes of subsection (1), an entity (}{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 entity A}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ) has control over another entity (}{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 entity B}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ) if\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 in the case of entity B being a trust\u8212??entity A is entitled to a vested interest in more than 50% of the capital of the property of the trust\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 whether the interest is in possession or in remainder or reversion; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 whether the interest is defeasible or not; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 in any other case\u8212??entity A has a specified interest in entity B.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (3)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 However, entity A does not have control over entity B if it falls within the description in subsection }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (2)(a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  or (b) in respect of entity B solely by acting in the capacity of a trustee.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (4)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 For the purposes of subsection }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (2)(b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 , entity A has a specified interest in entity B if entity A, whether directly or indirectly through one or more than one other entity (}{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 interposed entity}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 owns or controls more than 50% in aggregate of the issued share capital of entity B;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 is entitled to exercise or control the exercise of more than 50% in aggregate of the voting rights in entity B; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 is entitled to more than 50% in aggregate of the capital or profits of entity B.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (5)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 For the purposes of subsection (4), the extent of any indirect interest of entity A in entity B is\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 if there is 1 interposed entity\u8212??the percentage arrived at by multiplying the percentage representing the extent of the direct interest of entity A in the interposed entity by the percentage representing the extent of the direct interest of the interposed entity in entity B; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 if there is a series of 2 or more interposed entities\u8212??the percentage arrived at by multiplying the percentage representing the extent of the direct interest of entity A in the first interposed entity in the series by\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 the percentage representing the extent of the direct interest of each interposed entity (other than the last interposed entity) in the next interposed entity in the series; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 the percentage representing the extent of the direct interest of the last interposed entity in entity B.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (6)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 For the purposes of subsection (5), the extent of the direct interest of an entity in another entity is\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 in relation to issued share capital\u8212??the percentage of the issued share capital of the other entity directly owned or directly controlled by the first entity;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 in relation to voting rights\u8212??the percentage of the voting rights in the other entity that the first entity is directly entitled to exercise, or over which the first entity is directly entitled to control the exercise; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 in relation to capital or profits\u8212??the percentage of the capital or profits of the other entity that the first entity is directly entitled to.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (7)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 For the purposes of this section, if an entity is a corporation, a reference to the exercise of the voting rights in the entity is to be construed as a reference to the exercise of the voting rights at general meetings of the entity.\par }}\pard\plain\nosnaplinegrid\b0\i\fs22\qr\sb0\sa80\li720\sl260{{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 13 of 2018 s. 4}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 )\par }}
