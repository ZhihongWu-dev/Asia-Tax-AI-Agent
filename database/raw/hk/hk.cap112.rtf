\pard\plain \ltrpar\ql \li0\ri0\nowidctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1779345 \rtlch\fcs1 \af0\afs24\alang1025 \ltrch\fcs0 \fs24\lang1033\langfe1033\kerning2\loch\af0\hich\af0\dbch\af14\cgrid\langnp1033\langfenp1033 {\*\latentstyles\lsdstimax267\lsdlockeddef0\lsdsemihiddendef1\lsdunhideuseddef1\lsdqformatdef0\lsdprioritydef99{\lsdlockedexcept \lsdsemihidden0 \lsdunhideused0 \lsdqformat1 \lsdpriority0 \lsdlocked0 Normal;}}\pard\plain\nosnaplinegrid\b\i0\fs22\qj\sb240\sa80\keepn\fi-720\li720\tx960\sl260{{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 20ACA.}{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Certain profits of special purpose vehicles exempt from payment of tax\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 A special purpose vehicle is exempt, to an extent corresponding to the percentage of shares or interests that a non-resident person exempted under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 20AC(1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  holds in the vehicle, from the payment of tax chargeable under this Part in respect of its assessable profits, if any, for any year of assessment commencing on or after 1 April 2015, from\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 transactions in shares, stocks, debentures, loan stocks, funds, bonds or notes of, or issued by, an interposed special purpose vehicle or an excepted private company;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 transactions in rights, options or interests (whether described as units or otherwise) in, or in respect of, such shares, stocks, debentures, loan stocks, funds, bonds or notes; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 transactions in certificates of interest or participation in, temporary or interim certificates for, receipts for, or warrants to subscribe for or purchase, such shares, stocks, debentures, loan stocks, funds, bonds or notes.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 In this section\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-480\li1200\sl260{{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 excepted private company}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u20363??\u22806??\u31169??\u20154??\u20844??\u21496??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ) means a private company incorporated outside Hong Kong that, at all times within the 3 years before a transaction falling within subsection }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1)(a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 , (b) or (c) is carried out\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 did not carry on any business through or from a permanent establishment in Hong Kong;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 falls within either of the following descriptions\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 it did not hold (whether directly or indirectly) share capital (however described) in one or more private companies carrying on any business through or from a permanent establishment in Hong Kong;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 it held such share capital, but the aggregate value of the holding of the capital is equivalent to not more than 10% of the value of its own assets; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 falls within either of the following descriptions\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 it neither held immovable property in Hong Kong, nor held (whether directly or indirectly) share capital (however described) in one or more private companies with direct or indirect holding of immovable property in Hong Kong;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 it held such immovable property or share capital (or both), but the aggregate value of the holding of the property and capital is equivalent to not more than 10% of the value of its own assets;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-480\li1200\sl260{{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 interposed special purpose vehicle}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u20013??\u38291??\u29305??\u23450??\u30446??\u30340??\u24037??\u20855??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 in relation to a special purpose vehicle that has an indirect beneficial interest in an excepted private company through an interposed person that is a special purpose vehicle, means the interposed person;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 in relation to a special purpose vehicle that has an indirect beneficial interest in an excepted private company through a series of 2 or more interposed persons that are special purpose vehicles, means any of the interposed persons;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-480\li1200\sl260{{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 permanent establishment}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u24120??\u35373??\u27231??\u27083??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\u8212??see }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 20ACB}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-480\li1200\sl260{{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 private company}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u31169??\u20154??\u20844??\u21496??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ) means a company incorporated in or outside Hong Kong that is not allowed to issue any invitation to the public to subscribe for any shares or debentures of the company;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-480\li1200\sl260{{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 special purpose vehicle}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u29305??\u23450??\u30446??\u30340??\u24037??\u20855??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ) means a corporation, partnership, trustee of a trust estate or any other entity that\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 is wholly or partially owned by a non-resident person;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 is established solely for the purpose of holding, directly or indirectly, and administering one or more excepted private companies;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 is incorporated, registered or appointed in or outside Hong Kong;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 does not carry on any trade or activities except for the purpose of holding, directly or indirectly, and administering one or more excepted private companies; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (e)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 is not itself an excepted private company.\par }}\pard\plain\nosnaplinegrid\b0\i\fs22\qr\sb0\sa80\li720\sl260{{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 13 of 2015 s. 5}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 )\par }}
