te;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the licence was terminated before that expiry date; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the Commissioner is of the opinion that, having regard to the early termination of the licence, the consideration for the purchase is not reasonable consideration in the circumstances of the case.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 No deduction is allowable under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 16E}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  or }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 16EA}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  in respect of any relevant right purchased by a person wholly or partly from an associate.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (3)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 For the purposes of subsection (2), any relevant right that is purchased or sold by a trustee of a trust estate or a corporation controlled by the trustee is deemed to have been purchased or sold by each of the trustee, the corporation and the beneficiary under the trust.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (4)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 No deduction is allowable under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 16E}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  or }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 16EA}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  in respect of any relevant right purchased by a person (}{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 taxpayer}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ) if at a time when the relevant right is owned by the taxpayer, a person holds rights as a licensee under a licence of the relevant right, and\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the relevant right was, before it was purchased by the taxpayer, owned and used by that person (whether alone or with others) or any associate of that person (which person or any such associate is referred to in this section as }{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the end-user}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 );\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the relevant right is, while the licence is in force, used wholly or principally outside Hong Kong by a person other than the taxpayer; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub