\pard\plain \ltrpar\ql \li0\ri0\nowidctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1779345 \rtlch\fcs1 \af0\afs24\alang1025 \ltrch\fcs0 \fs24\lang1033\langfe1033\kerning2\loch\af0\hich\af0\dbch\af14\cgrid\langnp1033\langfenp1033 {\*\latentstyles\lsdstimax267\lsdlockeddef0\lsdsemihiddendef1\lsdunhideuseddef1\lsdqformatdef0\lsdprioritydef99{\lsdlockedexcept \lsdsemihidden0 \lsdunhideused0 \lsdqformat1 \lsdpriority0 \lsdlocked0 Normal;}}\pard\plain\nosnaplinegrid\b\i0\fs22\qj\sb240\sa80\keepn\fi-720\li720\tx960\sl260{{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 18B.}{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Basis for computing assessable profit for years of assessment commencing on 1 April 1975\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Subject to subsection (2) and to }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 sections 18C}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 , }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 18D}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 18E}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 , the assessable profits for any year of assessment commencing on or after 1 April 1975 from any trade, profession or business carried on in Hong Kong shall be computed on the full amount of the profits therefrom arising in or derived from Hong Kong during the year of assessment. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Subject to }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 sections 18C}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 , }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 18D}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 18E}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 , where the Commissioner is satisfied that the accounts of a trade, profession or business carried on in Hong Kong are made up to some day other than 31 March, he may direct that the assessable profits from that source for any year of assessment be computed on the full amount of profits therefrom arising in or derived from Hong Kong during the year ending on that day in the year of assessment. \par }}\pard\plain\nosnaplinegrid\b0\i\fs22\qr\sb0\sa80\li720\sl260{{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 7 of 1975 s. 12}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 . Amended }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 7 of 1986 s. 12}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 )\par }}
