\pard\plain \ltrpar\ql \li0\ri0\nowidctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1779345 \rtlch\fcs1 \af0\afs24\alang1025 \ltrch\fcs0 \fs24\lang1033\langfe1033\kerning2\loch\af0\hich\af0\dbch\af14\cgrid\langnp1033\langfenp1033 {\*\latentstyles\lsdstimax267\lsdlockeddef0\lsdsemihiddendef1\lsdunhideuseddef1\lsdqformatdef0\lsdprioritydef99{\lsdlockedexcept \lsdsemihidden0 \lsdunhideused0 \lsdqformat1 \lsdpriority0 \lsdlocked0 Normal;}}\pard\plain\nosnaplinegrid\b\i0\fs22\qj\sb240\sa80\keepn\fi-720\li720\tx960\sl260{{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 35B.}{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Buildings and structures bought unused\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where capital expenditure is incurred on the construction of a building or structure and, before that building or structure is used, the relevant interest therein is sold\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the expenditure actually incurred on the construction thereof shall be left out of account for the purposes of this Part and any initial allowance made under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 34}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  shall be disallowed and such additional assessments as may be necessary consequent thereon shall be made; but\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1680\li2160\tqr\tx1440\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 in a case where the person who sells that interest incurred that expenditure and made that sale in the course of a trade which consists, in whole or part, in the construction or development of buildings or structures for the purpose of sale, the person who buys that interest shall be deemed for those purposes to have incurred, on the date when the purchase price becomes payable, capital expenditure on the construction thereof equal to the net price paid by him for that interest; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 in any other case, the person who buys that interest shall be deemed for those purposes to have incurred, on the date when the purchase price becomes payable, capital expenditure on the construction thereof equal to the expenditure actually incurred on the construction of the building or structure or to the net price paid by him for that interest, whichever is the less:}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (Replaced }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 29 of 1982 s. 7}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li1680\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 Provided that\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 where in a case to which paragraph }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (b)(i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0  applies the relevant interest in the building or structure is sold more than once before the building or structure is used, only the person who buys that interest on the occasion of the last of those sales shall be deemed to have incurred capital expenditure on the construction of the building or structure and that capital expenditure shall be equal to the net price paid on the first sale or the net price paid by him, whichever is the less;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 where in a case to which paragraph }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (b)(ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0  applies the relevant interest in the building or structure is sold more than once before the building or structure is used, that paragraph shall have effect only in relation to the last of those sales.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (Replaced }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 29 of 1982 s. 7}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i\fs22\qr\sb0\sa80\li720\sl260{{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 2 of 1971 s. 27}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 )\par }}
