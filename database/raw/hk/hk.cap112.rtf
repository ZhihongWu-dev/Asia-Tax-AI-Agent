\pard\plain \ltrpar\ql \li0\ri0\nowidctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1779345 \rtlch\fcs1 \af0\afs24\alang1025 \ltrch\fcs0 \fs24\lang1033\langfe1033\kerning2\loch\af0\hich\af0\dbch\af14\cgrid\langnp1033\langfenp1033 {\*\latentstyles\lsdstimax267\lsdlockeddef0\lsdsemihiddendef1\lsdunhideuseddef1\lsdqformatdef0\lsdprioritydef99{\lsdlockedexcept \lsdsemihidden0 \lsdunhideused0 \lsdqformat1 \lsdpriority0 \lsdlocked0 Normal;}}\pard\plain\nosnaplinegrid\b\i0\fs22\qj\sb240\sa80\keepn\fi-720\li720\tx960\sl260{{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 20AD.}{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Loss from transactions referred to in }{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 sections 20AC(1)}{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  and }{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 20ACA(1)}{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  not available for set off\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Despite anything in this Part\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 any loss sustained by a non-resident person from a transaction referred to in }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 20AC(1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  in a year of assessment in which the non-resident person has not at any time carried on any trade, profession or business in Hong Kong involving any transaction other than a transaction referred to in that section, is not available for set off against any of the person\u8217??s assessable profits for any subsequent year of assessment; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 any loss sustained by a special purpose vehicle as defined by }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 20ACA(2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  from a transaction referred to in }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 20ACA(1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  in a year of assessment in which the special purpose vehicle has not at any time carried on any trade, profession or business in Hong Kong involving any transaction other than a transaction referred to in }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 20ACA(1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 , is not available for set off against any of its assessable profits for any subsequent year of assessment.\par }}\pard\plain\nosnaplinegrid\b0\i\fs22\qr\sb0\sa80\li720\sl260{{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 (Replaced }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 13 of 2015 s. 6}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 )\par }}
