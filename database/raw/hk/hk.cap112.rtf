ersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 48 of 1995 s. 9}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 all assets which the person or his spouse possessed in Hong Kong, including any possessed jointly or severally with any other person, at such times as may be specified in the notice; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 all liabilities to which the person or his spouse was subject in Hong Kong, including any to which he was subject jointly or severally with any other person, at such times as may be specified in the notice; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 all expenditure or disbursements from funds in Hong Kong, including remittances to places outside Hong Kong and gifts, incurred or made by the person or his spouse during such periods as may be specified in the notice; and}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 23 of 1998 s. 2}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 all sums, including remittances, gifts and legacies received in Hong Kong by the person or his spouse during such periods as may be specified in the notice.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 71 of 1983 s. 26}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 7 of 1986 s. 12}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1A)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 For the purposes of subsection (1), engaging a service provider under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 51AAD(1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  does not in itself constitute a reasonable excuse. }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 18 of 2021 s. 9}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 A notice given under subsection (1) shall not specify any time or period earlier than 7 years before the commencement of the year of assessment in which it is given.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (3)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 An application for the consent of the Board of Review shall be made in writing by the Commissioner to the clerk of the Board and shall be accompanied by a statement of the material on the basis of which it is proposed to exercise the powers of the Commissioner or deputy commissioner under subsection (1).\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (4)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Upon receipt of an application under subsection (3), the Chairman of the Board of Review shall appoint 3 members from the panel of the Board of Review, one of whom shall be the Chairman or a deputy chairman, to consider the application.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (5)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 When the Board is considering an application, the Commissioner or his authorized representative may attend, but the person in respect of whom the application is made may not attend.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (6)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Subject to subsection (7), neither in the application nor on the consideration thereof shall the identity of the person in respect of whom the application is made be revealed to the Board of Review.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (7)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 If the person on whom a notice under subsection (1) has been given so requests, the Commissioner shall furnish him with a certificate from the Chairman or deputy chairman of the Board of Review certifying that the Board\u8217??s consent to the issue of the notice was given, and for the purpose of obtaining such a certificate the Commissioner shall reveal to the Chairman or deputy chairman the identity of that person.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (8)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 The decision of the Board of Review to grant or refuse consent shall be final.\par }}\pard\plain\nosnaplinegrid\b0\i\fs22\qr\sb0\sa80\li720\sl260{{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 26 of 1969 s. 28}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 . Amended }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 40 of 1972 s. 5}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 43 of 1975 s. 3}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 )\par }}
