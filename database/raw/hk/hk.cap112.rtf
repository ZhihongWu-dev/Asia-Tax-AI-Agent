lain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-480\li1200\sl260{{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 UTPR jurisdiction}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u20302??\u31237??\u21033??\u28516??\u35215??\u21063??\u36676??\u21312??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ) means a jurisdiction that has a qualified UTPR in force.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-480\li1200\sl260{{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 UTPR percentage}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u20302??\u31237??\u21033??\u28516??\u35215??\u21063??\u30334??\u20998??\u29575??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ) means the percentage of total UTPR top-up tax amount that is allocated to a UTPR jurisdiction in accordance with the formula provided in 2.6.1.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-480\li1200\sl260{{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 UTPR top-up tax amount}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u20302??\u31237??\u21033??\u28516??\u35215??\u21063??\u35036??\u36275??\u31237??\u38989??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ) means the amount of top-up tax allocated to a UTPR jurisdiction under the UTPR.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 10.2. Definitions of flow-through entity, tax transparent entity, reverse hybrid entity, and hybrid entity\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 10.2.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 An entity is a }{\b\i\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 flow-through entity}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  to the extent it is fiscally transparent with respect to its income, expenditure, profit or loss in the jurisdiction where it was created unless it is tax resident and subject to a covered tax on its income or profit in another jurisdiction.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 A flow-through entity is a }{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 tax transparent entity}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  with respect to its income, expenditure, profit or loss to the extent that it is fiscally transparent in the jurisdiction in which its owner is located.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 A flow-through entity is a }{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 reverse hybrid entity}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  with respect to its income, expenditure, profit or loss to the extent that it is not fiscally transparent in the jurisdiction in which the owner is located.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 10.2.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 An entity is treated as fiscally transparent under the laws of a jurisdiction, if that jurisdiction treats the income, expenditure, profit or loss of that entity as if it were derived or incurred by the direct owner of that entity in proportion to its interest in that entity.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 10.2.3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 An ownership interest in an entity or a permanent establishment that is a constituent entity shall be treated as held through a }{\b\i\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 tax transparent structure}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  if that ownership interest is held indirectly through a chain of tax transparent entities.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 10.2.4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 A constituent entity that is not a tax resident and not subject to a covered tax or a qualified domestic minimum top-up tax based on its place of management, place of creation, or similar criteria shall be treated as a flow-through entity and a tax transparent entity in respect of its income, expenditure, profit or loss to the extent that:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 its owners are located in a jurisdiction that treats the entity as fiscally transparent;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 it does not have a place of business in the jurisdiction where it was created; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the income, expenditure, profit or loss is not attributable to a permanent establishment.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 10.2.5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 An entity that is treated as a separate taxable person for income tax purposes in the jurisdiction where it is located is a }{\b\i\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 hybrid entity}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0  with respect to its income, expenditure, profit or loss to the extent that it is fiscally transparent in the jurisdiction in which its owner is located.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 10.3. Location of an entity and a permanent establishment\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 10.3.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The location of an entity that is not a flow-through entity is determined as follows:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 if it is a tax resident in a jurisdiction based on its place of management, place of creation or similar criteria, it is located in that jurisdiction; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 in other cases, it is located in the jurisdiction in which it was created.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Note\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Section 2(11)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0  is relevant in determining whether an entity is a tax resident in Hong Kong.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 10.3.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The location of an entity that is a flow-through entity is determined as follows:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 if it is the ultimate parent entity of the MNE group or it is required to apply an IIR in accordance with Article 2.1, it is located in the jurisdiction where it was created; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 in other cases, it shall be treated as a stateless entity.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 10.3.3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The location of a permanent establishment is determined as follows:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 if it is described in paragraph (a) of the definition in Article 10.1, is located in the jurisdiction where it is treated as a permanent establishment and is taxed under the applicable tax treaty in force;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 if it is described in paragraph (b) of the definition in Article 10.1, is located in the jurisdiction where it is subject to net basis taxation based on its business presence;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 if it is described in paragraph (c) of the definition in Article 10.1, is located in the jurisdiction where it is situated; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 if it is described in paragraph (d) of the definition in Article 10.1, is considered as a stateless permanent establishment.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 10.3.4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where by reason of Article 10.3.1, a constituent entity is located in more than one jurisdiction (a dual-located entity), then its status for purposes of the GloBE rules shall be determined as follows:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 if it is located in two jurisdictions that have an applicable tax treaty in force:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 it shall be located in the jurisdiction where it is considered as a deemed resident for purposes of the tax treaty;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 if the tax treaty requires the competent authorities to reach a mutual agreement on the deemed residence of the constituent entity for purposes of the tax treaty and no agreement exists, then paragraph (b) shall apply;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (iii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 if the tax treaty does not provide relief or exemption from tax because the constituent entity is a tax resident of both contracting parties, then paragraph (b) shall apply;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 if no tax treaty applies, then its location shall be determined as follows:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 it shall be located in the jurisdiction where it paid the greater amount of covered taxes for the fiscal year, without considering the ones paid in accordance with a controlled foreign company tax regime;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 if the amount of covered taxes paid in both jurisdiction is the same or zero, it shall be located in the jurisdiction where it has the greater amount of substance-based income exclusion computed on an entity basis in accordance with Article 5.3;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (iii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 if the amount of the substance-based income exclusion in both jurisdictions is the same or zero, then it is considered a stateless constituent entity unless it is the ultimate parent entity of the MNE group in which case it shall be located in the jurisdiction where it was created.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Note\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 In relation to Article 10.3.4, see the specified OECD GloBE rules guidance in }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 paragraphs 198}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0  and }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 207}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0  of Chapter 10 of the 2023 Commentary.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 10.3.5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where, under Article 10.3.4, a dual-located entity that is a parent entity is located in a jurisdiction where it is not subject to a qualified IIR, then the other jurisdiction can require such entity to apply its qualified IIR unless it is restricted by an applicable tax treaty in force.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 10.3.6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where an entity has changed its location during the fiscal year, it shall be located in the jurisdiction where it was located at the beginning of that year.\par }}\pard\plain\nosnaplinegrid\b\i0\fs28\qc\sb240\sa80\li0\sl320{{\b\i0\nosupersub\nosupersub\fs28\qc\qc\li0\cf1 \f0 Part 2\par }}\pard\plain\nosnaplinegrid\b\i0\fs28\qc\sb240\sa80\keepn\li0\sl320{{\b\i0\nosupersub\nosupersub\fs28\qc\qc\li0\cf1 \f0 Modifications to Rules in }{\b\i0\nosupersub\nosupersub\fs28\qc\qc\li0\cf1 \f0 Part 1}{\b\i0\nosupersub\nosupersub\fs28\qc\qc\li0\cf1 \f0  of this Schedule\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\c