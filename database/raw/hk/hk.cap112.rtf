\pard\plain \ltrpar\ql \li0\ri0\nowidctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1779345 \rtlch\fcs1 \af0\afs24\alang1025 \ltrch\fcs0 \fs24\lang1033\langfe1033\kerning2\loch\af0\hich\af0\dbch\af14\cgrid\langnp1033\langfenp1033 {\*\latentstyles\lsdstimax267\lsdlockeddef0\lsdsemihiddendef1\lsdunhideuseddef1\lsdqformatdef0\lsdprioritydef99{\lsdlockedexcept \lsdsemihidden0 \lsdunhideused0 \lsdqformat1 \lsdpriority0 \lsdlocked0 Normal;}}\pard\plain\nosnaplinegrid\b\i0\fs22\qj\sb240\sa80\keepn\fi-720\li720\tx960\sl260{{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 18C.}{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Commencement of source of profits in years of assessment commencing on or after 1 April 1974\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Subject to subsection (2) where a person commences to carry on a trade, profession or business in Hong Kong within any year of assessment commencing on or after 1 April 1974 and the Commissioner is satisfied that the first accounts of such trade, profession or business after its commencement are made up to some day other than 31 March, the assessable profits from that source for that year of assessment shall\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 if the first accounts are made up to a day within that year of assessment, be computed on the full amount of the profits from that source arising in or derived from Hong Kong during the period beginning on the day of commencement and ending on the day to which the accounts are made up; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 if the first accounts are for a period in excess of a year and are made up to a day within a year of assessment following that in which the commencement occurred, be computed on such basis as the Commissioner thinks fit.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 7 of 1986 s. 12}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Where the first accounts of a trade, profession or business commenced in any year of assessment commencing on or after 1 April 1974 are for a period of 1 year or less and are made up to a day within the year of assessment following that in which the commencement occurred, there shall be deemed to be no assessable profits for the year of assessment in which the commencement occurred.\par }}\pard\plain\nosnaplinegrid\b0\i\fs22\qr\sb0\sa80\li720\sl260{{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 7 of 1975 s. 12}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 )\par }}
