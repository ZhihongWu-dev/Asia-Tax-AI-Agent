1 \f0 any loss set off under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 12A}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  in calculating the net assessable income, or net assessable incomes, on which that net chargeable income is based, shall be added;}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 71 of 1983 s. 31}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)(i))\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 any loss which may be set off under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 12A}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  in the year of assessment shall be set off against that amount:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li1200\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Provided that\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Repealed }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 20 of 2018 s. 4}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 in no case shall the amount of provisional salaries tax charged under this subsection exceed the amount which would have been chargeable had the standard rate been charged on the whole of\u8212?? }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 20 of 2018 s. 4}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (A)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 the net assessable income for the preceding year of assessment as reduced by such deductions as are under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 Part 4A}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0  allowable to that person; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (B)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 in the case of a husband and wife to whom }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 section 63B(2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0  applies, the aggregate of their net assessable incomes for the preceding year of assessment as reduced by such deductions as are under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 Part 4A}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0  allowable to them.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (Replaced }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 43 of 1989 s. 21}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 . Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 31 of 1998 s. 19}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1A)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Repealed }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 43 of 1989 s. 21}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1B)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 In computing the amount of provisional salaries tax for a year of assessment, any credit or deduction allowed under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 50}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  for the preceding year of assessment is to be taken into account. }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 17 of 2022 s. 8}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 If a person commences to derive income from a source on a day within any year of assessment, an assessor may estimate the sum in respect of which provisional salaries tax is payable in that year and the succeeding year of assessment.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 71 of 1983 s. 31}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (3)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 If a person ceases to derive income from a source within any year of assessment an assessor may estimate the sum in respect of which provisional salaries tax is payable for that year of assessment and for the year preceding that year of assessment.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 71 of 1983 s. 31}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (4)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 If a person is liable to pay provisional salaries tax, an assessor shall, as soon as may be after the expiration of the time limited by the notice requiring that person to furnish a return under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 51(1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 , assess or estimate the amount of the provisional salaries tax which he is liable to pay.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (5)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Notwithstanding subsection (4), an assessor may assess or estimate the amount of provisional salaries tax which any person is liable to pay if he is of the opinion that the person is about to leave Hong Kong or that for any other reason it is expedient to do so.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 7 of 1986 s. 12}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (6)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 When an assessor has assessed or estimated the amount of provisional salaries tax which a person is liable to pay, the Commissioner shall give a notice to that person stating the amount of provisional salaries tax to be paid, and such due date for payment thereof as may be fixed by the Commissioner.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (6A)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Where in any year of assessment a notice for payment of provisional salaries tax has been given under subsection (6) and thereafter any rate specified in }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Schedule 2}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 , or any allowance provided for in }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Part 5}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 , for that year of assessment is amended, the amount of provisional salaries tax stated in the notice shall nevertheless be payable.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 32 of 1981 s. 9}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 . Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 43 of 1989 s. 21}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (