\pard\plain \ltrpar\ql \li0\ri0\nowidctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1779345 \rtlch\fcs1 \af0\afs24\alang1025 \ltrch\fcs0 \fs24\lang1033\langfe1033\kerning2\loch\af0\hich\af0\dbch\af14\cgrid\langnp1033\langfenp1033 {\*\latentstyles\lsdstimax267\lsdlockeddef0\lsdsemihiddendef1\lsdunhideuseddef1\lsdqformatdef0\lsdprioritydef99{\lsdlockedexcept \lsdsemihidden0 \lsdunhideused0 \lsdqformat1 \lsdpriority0 \lsdlocked0 Normal;}}\pard\plain\nosnaplinegrid\b\i0\fs22\qj\sb240\sa80\keepn\fi-720\li720\tx960\sl260{{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 34.}{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Initial and annual allowances, industrial buildings and structures\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Where a person incurs capital expenditure on the construction of a building or structure which is to be an industrial building or structure occupied for the purposes of a trade there shall be made to the person who incurred the expenditure for the year of assessment in the basis period for which the expenditure was incurred an allowance to be known as an \u8220??initial allowance\u8221?? equal to one-fifth thereof:}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 30 of 1950 }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Schedule; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 35 of 1965 s. 17}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li1200\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Provided that\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 no initial allowance shall be made for the 8 successive years of assessment commencing on 1 April in each of the years 1957 to 1964;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 where any initial allowance has been made in relation to capital expenditure on a building or structure under this subsection before such building or structure comes to be used and when it first comes to be used it is not an industrial building or structure, such allowance shall be disallowed and such additional assessments as may be necessary consequent thereon shall be made.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Replaced }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 35 of 1965 s. 17}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1680\li1680\tqr\tx960\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 Where any person is, at the end of the basis period for any year of assessment, entitled to an interest in a building or structure which is an industrial building or structure and where that interest is the relevant interest in relation to the capital expenditure incurred on the construction of that building or structure, an allowance for depreciation by wear and tear, to be known as an \u8220??annual allowance\u8221??, of an amount equal to, subject to paragraphs (b), (ba) and (bb), one-twenty-fifth of that expenditure, is to be made to him for that year of assessment.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 36 of 1955 s. 41}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 35 of 1965 s. 17}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 *}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 Where the interest in the building or structure mentioned in paragraph (a) is sold to the person mentioned in that paragraph in the basis period for a year of assessment before the year of assessment beginning on 1 April 2024 (}{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 pre-2024 basis period}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ), and where the building or structure has been used at any time before the sale, whether as an industrial building or structure or otherwise, the annual allowance, in the years of assessment the basis periods for which end after the time of that sale, is to be computed by reference to the residue of expenditure immediately after the sale and is to be the fraction of the said residue the numerator of which is 2, where the building or structure was first used before the commencement of the basis period for the year of assessment commencing on 1 April 1965 (}{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 1965 basis period}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ), and one, where the building or structure was first used on or after the commencement of the 1965 basis period, and the denominator of which is the number of years of assessment comprised in the period which\u8212??\u160??\u160??}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 12 of 2004 s. 11}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 34 of 2024 s. 5}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\super\fs22\qj\qj\li2160\cf1 \f0 #}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 begins with the year of assessment in the basis period for which the sale takes place; and}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (Replaced }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 12 of 2004 s. 11}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 ends with the capped year, and so on for any subsequent sale that takes place in a pre-2024 basis period.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (Replaced }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 35 of 1965 s. 17}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ba)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 If\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 the interest in the building or structure mentioned in paragraph (a) is sold to the person mentioned in that paragraph in the basis period for a year of assessment (}{\b\i\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 sale year}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 )\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2640\tqr\tx2400\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 (A)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 after the capped year; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2640\tqr\tx2400\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 (B)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 before the year of assessment beginning on 1 April 2024 (}{\b\i\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 2024/25 year}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 );\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 the building or structure has been used at any time before the sale, whether as an industrial building or structure or otherwise; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (iii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 the residue of expenditure immediately after the sale is not 0, but no allowance has ever been made under paragraph (a) (as modified by paragraph (b)) for the sale year and all subsequent years of assessment up to and including the year of assessment beginning on 1 April 2023 because at the time of the sale\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2640\tqr\tx2400\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 (A)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 where the building or structure was first used before the commencement of the 1965 basis period\u8212??50 or more years of assessment have passed after the year of assessment in which the building or structure was first used; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2640\tqr\tx2400\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 (B)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2640\cf1 \f0 where the building or structure was first used on or after the commencement of the 1965 basis period\u8212??25 or more years of assessment have passed after the year of assessment in which the building or structure was first used,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li1680\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 then despite paragraph (b), the annual allowance, in the 2024/25 year and any year of assessment after that, is to be an amount equal to 4% of the residue of expenditure. }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 34 of 2024 s. 5}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nos