tes (}{\b\i\nosupersub\nosupersub\fs18\qj\qj\li1600\cf1 \f0 operating jurisdiction}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1600\cf1 \f0 ), the constituent entities of the group; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1600\tqr\tx1360\sl220{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1600\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1600\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1600\cf1 \f0 for each operating jurisdiction\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2080\tqr\tx1840\sl220{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2080\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2080\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2080\cf1 \f0 determine for each constituent entity operating there\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2560\tqr\tx2320\sl220{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2560\cf1 \f0 (A)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2560\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2560\cf1 \f0 its income (or loss) for the purposes of the OECD GloBE model rules; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2560\tqr\tx2320\sl220{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2560\cf1 \f0 (B)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2560\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2560\cf1 \f0 the tax attributable to the income for the purposes of the OECD GloBE model rules;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2080\tqr\tx1840\sl220{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2080\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2080\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2080\cf1 \f0 determine\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2560\tqr\tx2320\sl220{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li2560\cf1 \f0 (A)}{\b0\i0\nosupersub\nosupersub\fs22\q