\pard\plain \ltrpar\ql \li0\ri0\nowidctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1779345 \rtlch\fcs1 \af0\afs24\alang1025 \ltrch\fcs0 \fs24\lang1033\langfe1033\kerning2\loch\af0\hich\af0\dbch\af14\cgrid\langnp1033\langfenp1033 {\*\latentstyles\lsdstimax267\lsdlockeddef0\lsdsemihiddendef1\lsdunhideuseddef1\lsdqformatdef0\lsdprioritydef99{\lsdlockedexcept \lsdsemihidden0 \lsdunhideused0 \lsdqformat1 \lsdpriority0 \lsdlocked0 Normal;}}\pard\plain\nosnaplinegrid\b\i0\fs22\qj\sb240\sa80\keepn\fi-720\li720\tx960\sl260{{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 51B.}{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Power to issue search warrant\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 If the Commissioner, or an officer of the Inland Revenue Department not below the rank of chief assessor authorized in writing by the Commissioner for the purpose (in this section referred to as }{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the authorized officer}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ), satisfies a magistrate, by statement made on oath,\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 that there are reasonable grounds for suspecting that a person has made an incorrect return or supplied false information having the effect of understating his income or profits chargeable to tax and has done so without reasonable excuse and not through an innocent oversight or omission; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 that a person has failed to comply with an order of a court made under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 80(1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  or (2A) directing him to comply with the requirements of a notice given to him under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 51(1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  or (3), }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 56 of 1993 s. 22}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li1200\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the magistrate may by warrant authorize the Commissioner or authorized officer to exercise the following powers\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 without previous notice at any reasonable time during the day, to enter and have free access to any land, buildings, or place where he suspects there to be any books, records, accounts or documents of that person, or of any other person, which may afford evidence material in assessing the liability of the first-mentioned person for tax, and there to search for and examine any books, records, accounts or documents; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 43 of 1975 s. 4}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 in carrying out any such search, to open or cause to be removed and opened, any article in which he suspects any books, records, accounts or documents to be contained;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (iii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 to take possession of any books, records, accounts or documents of that person or that person\u8217??s spouse, and to make copies of such parts of any books, records, accounts or documents of any other person, as may afford evidence material in assessing the liability of the first-mentioned person for tax; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Replaced }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 43 of 1975 s. 4}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 . Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 71 of 1983 s. 27}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (iv)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 to retain any such books, records, accounts or documents for as long as they may be reasonably required for any assessment to be made or for any proceedings under this Ordinance to be completed:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li1680\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 Provided that if the Commissioner or authorized officer shall retain any book, record, account or document for a period of more than 14 days, the person aggrieved may apply in writing to the Board of Review for an order directing the return thereof and the Board of Review, after hearing the applicant or his authorized representative and the Commissioner or his representative, may so order, either unconditionally or subject to any condition which the Board may consider it proper to impose. }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 7 of 1975 s. 34}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1AAAA)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 For the purposes of subsection (1)(a), engaging a service provider under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 51AAD(1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  does not in itself constitute a reasonable excuse. }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 18 of 2021 s. 10}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1AAA)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 If the Commissioner or authorized officer satisfies a magistrate, by statement made on oath\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 that a reporting financial institution or its service provider (if any) has failed to comply with an order of a court made under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 80B(3)(a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  or }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 80D(9)(a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  directing the institution or its service provider (if any) to comply with a requirement under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 50C(1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ; or \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 that there are reasonable grounds for suspecting that a reporting financial institution or its service provider (if any) has failed to comply with }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 50B(1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  or (2) or 50C(1) and has done so without reasonable excuse and not through an innocent oversight or omission,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li1200\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the magistrate may by warrant authorize the Commissioner or authorized officer to exercise the powers specified in subsection (1AAAB). }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 22 of 2016 s. 6}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1AAAB)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 The powers are for the Commissioner or authorized officer\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 without previous notice at any reasonable time during the day, to enter and have free access to any land, buildings, or place where the Commissioner or authorized officer suspects there to be any articles or data of the reporting financial institution or its service provider (if any), or of any other person, that may afford evidence material in assessing\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 the liability of the institution or its service provider (if any) under this Ordinance; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 the liability of any other person for tax of a reportable jurisdiction,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li1680\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 and there to search for and examine such articles or data;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 in carrying out any such search, to open or cause to be removed and opened, any article which the Commissioner or authorized officer suspects to be containing any articles or data;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 to\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 take possession of any articles or data of the reporting financial institution or its service provider (if any); and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li2160\tqr\tx1920\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 (ii)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li2160\cf1 \f0 make copies of such parts of any articles or data of any other person, as may afford evidence material in assessing the liability of the institution or its service provider (if any) under this Ordinance or the liability of any other person for tax of a reportable jurisdiction;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 to retain any such articles or data for as long as they may be reasonably required for any assessment to be made or for any proceedings under this Ordinance to be completed. }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 22 of 2016 s. 6}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1AAAC)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 If the Commissioner or authorized officer retains any articles or data for a period of more than 14 days, the person aggrieved may apply in writing to the Board of Review for an order directing the return of such articles or data, and the Board, after hearing the applicant or the applicant\u8217??s authorized representative and the Commissioner or the Commissioner\u8217??s representative, may so order, either unconditionally or subject to any condition that the Board considers proper to impose. }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 22 of 2016 s. 6}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1AAAD)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 If, on entering the land, buildings or place under the warrant issued under subsection (1AAA), an authorized officer is of the opinion that the reporting financial institution or service provider is likely to fail to carry out the obligations under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 50B(1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  or (2) or 50C(1), the Commissioner or authorized officer may give notice to the institution or service provider requiring it, within a reasonable time and in a manner specified in the notice, to take any action as specified in the notice that is necessary for rectifying its compliance system and process as defined by }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 51BA(1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 . }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 22 of 2016 s. 6}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1AAAE)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 In subsections (1AAAB) and (1AAAC), references to articles or data are references to books, records, accounts or documents, or any information or data of the compliance system and process as defined by }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 51BA(1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 . }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 22 of 2016 s. 6}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1AA)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Subsection (1) also applies to any tax (referred to in this subsection as }{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the tax concerned}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ) of a territory outside Hong Kong if\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 arrangements having effect under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 49(1A)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  are made with the government of that territory; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 the tax concerned is the subject of a provision of the arrangements that requires disclosure of information concerning tax of that territory,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li1200\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 and, for the purposes of the application of subsection (1) under this subsection, a reference to a person\u8217??s income or profits chargeable to tax in subsection }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1)(a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  is to be construed as a reference to a person\u8217??s income or profits chargeable to the tax concerned or any other sums or values in respect of which a person is chargeable to the tax concerned, and a reference to a person\u8217??s liability for tax in subsection }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1)(i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  and (iii) is to be construed as a reference to a person\u8217??s liability for the tax concerned. }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 1 of 2010 s. 6}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 . Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 9 of 2013 s. 6}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1A)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Any officer of the Inland Revenue Department under the direction of the Commissioner or an authorized officer may assist the Commissioner or an authorized officer in the execution of a warrant issued under subsection (1) or (1AAA) and may exercise any of the powers referred to in subsection }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1)(i)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 , (ii) and (iii) or }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1AAAB)(a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 , (b) and (c). }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 40 of 1972 s. 6}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 When exercising any power under subsection (1) or (1AAAB), the Commissioner or authorized officer shall produce on demand the warrant issued to him under that subsection. \par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (3)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 The person to whose affairs any books, records, accounts or documents, or any information or data of a compliance system and process as defined by }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 section 51BA(1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 , as the case requires, taken possession of under subsection (1) or (1AAAB) relate shall be entitled to examine and make extracts from them at such times and under such conditions as the Commissioner may determine.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (4)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Any person who obstructs or hinders the Commissioner or an authorized officer acting in the discharge of his duty under subsection (1) or (1AAAB) or an officer assisting him under subsection (1A) commits an offence and is liable on conviction to a fine at level 3 and imprisonment for 6 months. }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 56 of 1993 s. 22}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 L.N. 338 of 1995}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 4 of 2010 s. 8}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i\fs22\qr\sb0\sa80\li720\sl260{{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 26 of 1969 s. 28}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 . Amended }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 40 of 1972 s. 6}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 )\par }}
