0 where at least 95% of the value of the entity is owned (directly or through a chain of excluded entities) by one or more excluded entities referred to in Article 1.5.1 (other than a pension services entity) and where that entity:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 i.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 operates exclusively or almost exclusively to hold assets or invest funds for the benefit of the excluded entity or entities; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ii.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 only carries out activities that are ancillary to those carried out by the excluded entity or entities; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 where at least 85% of the value of the entity is owned (directly or through a chain of excluded entities), by one or more excluded entities referred to in Article 1.5.1 (other than a pension services entity) provided that substantially all of the entity\u8217??s income is excluded dividends or excluded equity gain or loss that is excluded from the computation of GloBE income or loss in accordance with Articles 3.2.1(b) or (c).\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Notes\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 1.\u160??\u160??}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 In relation to Article 1.5.2, see the specified OECD GloBE rules guidance in\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 paragraph 43}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 .1 of Chapter 1 of the 2023 Commentary; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 section 1}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 .5 of the Feb-2023 Administrative Guidance.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 2.\u160??\u160??}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 In relation to Article 1.5.2(a), see the specified OECD GloBE rules guidance in paragraph 45 of Chapter 1 of the 2023 Commentary.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 3.\u160??\u160??}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 In relation to Article 1.5.2(a)i, see the specified OECD GloBE rules guidance in\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 paragraph 54}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 .1 of Chapter 1 of the 2023 Commentary; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 section 1}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 .5 of the Feb-2023 Administrative Guidance.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 4.\u160??\u160??}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1200\cf1 \f0 In relation to Article 1.5.2(a)ii, see the specified OECD GloBE rules guidance in\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 paragraphs 54}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 .2 to 54.5 of Chapter 1 of the 2023 Commentary; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa0\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 section 1}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li1680\cf1 \f0 .6 of the Feb-2023 Administrative Guidance.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??1.5.3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 A filing constituent entity may elect not to treat an entity as an excluded entity under Article 1.5.2. An election under this Article is a five-year election.\par }}\pard\plain\nosnaplinegrid\b\i0\fs28\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs28\ql\ql\li240\cf1 \f0 Chapter 2 Charging Provisions\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 2.1. Application of the IIR\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.1.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 A constituent entity, that is the ultimate parent entity of an MNE group, located in Hong Kong that owns (directly or indirectly) an ownership interest in a low-taxed constituent entity at any time during the fiscal year shall pay a tax in an amount equal to its allocable share of the top-up tax of that low-taxed constituent entity for the fiscal year.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.1.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 An intermediate parent entity of an MNE group located in Hong Kong owns (directly or indirectly) an ownership interest in a low-taxed constituent entity at any time during a fiscal year shall pay a tax in an amount equal to its allocable share of the top-up tax of that low-taxed constituent entity for the fiscal year.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.1.3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Article 2.1.2 shall not apply if:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the ultimate parent entity of the MNE group is required to apply a qualified IIR for that fiscal year; or\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 another intermediate parent entity that owns (directly or indirectly) a controlling interest in the intermediate parent entity is required to apply a qualified IIR for that fiscal year.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.1.4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Notwithstanding Articles 2.1.1 to 2.1.3, a partially-owned parent entity located in Hong Kong that owns (directly or indirectly) an ownership interest in a low-taxed constituent entity at any time during the fiscal year shall pay a tax in an amount equal to its allocable share of the top-up tax of that low-taxed constituent entity for the fiscal year.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.1.5.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Article 2.1.4 shall not apply if the partially-owned parent entity is wholly owned (directly or indirectly) by another partially-owned parent entity that is required to apply a qualified IIR for that fiscal year.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.1.6.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 A parent entity located in Hong Kong shall apply the provisions of Articles 2.1.1 to 2.1.5 with respect to a low-taxed constituent entity that is not located in Hong Kong.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 2.2. Allocation of top-up tax under the IIR\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.2.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 A parent entity\u8217??s allocable share of the top-up tax of a low-taxed constituent entity is an amount equal to the top-up tax of the low-taxed constituent entity as calculated under Chapter 5 multiplied by the parent entity\u8217??s inclusion ratio for the low-taxed constituent entity for the fiscal year.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.2.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 A parent entity\u8217??s inclusion ratio for a low-taxed constituent entity for a fiscal year is the ratio of (a) the GloBE income of the low-taxed constituent entity for the fiscal year, reduced by the amount of such income attributable to ownership interests held by other owners, to (b) the GloBE income of the low-taxed constituent entity for the fiscal year.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.2.3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The amount of GloBE income attributable to ownership interests in a low-taxed constituent entity held by other owners is the amount that would have been treated as attributable to such owners under the principles of the acceptable financial accounting standard used in the ultimate parent entity\u8217??s consolidated financial statements if the low-taxed constituent entity\u8217??s net income were equal to its GloBE income and:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the parent entity had prepared consolidated financial statements in accordance with that accounting standard (the hypothetical consolidated financial statements);\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the parent entity owned a controlling interest in the low-taxed constituent entity such that all of the income and expenses of the low-taxed constituent entity were consolidated on a line-by-line basis with those of the parent entity in the hypothetical consolidated financial statements;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (c)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 all of the low-taxed constituent entity\u8217??s GloBE income were attributable to transactions with persons that are not group entities; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (d)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 all ownership interests not directly or indirectly held by the parent entity were held by persons other than group entities.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.2.4.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 In the case of a flow-through entity, GloBE income under this Article shall not include any income allocated, pursuant to Article 3.5.3, to an owner that is not a group entity.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 2.3. IIR offset mechanism\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.3.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 A parent entity that owns an ownership interest in a low-taxed constituent entity indirectly through an intermediate parent entity or a partially-owned parent entity that is not eligible for an exclusion from the IIR under Article 2.1.3 or 2.1.5 shall reduce its allocable share of a top-up tax of the low-taxed constituent entity in accordance with Article 2.3.2.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.3.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The reduction in Article 2.3.1 will be an amount equal to the portion of the parent entity\u8217??s allocable share of the top-up tax that is brought into charge by the intermediate parent entity or the partially-owned parent entity under a qualified IIR.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 2.4. Application of the UTPR\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.4.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Constituent entities of an MNE group located in Hong Kong shall be denied a deduction (or required to make an equivalent adjustment under domestic law) in an amount resulting in those constituent entities having an additional cash tax expense equal to the UTPR top-up tax amount for the fiscal year allocated to Hong Kong.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Note\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs18\qj\sb0\sa80\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Article 2.4.1 is modified by }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Part 2}{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0  of this }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 Schedule }{\b0\i0\nosupersub\nosupersub\fs18\qj\qj\li720\cf1 \f0 to suit circumstances in Hong Kong.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.4.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 [Article 2.4.2 of the OECD GloBE model rules is omitted.]\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.4.3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Article 2.4.1 shall not apply to a constituent entity that is an investment-related entity.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 2.5. UTPR top-up tax amount\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.5.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The total UTPR top-up tax amount for a fiscal year shall be equal to the sum of the top-up tax calculated for each low-taxed constituent entity of an MNE group for that fiscal year (determined in accordance with Article 5.2), subject to the adjustments set out in this Article 2.5 and Article 9.3.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.5.2.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 The top-up tax calculated for a low-taxed constituent entity that is otherwise taken into account under Article 2.5.1 shall be reduced to zero if all of the ultimate parent entity\u8217??s ownership interests in such low-taxed constituent entity are held directly or indirectly by one or more parent entities that are required to apply a qualified IIR in the jurisdiction where they are located with respect to that low-taxed constituent entity for the fiscal year.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.5.3.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Where Article 2.5.2 does not apply, the top-up tax calculated for a low-taxed constituent entity that is otherwise taken into account under Article 2.5.1 shall be reduced by a parent entity\u8217??s allocable share of the top-up tax of that low-taxed constituent entity that is brought into charge under a qualified IIR.\par }}\pard\plain\nosnaplinegrid\b\i0\fs22\ql\sb240\sa80\keepn\li240\sl260{{\b\i0\nosupersub\nosupersub\fs22\ql\ql\li240\cf1 \f0 Article 2.6. Allocation of top-up tax for the UTPR\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb240\sa80\fi-720\li720\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \u160??\u160??2.6.1.}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Subject to Articles 2.6.2 and 2.6.3, the UTPR top-up tax amount allocated to Hong Kong shall be determined by multiplying the total UTPR top-up tax amount determined in Article 2.5.1 by Hong Kong\u8217??s UTPR percentage. The UTPR percentage of Hong Kong shall be determined each fiscal year for each MNE group as follows:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs2\qj\sb0\sa0\li720\sl20{\par}\pard\plain\nosnaplinegrid\b0\i0\fs2\qj\sb0\sa0\li720\sl20{{\pard\intbl\ltrch\pard\plain\nosnaplinegrid\intbl\b0\i0\fs22\qr\sb0\sa80\li0\ri80\sl0{{\b0\i0\nosupersub\nosupersub\fs18\qr\qr\li0\cf1 \f0 50% x \cell}}\pard\intbl\ltrch\pard\plain\nosnaplinegrid\intbl\b0\i0\fs22\qc\sb0\sa80\li0\sl0{{\b0\i\nosupersub\nosupersub\fs18\qc\qc\li0\cf1 \f0 Number of employees in Hong Kong\cell}}\pard\intbl\ltrch\pard\plain\nosnaplinegrid\intbl\b0\i0\fs22\qr\sb0\sa80\li0\ri80\sl0{{\b0\i0\nosupersub\nosupersub\fs18\qr\qr\li0\cf1 \f0 + 50% x\cell}}\pard\intbl\ltrch\pard\plain\nosnaplinegrid\intbl\b0\i0\fs22\qc\sb0\sa80\li0\sl0{{\b0\i\nosupersub\nosupersub\fs18\qc\qc\li0\cf1 \f0 Total value of tangible assets in Hong Kong\cell}}{
