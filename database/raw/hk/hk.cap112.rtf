\pard\plain \ltrpar\ql \li0\ri0\nowidctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1779345 \rtlch\fcs1 \af0\afs24\alang1025 \ltrch\fcs0 \fs24\lang1033\langfe1033\kerning2\loch\af0\hich\af0\dbch\af14\cgrid\langnp1033\langfenp1033 {\*\latentstyles\lsdstimax267\lsdlockeddef0\lsdsemihiddendef1\lsdunhideuseddef1\lsdqformatdef0\lsdprioritydef99{\lsdlockedexcept \lsdsemihidden0 \lsdunhideused0 \lsdqformat1 \lsdpriority0 \lsdlocked0 Normal;}}\pard\plain\nosnaplinegrid\b\i0\fs22\qj\sb240\sa80\keepn\fi-720\li720\tx960\sl260{{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 18D.}{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 \tab }{\b\i0\nosupersub\nosupersub\fs22\qj\qj\li720\cf1 \f0 Cessation of source of profits in years of assessment commencing on 1 April 1975\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (1)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Save as provided in this section, where, in any year of assessment commencing on or after 1 April 1975, a person ceases to carry on a trade, profession or business in Hong Kong, the assessable profits from that source for the year of assessment in which the cessation occurs shall be computed on the amount of the profits therefrom arising in or derived from Hong Kong during the period beginning on the day following the end of the basis period for the year preceding the year of assessment and ending on the date of cessation.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Where in any year of assessment commencing on or after 1 April 1975 a person ceases to carry on a trade, profession or business in Hong Kong which was commenced by him in Hong Kong before 1 April 1974, the assessable profits from that source for the year of assessment in which the cessation occurs shall be computed on the amount of the profits therefrom arising in or derived from Hong Kong during the period beginning on 1 April in that year and ending on the date of cessation:\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li1200\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Provided that where a person ceases to carry on such trade, profession or business in Hong Kong other than by reason of the death of an individual previously carrying on a trade, profession or business as the sole proprietor thereof, and the trade, profession or business, or any part thereof, is transferred to or carried on by any other person as his trade, profession or business, this subsection shall not apply, but the cessation shall be deemed to be a cessation for the purposes of subsection (1).}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Amended }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 71 of 1983 s. 16}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 4 of 2010 s. 5}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (2A)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Where a person ceases to carry on a relevant trade, profession or business on or after 1 April 1979, the following amount shall be treated as assessable profits therefrom for the year of assessment in which the cessation occurs and shall be in addition to the assessable profits therefrom which, apart from this subsection, fall to be computed for that year of assessment\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 in the case of an excepted trade, profession or business, the amount, if any, by which the relevant profits therefrom arising in or derived from Hong Kong during the relevant period exceed the transitional amount;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 in the case of any other relevant trade, profession or business, the full amount of any relevant profits therefrom arising in or derived from Hong Kong during the relevant period,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li1200\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 and, for the purposes of this subsection, profits are }{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 relevant profits}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  if, but for subsection (2) and apart from }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Part 6}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 , the assessable profits for that year of assessment would have included those profits, and\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-480\li1200\sl260{{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 excepted trade, profession or business}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u29305??\u23450??\u34892??\u26989??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u12289??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u23560??\u26989??\u25110??\u26989??\u21209??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ) means a relevant trade, profession or business referred to in the definition in this subsection of }{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 transitional amount}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-480\li1200\sl260{{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 relevant period}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u26377??\u38364??\u26399??\u38291??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ) means the period beginning on the day next following the end of the basis period for the year preceding the year of assessment in which the cessation occurs and ending on 31 March in the year preceding the year of assessment in which the cessation occurs;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-480\li1200\sl260{{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 relevant trade, profession or business}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u26377??\u38364??\u34892??\u26989??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u12289??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u23560??\u26989??\u25110??\u26989??\u21209??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ) means a trade, profession or business to which subsection (2) applies and in the case of which the basis period for the year preceding the year of assessment in which the cessation occurs ends on a day other than 31 March;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-480\li1200\sl260{{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 transitional amount}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  (}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f13\u36942??\u28193??\u26399??\u27454??\u38989??}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 ) means\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 where the assessable profits from a relevant trade, profession or business for the year of assessment commencing on 1 April 1974 fell to be computed under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 18(2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0  on the amount of profits therefrom for the year ending on a day other than 31 March in the year preceding that year of assessment, the amount of profits from the relevant trade, profession or business arising in or derived from Hong Kong during the period beginning on the day next following the corresponding day in that year of assessment and ending on 31 March 1975;\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 where the assessable profits from a relevant trade, profession or business for the year of assessment commencing on 1 April 1974 fell to be computed under }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 18A(2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 , the amount of profits from the relevant trade, profession or business arising in or derived from Hong Kong during the period beginning on the day next following the end of the basis period for that year of assessment and ending on 31 March 1975,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li1200\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 and where a loss was incurred in the carrying on of a relevant trade, profession or business referred to in paragraph (a) or (b) of this definition during the period therein referred to, }{\b\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 transitional amount}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 , in relation to that trade, profession or business, shall be construed to mean a nil amount. }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 34 of 1980 s. 2}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (3)-(4)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Repealed }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 56 of 1993 s. 12}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (5)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 Where a person who commenced to carry on a}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0  }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 trade, profession or business in Hong Kong in a year of assessment commencing on or after 1 April 1975\u8212??\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (a)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 ceases to carry on such trade, profession or business in the year of assessment following that in which such commencement occurred; and\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1680\tqr\tx1440\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 (b)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 \tab }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 by virtue of }{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 section 18C(2)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1680\cf1 \f0 , there has been deemed to be no assessable profits for the year of assessment in which the commencement occurred,\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\li1200\sl260{{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 the assessable profits for the year of assessment in which the cessation occurs shall be recomputed on the basis of the actual profits arising in or derived from Hong Kong from the date of the commencement to the date of cessation.\par }}\pard\plain\nosnaplinegrid\b0\i0\fs22\qj\sb0\sa80\fi-1080\li1200\tqr\tx960\sl260{\tab{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (6)-(7)}{\b0\i0\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 \tab }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 (Repealed }{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 19 of 1996 s. 6}{\b0\i\nosupersub\nosupersub\fs22\qj\qj\li1200\cf1 \f0 )\par }}\pard\plain\nosnaplinegrid\b0\i\fs22\qr\sb0\sa80\li720\sl260{{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 (Added }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 7 of 1975 s. 12}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 . Amended }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 7 of 1986 s. 12}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 ; }{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 E.R. 1 of 2012}{\b0\i\nosupersub\nosupersub\fs22\qr\qr\li720\cf1 \f0 )\par }}
