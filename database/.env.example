# Copy this file to either <repository>/.env or database/.env, then supply
# credentials locally. Do not commit the copied .env file.
#
# database_url must be a PostgreSQL connection URI to the Supabase database.
# supabase_url is the project URL, and supabase_key must have access to the
# database Storage bucket and the `database` schema.
database_url=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
supabase_url=https://PROJECT_REF.supabase.co
supabase_key=REPLACE_WITH_LOCAL_SUPABASE_KEY
