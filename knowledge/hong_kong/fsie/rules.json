{
  "rule_package_version": "0.2.0",
  "jurisdiction": "HK",
  "package": "fsie",
  "status": "unverified",
  "output_state_model": "Per-node outputs use the shared NodeOutputStatus enum; the case-level terminal state (research_only_output/stop_and_escalate/human_review_required) is derived by aggregating nodes at the human gate.",
  "rules": [
    {
      "rule_id": "FSIE-SCOPE-001",
      "node": "scope",
      "ordinal": 1,
      "title": "Covered taxpayer and income scope",
      "purpose": "Determine whether the entity is an MNE entity carrying on a business in Hong Kong and the income event is in the FSIE package scope.",
      "required_facts": ["entity_hk_business_status", "mne_group_status", "income_type", "accrual_date"],
      "required_evidence": ["business_registration_certificate", "company_registry_profile", "tax_registration_record", "group_structure_chart", "dividend_payment_advice"],
      "depends_on_nodes": [],
      "source_ids": ["hk_ird_fsie_landing", "hk_ird_2022_fsie_ordinance", "hk_hkel_iro_cap112"],
      "thresholds_to_verify": [],
      "outputs": ["satisfied", "not_satisfied", "unknown"],
      "human_review_required": true,
      "status": "unverified"
    },
    {
      "rule_id": "FSIE-INCOME-001",
      "node": "income_characterisation",
      "ordinal": 2,
      "title": "Foreign-sourced dividend characterisation",
      "purpose": "Establish whether the income event is a specified foreign-sourced dividend for this analysis.",
      "required_facts": ["income_type", "income_legal_character", "payer_entity", "source_analysis", "underlying_profit_period", "accrual_date"],
      "required_evidence": ["dividend_payment_advice", "board_or_shareholder_resolution", "financial_statement_extract"],
      "depends_on_nodes": ["scope"],
      "source_ids": ["hk_ird_fsie_landing", "hk_ird_fsie_faq", "hk_hkel_iro_cap112"],
      "thresholds_to_verify": [],
      "outputs": ["satisfied", "not_satisfied", "unknown", "conflict"],
      "human_review_required": true,
      "status": "unverified"
    },
    {
      "rule_id": "FSIE-RECEIPT-001",
      "node": "receipt",
      "ordinal": 3,
      "title": "Receipt in Hong Kong",
      "purpose": "Identify whether the income event is received, or deemed received, in Hong Kong.",
      "required_facts": ["receipt_location", "bank_or_account_path", "set_off_or_clearing_arrangement", "receipt_date"],
      "required_evidence": ["bank_statement", "cash_pool_records", "set_off_or_clearing_records", "accounting_ledger"],
      "depends_on_nodes": ["income_characterisation"],
      "source_ids": ["hk_ird_fsie_landing", "hk_ird_fsie_faq", "hk_ird_fsie_examples", "hk_hkel_iro_cap112"],
      "thresholds_to_verify": [],
      "outputs": ["satisfied", "not_satisfied", "unknown", "conflict"],
      "human_review_required": true,
      "status": "unverified"
    },
    {
      "rule_id": "FSIE-ES-001",
      "node": "economic_substance",
      "ordinal": 5,
      "title": "Economic substance pathway",
      "purpose": "Collect the facts relevant to an economic-substance pathway; sufficiency (including the pure equity-holding simplified test) is never decided automatically.",
      "required_facts": ["pure_equity_holding_entity_status", "entity_activity_profile", "hk_adequate_employees", "hk_adequate_premises", "hk_operating_expenditure_amount", "strategic_decision_making_location", "outsourcing_and_supervision"],
      "required_evidence": ["payroll_or_employment_records", "lease_or_premises_records", "operating_expense_ledger", "board_minutes", "outsourcing_agreement"],
      "depends_on_nodes": ["receipt"],
      "source_ids": ["hk_ird_fsie_landing", "hk_ird_fsie_faq", "hk_ird_fsie_esr_advance_ruling", "hk_hkel_iro_cap112"],
      "thresholds_to_verify": ["adequacy_standard", "pure_equity_holding_classification", "outsourcing_control_standard"],
      "outputs": ["condition_not_demonstrated", "unknown", "human_review_required"],
      "human_review_required": true,
      "status": "unverified"
    },
    {
      "rule_id": "FSIE-PART-001",
      "node": "participation_basic",
      "ordinal": 6,
      "title": "Participation pathway basic conditions",
      "purpose": "Collect the facts for the participation pathway; numeric thresholds and anti-abuse conclusions remain candidate and expert-controlled.",
      "required_facts": ["direct_or_indirect_holding", "holding_percentage_pct", "continuous_holding_period_months", "investee_entity", "foreign_tax_on_dividend_or_underlying_profit", "main_purpose_tax_benefit_flag"],
      "required_evidence": ["share_register", "share_acquisition_transfer_records", "foreign_tax_payment_certificate", "group_structure_chart", "restructuring_or_commercial_purpose_memo"],
      "depends_on_nodes": ["economic_substance"],
      "source_ids": ["hk_ird_fsie_landing", "hk_ird_fsie_faq", "hk_ird_fsie_examples", "hk_hkel_iro_cap112"],
      "thresholds_to_verify": ["subject_to_tax_condition", "anti_abuse_condition"],
      "thresholds": [
        {"name": "minimum_holding_percentage_pct", "value": 5, "unit": "percent", "source_unit_id": null, "statute_locator": "s.15M(2)", "status": "unverified"},
        {"name": "minimum_continuous_holding_period_months", "value": 12, "unit": "months", "source_unit_id": null, "statute_locator": "s.15M(2)", "status": "unverified"},
        {"name": "foreign_reference_tax_rate_pct", "value": 15, "unit": "percent", "source_unit_id": null, "statute_locator": "s.15N(7)", "status": "unverified"}
      ],
      "outputs": ["condition_not_demonstrated", "unknown", "conflict", "human_review_required"],
      "human_review_required": true,
      "status": "unverified"
    },
    {
      "rule_id": "FSIE-GATE-001",
      "node": "human_gate",
      "ordinal": 0,
      "title": "Mandatory human review gate",
      "purpose": "Prevent a deterministic tax conclusion when a required fact, source, rule validation or subjective test is unresolved. Aggregates all sequential nodes; satisfied means the gate passes to research-only output, human_review_required means stop and escalate.",
      "required_facts": ["expert_decision_status", "evidence_inventory"],
      "required_evidence": ["fact_confirmation_log", "source_manifest_record", "expert_review_record"],
      "depends_on_nodes": ["scope", "income_characterisation", "receipt", "economic_substance", "participation_basic"],
      "source_ids": ["hk_ird_fsie_landing", "hk_ird_fsie_faq"],
      "thresholds_to_verify": [],
      "outputs": ["satisfied", "human_review_required"],
      "human_review_required": true,
      "status": "unverified"
    }
  ]
}
