# Example .env: copy to .env at the project root and fill in your own values (name=value, one per line, no quotes needed).
# qwen_key is read only from this file; the library settings from the process environment first, then this file.
# See README.md, "Keys and .env".

# Required: the model key. Alibaba Cloud Model Studio, Token Plan (qwen3.8-flash and qwen3.8-max). Codex uses its
# OpenAI-compatible endpoint (agent/harness.json), Claude Code its Anthropic-compatible one (agent/tools/orchestrate.py).
qwen_key=sk-your-token-plan-key

# Optional: where the law library is read from. "supabase" reads the shared remote directly (needs the three entries
# below); leave it out or set anything else to read the local database/ folder.
tax_db=supabase
# tax_db_cache=off          # turn off the local cache of the remote tables (.cache/)

# Needed for tax_db=supabase, and for database/tools/upload.py (which overwrites the shared remote: run it only on purpose).
database_url=postgresql://postgres.your-project:your-password@your-pooler-host:6543/postgres
supabase_url=https://your-project.supabase.co
supabase_key=your-supabase-key

# Cloud only: the public address of the deployment (render.yaml sets it there and overrides this file).
site_url=http://127.0.0.1:8000
