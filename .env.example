# Copy to .env and adjust as needed. .env is git-ignored.
# Local PostgreSQL started by infrastructure/postgres/docker-compose.yml
FSIE_DATABASE_URL=postgresql+psycopg://fsie:fsie@localhost:5432/fsie_l0

# Model adapter (S4 intake flow). L0 governance: only synthetic data may be
# sent to any model. Keys must never be committed.
FSIE_MODEL_BASE_URL=
FSIE_MODEL_API_KEY=
FSIE_MODEL_NAME=
