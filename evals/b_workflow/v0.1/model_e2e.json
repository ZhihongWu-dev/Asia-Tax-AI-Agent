  "cases": [
    {
      "id": "BWF-E2E-001",
      "name": "真实模型从空白案件到待复核稿",
      "synthetic": true,
      "smoke": true,
      "seed_facts": {},
      "mock": "MOCK-01",
      "steps": [
        {
          "op": "message",
          "text": "虚构测试：我有一笔境外股息，想分析香港FSIE适用范围，先帮我整理案情。",
          "expect": {
            "no_analysis": true,
            "question_field": "recipient_type"
          }
        },
        {
          "op": "message",
          "text": "收款方是一家在香港经营业务的公司，付款方在新加坡。这是我们实际发生的股息交易，我要研究香港适用范围。",
          "bind_question": true,
          "expect": {
            "facts": {
              "recipient_type": "company",
              "income_type": "dividend",
              "analysis_jurisdiction": "HK"
            },
            "no_analysis": true
          }
        },
        {
          "op": "message",
          "text": "请查阅香港境外股息FSIE的官方法律依据，不作最终税务结论。",
          "expect": {
            "search_min": 1,
            "no_analysis": true
          }
        },
        {
          "op": "message",
          "text": "先看部分整理",
          "expect": {
            "no_analysis": true
          }
        },
        {
          "op": "confirm",
          "expect": {}
        },
        {
          "op": "analyze",
          "expect": {
            "analysis_count": 1,
            "review_pending": true
          }
        },
        {
          "op": "reload",
          "expect": {
            "analysis_count": 1,
            "review_pending": true
          }
        },
        {
          "op": "review",
          "decision": "approved",
          "expect": {
            "error": "review_forbidden"
          }
        }
      ]
    },
    {
